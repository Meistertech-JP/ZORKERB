; gverbs.zil:1010 ROUTINE V-OPEN
@Z2R_V_OPEN
#DIM DYNAMIC Z2L_F
#DIMS DYNAMIC Z2L_STR
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF ((Z2_ATTR:(Z2_PRSO):(F_CONTBIT)) && (!((Z2_CAPACITY:(Z2_PRSO) == 0))))
        IF Z2_ATTR:(Z2_PRSO):(F_OPENBIT)
            PRINTS "It is already open."
            PRINTL
            RETURN 1
        ELSE
            Z2_ATTR:(Z2_PRSO):(F_OPENBIT) = 1
            Z2_ATTR:(Z2_PRSO):(F_TOUCHBIT) = 1
            IF ((!(Z2_CHILD:(Z2_PRSO))) || (Z2_ATTR:(Z2_PRSO):(F_TRANSBIT)))
                PRINTS "Opened."
                PRINTL
                RETURN 1
            ELSE
                Z2T_1 = 1
                Z2L_F = Z2_CHILD:(Z2_PRSO)
                Z2T_1 = (Z2L_F) != 0
                IF Z2T_1
                    Z2T_1 = (!(Z2_SIBLING:(Z2L_F))) != 0
                    IF Z2T_1
                        Z2T_1 = (!(Z2_ATTR:(Z2L_F):(F_TOUCHBIT))) != 0
                        IF Z2T_1
                            Z2L_STR '= Z2_FDESC:(Z2L_F)
                            Z2T_1 = (Z2L_STR != "") != 0
                        ENDIF
                    ENDIF
                ENDIF
                IF Z2T_1
                    PRINTS "The "
                    PRINTS Z2_NAME:(Z2_PRSO)
                    PRINTS " opens."
                    PRINTL
                    PRINTS Z2L_STR
                    PRINTL
                    RETURN 1
                ELSE
                    PRINTS "Opening the "
                    PRINTS Z2_NAME:(Z2_PRSO)
                    PRINTS " reveals "
                    CALL Z2R_PRINT_CONTENTS, Z2_PRSO
                    Z2T_2 = RESULT
                    PRINTS "."
                    PRINTL
                    RETURN 1
                ENDIF
            ENDIF
        ENDIF
    ELSEIF Z2_ATTR:(Z2_PRSO):(F_DOORBIT)
        IF Z2_ATTR:(Z2_PRSO):(F_OPENBIT)
            PRINTS "It is already open."
            PRINTL
            RETURN 1
        ELSE
            PRINTS "The "
            PRINTS Z2_NAME:(Z2_PRSO)
            PRINTS " opens."
            PRINTL
            Z2_ATTR:(Z2_PRSO):(F_OPENBIT) = 1
            RETURN 1
        ENDIF
    ELSE
        PRINTS "You must tell me how to do that to a "
        PRINTS Z2_NAME:(Z2_PRSO)
        PRINTS "."
        PRINTL
        RETURN 1
    ENDIF

