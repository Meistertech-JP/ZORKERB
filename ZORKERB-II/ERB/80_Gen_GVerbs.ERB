; gverbs.zil:1257 ROUTINE V-SHAKE
@Z2R_V_SHAKE
#DIM DYNAMIC Z2T_1
    IF Z2_ATTR:(Z2_PRSO):(F_ACTORBIT)
        PRINTS "This seems to have no effect."
        PRINTL
        RETURN 1
    ELSEIF !(Z2_ATTR:(Z2_PRSO):(F_TAKEBIT))
