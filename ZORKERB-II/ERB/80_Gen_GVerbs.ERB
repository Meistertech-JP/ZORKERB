; gverbs.zil:1129 ROUTINE V-PUT
@Z2R_V_PUT
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
#DIM DYNAMIC Z2T_6
    IF ((Z2_ATTR:(Z2_PRSI):(F_OPENBIT)) || ((Z2_ATTR:(Z2_PRSI):F_DOORBIT || Z2_ATTR:(Z2_PRSI):F_CONTBIT)) || (Z2_ATTR:(Z2_PRSI):(F_VEHBIT)))
    ELSE
        PRINTS "You can't do that."
        PRINTL
        RETURN 1
    ENDIF
    IF !(Z2_ATTR:(Z2_PRSI):(F_OPENBIT))
        PRINTS "The "
        PRINTS Z2_NAME:(Z2_PRSI)
        PRINTS " isn't open."
        PRINTL
        Z2_P_IT_OBJECT = Z2_PRSI
        RETURN 1
    ELSEIF (Z2_PRSI == Z2_PRSO)
        PRINTS "How can you do that?"
        PRINTL
        RETURN 1
    ELSEIF (Z2_PARENT:(Z2_PRSO) == Z2_PRSI)
        PRINTS "The "
        PRINTS Z2_NAME:(Z2_PRSO)
        PRINTS " is already in the "
        PRINTS Z2_NAME:(Z2_PRSI)
        PRINTS "."
        PRINTL
        RETURN 1
    ELSE
        CALL Z2R_WEIGHT, Z2_PRSI
        Z2T_1 = RESULT
        CALL Z2R_WEIGHT, Z2_PRSO
        Z2T_2 = RESULT
        IF (((Z2T_1 + Z2T_2) - Z2_SIZE:(Z2_PRSI)) > Z2_CAPACITY:(Z2_PRSI))
            PRINTS "There's no room."
            PRINTL
            RETURN 1
        ELSEIF ((!(Z2_HELDQ(Z2_PRSO))) && (Z2_ATTR:(Z2_PRSO):(F_TRYTAKEBIT)))
            PRINTS "You don't have the "
            PRINTS Z2_NAME:(Z2_PRSO)
            PRINTS "."
            PRINTL
            RETURN 1
        ELSE
            Z2T_4 = 1
            Z2T_4 = (!(Z2_HELDQ(Z2_PRSO))) != 0
            IF Z2T_4
                CALL Z2R_ITAKE
                Z2T_5 = RESULT
                Z2T_4 = (!(Z2T_5)) != 0
            ENDIF
            IF Z2T_4
                RETURN 1
            ELSE
                CALL Z2_MOVE, Z2_PRSO, Z2_PRSI
                Z2_ATTR:(Z2_PRSO):(F_TOUCHBIT) = 1
                CALL Z2R_SCORE_OBJ, Z2_PRSO
                Z2T_6 = RESULT
                PRINTS "Done."
                PRINTL
                RETURN 1
            ENDIF
        ENDIF
    ENDIF

