    ELSEIF Z2_ATTR:(Z2_PRSO):(F_CONTBIT)
        IF Z2_ATTR:(Z2_PRSO):(F_OPENBIT)
            IF Z2_CHILD:(Z2_PRSO)
                CALL Z2R_SHAKE_LOOP
                Z2T_1 = RESULT
                PRINTS "The contents of the "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS " spill "
                IF !(Z2_ATTR:(Z2_HERE):(F_RLANDBIT))
                    PRINTS "out and disappears"
                ELSE
                    PRINTS "to the ground"
                ENDIF
                PRINTS "."
                PRINTL
                RETURN 1
            ELSE
                PRINTS "Shaken."
                PRINTL
                RETURN 1
            ENDIF
        ELSE
            IF Z2_CHILD:(Z2_PRSO)
                PRINTS "It sounds like there is something inside the "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS "."
                PRINTL
                RETURN 1
            ELSE
                PRINTS "The "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS " sounds empty."
                PRINTL
                RETURN 1
            ENDIF
        ENDIF
    ELSE
        PRINTS "Shaken."
        PRINTL
        RETURN 1
    ENDIF

; gverbs.zil:1286 ROUTINE SHAKE-LOOP
@Z2R_SHAKE_LOOP
#DIM DYNAMIC Z2L_X
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    Z2T_1 = 0
    WHILE 1
        Z2L_X = Z2_CHILD:(Z2_PRSO)
        IF Z2L_X
            Z2_ATTR:(Z2L_X):(F_TOUCHBIT) = 1
            IF (Z2L_X == O_WATER)
                Z2T_2 = O_PSEUDO_OBJECT
            ELSEIF !(Z2_ATTR:(Z2_HERE):(F_RLANDBIT))
                Z2T_2 = O_PSEUDO_OBJECT
            ELSE
                Z2T_2 = Z2_HERE
            ENDIF
            CALL Z2_MOVE, Z2L_X, Z2T_2
        ELSE
            Z2T_1 = 1
            BREAK
        ENDIF
    WEND
    RETURN Z2T_1

