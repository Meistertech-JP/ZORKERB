                CALL Z2_PICK_ONE, Z2_GLOBAL:G_JUMPLOSS
                Z2T_2 '= Z2_PICK_S
                CALL Z2R_JIGS_UP, Z2T_2
                Z2T_3 = RESULT
                RETURN Z2T_3
            ELSEIF 0
                RETURN 1
            ELSE
                CALL Z2R_V_SKIP
                Z2T_4 = RESULT
                RETURN Z2T_4
            ENDIF
        ELSE
            CALL Z2R_V_SKIP
            Z2T_5 = RESULT
            RETURN Z2T_5
        ENDIF
    ENDIF

