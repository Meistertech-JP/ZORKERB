; gverbs.zil:569 ROUTINE V-ENCHANT
@Z2R_V_ENCHANT
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF Z2_GLOBAL:G_WAND_ON
        Z2_GLOBAL:G_SPELL_VICTIM = Z2_GLOBAL:G_WAND_ON
    ENDIF
    IF Z2_GLOBAL:G_SPELL_VICTIM
        IF !(Z2_GLOBAL:G_SPELL_USED)
            PRINTS "You must be more specific."
            PRINTL
            RETURN 1
        ENDIF
        IF (((Z2_GLOBAL:G_SPELL_USED == 198 || Z2_GLOBAL:G_SPELL_USED == 233 || Z2_GLOBAL:G_SPELL_USED == 197)) || ((Z2_GLOBAL:G_SPELL_USED == 225 || Z2_GLOBAL:G_SPELL_USED == 193 || Z2_GLOBAL:G_SPELL_USED == 202)) || ((Z2_GLOBAL:G_SPELL_USED == 203 || Z2_GLOBAL:G_SPELL_USED == 201 || Z2_GLOBAL:G_SPELL_USED == 195)))
            IF Z2_ATTR:(Z2_PRSO):(F_ACTORBIT)
                PRINTS "The wand stops glowing, but there is no other obvious effect."
                PRINTL
                RETURN 1
            ELSE
                PRINTS "That might have done something, but it's hard to tell with a "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS "."
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (Z2_GLOBAL:G_SPELL_USED == 232)
            PRINTS "A strong odor of chocolate permeates the room."
            PRINTL
            RETURN 1
        ELSEIF (Z2_GLOBAL:G_SPELL_USED == 216)
            Z2_ATTR:(Z2_PRSO):(F_LIGHTBIT) = 1
            Z2_ATTR:(Z2_PRSO):(F_ONBIT) = 1
            Z2_LITQ = 1
            PRINTS "The "
            PRINTS Z2_NAME:(Z2_PRSO)
            PRINTS " begins to glow."
            PRINTL
            RETURN 1
        ELSEIF (Z2_GLOBAL:G_SPELL_USED == 205)
            Z2_GLOBAL:G_SPELL_HANDLEDQ = 1
            IF Z2_ATTR:(Z2_PRSO):(F_TAKEBIT)
                CALL Z2_MOVE, Z2_PRSO, Z2_WINNER
                CALL Z2R_SCORE_OBJ, Z2_PRSO
                Z2T_1 = RESULT
                PRINTS "Filched!"
                PRINTL
                RETURN 1
            ELSE
                PRINTS "You can't filch the "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS "!"
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (((Z2_GLOBAL:G_SPELL_USED == 213)) && (Z2_ATTR:(Z2_PRSO):(F_TAKEBIT)))
            IF (((Z2_GLOBAL:G_SPELL_VICTIM == O_COLLAR)) && ((Z2_PARENT:(O_COLLAR) == O_CERBERUS)))
                Z2_GLOBAL:G_SPELL_VICTIM = O_CERBERUS
            ENDIF
            PRINTS "The "
            PRINTS Z2_NAME:(Z2_PRSO)
            PRINTS " floats serenely in midair."
            PRINTL
            RETURN 1
        ELSEIF (((Z2_GLOBAL:G_SPELL_USED == 230)) && (Z2_ATTR:(Z2_PRSO):(F_TAKEBIT)))
            Z2_GLOBAL:G_SPELL_HANDLEDQ = 1
            CALL Z2R_REMOVE_CAREFULLY, Z2_PRSO
            Z2T_2 = RESULT
            PRINTS "The "
            PRINTS Z2_NAME:(Z2_PRSO)
            PRINTS " goes up in a puff of smoke."
            PRINTL
            RETURN 1
        ELSE
            Z2_GLOBAL:G_SPELL_VICTIM = 0
            PRINTS "The wand stops glowing, but there is no other apparent effect."
            PRINTL
            RETURN 1
        ENDIF
    ELSE
        Z2_GLOBAL:G_SPELL_VICTIM = 0
        PRINTS "Nothing happens."
        PRINTL
        RETURN 1
    ENDIF

