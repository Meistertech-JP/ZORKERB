    ELSE
        Z2L_TX = Z2_GETPT(Z2_HERE, 22)
        IF Z2L_TX
            Z2L_S = Z2_PTSIZE(Z2L_TX)
            IF (((Z2L_S == 2)) || ((((Z2L_S == 4)) && (!(Z2_GLOBAL:(Z2_PT_GETB(Z2L_TX, 1)))))))
                PRINTS "This was not a very safe place to try jumping."
