#DIMS Z2_PSTR, 46300
#DIMS Z2_INT_NAME, 40
#DIM GLOBAL Z2_RNG_SEEDED
#DIM GLOBAL Z2_RNG_A
; ---- SAVE/RESTORE (46_Verbs, 02_Flow)
; Parser state above is SAVEDATA: in the Z-machine it is dynamic memory and is
; saved with the game. The random number generator is interpreter state and is
; not saved (RESTORE continues the current sequence, as the reference
; interpreter does). Z2_SLOT_REQ is the host slot typed after SAVE/RESTORE
; (never part of the lexv); Z2_SAVE_RESUME is 1 only inside a save image.
#DIM Z2_SLOT_REQ
#DIM SAVEDATA Z2_SAVE_RESUME
; RESTORE rollback (48_SaveCheck): not saved, so they survive LOADDATA.
; Z2_RB_PENDING 1 = a slot was just loaded and must be checked, 2 = the
; rollback image was loaded; Z2_RB_CTX 0 = V-RESTORE, 1 = FINISH, 2 = title.
; Z2_RNG_* and Z2_RB_* are GLOBAL: the native Emuera's LOADDATA resets every
; variable that is neither SAVEDATA nor GLOBAL (PyEmuera keeps them). RESTORE
; keeps the random generator, as the Z-machine does, and EVENTLOAD reads the
; rollback state set before LOADDATA. RESETDATA does not reset GLOBAL
; variables either: Z2_RESET_GLOBALS does it where RESETDATA is used.
#DIM GLOBAL Z2_RB_PENDING
#DIM GLOBAL Z2_RB_CTX
#DIM CONST Z2_RB_SLOT = 99
#DIMS CONST Z2_NL_MARK = "^"
#DIMS CONST Z2_SAVE_TAG = "ZORKERB II save schema 2"
; Part-of-speech byte of the "word" at (0x0300 | Flags 1) + 4 that the story
; reads for <GET 0 0> in ORPHAN-MERGE; Flags 1 = 0x20 under the pinned oracle
; interpreter (41_Parser.ERB Z2_ORPHAN_MERGE). Checked by source_story_check.
#DIM CONST Z2_HDR_WORD_PS = 40
; Static memory starts here (story header word 0x0E; tools/zmap.py checks it).
; A store at or above it is a fatal interpreter error in the original.
#DIM CONST Z2_STATIC_BASE = 11767
; PICK-ONE's result (a procedure; not saved)
#DIMS Z2_PICK_S
