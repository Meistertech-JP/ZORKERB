#DIM SAVEDATA Z2_SYN_LINE
#DIM SAVEDATA Z2_LITQ
#DIM SAVEDATA Z2_WINNER
#DIM SAVEDATA Z2_P_IT_OBJECT
; Match tables (P-PRSO 1, P-PRSI 2, P-BUTS 3, P-MERGE 4): :0 is P-MATCHLEN.
#DIM SAVEDATA Z2_MT, 5, 60
#DIM CONST MT_PRSO = 1
#DIM CONST MT_PRSI = 2
#DIM CONST MT_BUTS = 3
