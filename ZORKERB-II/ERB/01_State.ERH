; ZORKERB II state. Object tree and attributes follow the story's object table
; (zork2/src/world.json). Only SAVEDATA fields form the save contract;
; names, descriptions and exits are immutable and rebuilt by Z2_LOAD_WORLD.
#DIMS Z2_NAME, 256
#DIM SAVEDATA Z2_PARENT, 256
#DIM SAVEDATA Z2_SIBLING, 256
#DIM SAVEDATA Z2_CHILD, 256
#DIM SAVEDATA Z2_ATTR, 256, 32
#DIMS SAVEDATA Z2_LDESC, 256
#DIMS SAVEDATA Z2_FDESC, 256
#DIMS SAVEDATA Z2_TEXT, 256
#DIM Z2_IS_ROOM, 256
#DIM Z2_HAS_ACTION, 256
#DIM Z2_HAS_DESCFCN, 256
#DIM Z2_EXIT_KIND, 256, 16
#DIM Z2_EXIT_TO, 256, 16
#DIMS Z2_EXIT_MSG, 256, 16
#DIM SAVEDATA Z2_HERE
#DIM SAVEDATA Z2_MOVES
#DIM SAVEDATA Z2_SCORE
#DIM SAVEDATA Z2_VERBOSE
#DIM Z2_QUIT
; Random numbers (03_Random, gmacros RANDOM; #random sequential mode).
#DIM GLOBAL Z2_RNG_INTERVAL
#DIM GLOBAL Z2_RNG_COUNTER
#DIM SAVEDATA Z2_LUCKY
; gclock.zil C-TABLE: Z2_CINT_* index 0 is the oldest entry; INT adds at the
; end, which is the front of the story's table (C-INTS moves down).
#DIM SAVEDATA Z2_CINT_N
#DIM SAVEDATA Z2_CINT_RTN, 30
#DIM SAVEDATA Z2_CINT_TICK, 30
#DIM SAVEDATA Z2_CINT_ON, 30
#DIM SAVEDATA Z2_SPELL
#DIM SAVEDATA Z2_DEAD
; Interrupt routine numbers for Z2_RUN_INT (90_Clock).
#DIM CONST INT_WIZARD = 1
#DIM CONST INT_LANTERN = 2
; Mutable object values (P?VALUE, SCORE-OBJ) and story globals (initial values
; from the story's global table, numbered as in the story: 16..255).
#DIM SAVEDATA Z2_VALUE, 256
#DIM SAVEDATA Z2_GLOBAL, 256
#DIM Z2_EXIT_ARG, 256, 16
; gmain.zil room ACTION arguments.
#DIM CONST M_BEG = 1
#DIM CONST M_ENTER = 2
#DIM CONST M_LOOK = 3
#DIM CONST M_FLASH = 4
#DIM CONST M_END = 6
#DIM SAVEDATA Z2_DEATHS
#DIM SAVEDATA Z2_DRAGON_ANGER
#DIM SAVEDATA Z2_WON
#DIM Z2_FINISHED
; More interrupt numbers (KILL-INTERRUPTS creates their entries with INT).
#DIM CONST INT_GNOME = 3
#DIM CONST INT_LEDGE = 4
#DIM CONST INT_NERVOUS = 5
#DIM CONST INT_ZGNOME_OUT = 6
#DIM CONST INT_ZGNOME = 7
#DIM CONST INT_MATCH = 8
#DIM CONST INT_DRAGON = 9
#DIM CONST INT_GARDEN = 10
#DIM SAVEDATA Z2_TOPIARY_MOVED
#DIM SAVEDATA Z2_TOPIARY_NEAR
#DIM SAVEDATA Z2_UNICORN_FRIGHTENED
; Parser data generated from the story (immutable).
#DIM Z2_DICT_N
#DIMS Z2_DW, 701
#DIM Z2_DF, 701
#DIM Z2_DV1, 701
#DIM Z2_DV2, 701
