Z2_LDESC:212 '= "The path follows the south edge of a deep ravine and heads northeast. A tunnel heads southwest, narrowing to a rather tight crawl. A faint whirring sound can be heard in that direction. On the east is a ruined archway choked with vegetation."
Z2_SIZE:212 = 5
Z2_PARENT:213 = 206
Z2_SIBLING:213 = 0
Z2_CHILD:213 = 0
Z2_ATTR:213:17 = 1
Z2_ATTR:213:26 = 1
Z2_LDESC:213 '= "There is a coil of black, braided string here."
