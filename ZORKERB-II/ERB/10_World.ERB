Z2_PARENT:215 = 0
Z2_SIBLING:215 = 0
Z2_CHILD:215 = 0
Z2_ATTR:215:17 = 1
Z2_ATTR:215:21 = 1
Z2_LDESC:215 '= "There is some water here."
