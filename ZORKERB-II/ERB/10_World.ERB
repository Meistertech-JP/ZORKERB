Z2_ATTR:175:13 = 1
Z2_ATTR:175:14 = 1
Z2_ATTR:175:16 = 1
Z2_TEXT:175 '= "The text is in some obscure tongue. All that can be made out is a reference to \"sending in a matchbook cover.\""
