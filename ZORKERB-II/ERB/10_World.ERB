Z2_PARENT:177 = 37
Z2_SIBLING:177 = 86
Z2_CHILD:177 = 0
Z2_ATTR:177:5 = 1
Z2_ATTR:177:6 = 1
Z2_LDESC:177 '= "You are near the rim of the volcano. Above you it is open to the sky. To the west, there is a place to land on a wide ledge."
