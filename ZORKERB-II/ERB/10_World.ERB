Z2_PARENT:172 = 37
Z2_SIBLING:172 = 80
Z2_CHILD:172 = 0
Z2_ATTR:172:12 = 1
Z2_LDESC:172 '= "The room is cool and damp. The air is misty. A twisty path from the southeast splits here toward a wide northerly stone bridge, and a narrow westerly tunnel. It is from the latter that the mist and chill seem to originate."
