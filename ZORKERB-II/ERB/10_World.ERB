Z2_SIBLING:192 = 0
Z2_CHILD:192 = 0
Z2_ATTR:192:30 = 1
Z2_LDESC:192 '= "A huge red dragon is lying on the rocks here, watching."
Z2_FDESC:192 '= "A huge red dragon is lying here, blocking the entrance to a tunnel leading north. Smoke curls from his nostrils and out between his teeth."
