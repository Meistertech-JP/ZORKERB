Z2_PARENT:158 = 37
Z2_SIBLING:158 = 53
Z2_CHILD:158 = 0
Z2_ATTR:158:12 = 1
Z2_LDESC:158 '= "This is a dark tunnel with dim light to the northeast. The tunnel is smooth but dusty and filled with twigs and leaves, debris which becomes deeper as the tunnel branches into a wide corridor leading southwest and a narrower one leading southeast."
