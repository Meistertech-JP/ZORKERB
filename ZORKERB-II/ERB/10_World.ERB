Z2_SIBLING:190 = 119
Z2_CHILD:190 = 155
Z2_ATTR:190:12 = 1
Z2_ATTR:190:19 = 1
Z2_LDESC:190 '= "This is a small room containing a large oblong table, no doubt set for afternoon tea. It is clear from the objects on the table that the users were indeed mad. In the eastern corner of the room is a small hole (no more than four inches high). There are passageways leading away to the west and the northwest."
Z2_SIZE:190 = 5
Z2_PARENT:191 = 8
Z2_SIBLING:191 = 0
Z2_CHILD:191 = 0
Z2_ATTR:191:14 = 1
