Z2_PARENT:176 = 37
Z2_SIBLING:176 = 38
Z2_CHILD:176 = 169
Z2_ATTR:176:6 = 1
Z2_ATTR:176:12 = 1
Z2_LDESC:176 '= "You are at the bottom of a large dormant volcano. High above you light enters from the cone of the volcano. The only exit is to the north."
