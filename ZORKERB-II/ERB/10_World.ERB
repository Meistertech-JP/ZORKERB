Z2_SIBLING:214 = 0
Z2_CHILD:214 = 0
Z2_ATTR:214:16 = 1
Z2_ATTR:214:17 = 1
Z2_FDESC:214 '= "A spray can is in the corner. In large type is the legend \"Frobozz Magic Grue Repellent\"."
Z2_TEXT:214 '= "!!! FROBOZZ MAGIC GRUE REPELLENT !!!\n\nInstructions for use: Apply liberally to creature to be protected. Duration of effect is unpredictable. Use only in place of death!\n\n(No warranty expressed or implied)"
