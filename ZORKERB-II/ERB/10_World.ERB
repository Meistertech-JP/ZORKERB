Z2_PARENT:237 = 37
Z2_SIBLING:237 = 233
Z2_CHILD:237 = 31
Z2_ATTR:237:12 = 1
Z2_ATTR:237:19 = 1
Z2_LDESC:237 '= "The floor here seems to be made of sand, but it is hard to see anything else."
