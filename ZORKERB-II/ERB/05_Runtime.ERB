; Helpers for the routines generated by tools/zil2erb.py (Z-machine table and
; property operations on the story data in 10_World).

; GET / GETB on table memory. Words are signed 16-bit values.
@Z2_GETW(Z2_A)
#FUNCTION
#DIM DYNAMIC Z2_A
#DIM DYNAMIC Z2_V
Z2_V = Z2_MEM:Z2_A * 256 + Z2_MEM:(Z2_A + 1)
SIF Z2_V >= 32768
    Z2_V -= 65536
RETURNF Z2_V

@Z2_GETB(Z2_A)
#FUNCTION
#DIM DYNAMIC Z2_A
RETURNF Z2_MEM:Z2_A

@Z2_PUTW(Z2_A, Z2_V)
#DIM DYNAMIC Z2_A
#DIM DYNAMIC Z2_V
Z2_A = Z2_STORE_ADDR(Z2_A)
SIF Z2_A < 0
    CALL Z2_FATAL, "Store out of dynamic memory"
SIF Z2_V < 0
    Z2_V += 65536
Z2_MEM:Z2_A = (Z2_V / 256) % 256
Z2_MEM:(Z2_A + 1) = Z2_V % 256

@Z2_PUTB(Z2_A, Z2_V)
#DIM DYNAMIC Z2_A
#DIM DYNAMIC Z2_V
Z2_A = Z2_STORE_ADDR(Z2_A)
SIF Z2_A < 0
    CALL Z2_FATAL, "Store out of dynamic memory"
Z2_MEM:Z2_A = Z2_V % 256

; A store address as the Z-machine uses it (16 bits, unsigned), or -1 when it
; is at or above the start of static memory: such a store stops the original's
; interpreter (Frotz: "Fatal error: Store out of dynamic memory") and the
; callers stop the port the same way (Z2_FATAL). Reached by PICK-ONE on the
; FANTASIES table (an LTABLE, not the layout PICK-ONE expects), i.e. the
; Fantasize illusion.
@Z2_STORE_ADDR(Z2_A)
#FUNCTION
#DIM DYNAMIC Z2_A
Z2_A = Z2_A & 65535
SIF Z2_A >= Z2_STATIC_BASE
    RETURNF -1
RETURNF Z2_A

@Z2_FATAL(Z2_WHY)
#DIMS DYNAMIC Z2_WHY
PRINTL
PRINTFORML Fatal error: %Z2_WHY%
QUIT

; GETPT returns a property reference -(obj * 64 + prop), 0 when absent. The
; sign keeps it apart from table addresses (ZMEMQ/ZMEMQB accept both).
@Z2_GETPT(Z2_O, Z2_P)
#FUNCTION
#DIM DYNAMIC Z2_O
#DIM DYNAMIC Z2_P
; Version 3 property numbers are 1..31; any other number matches no
; property (GET_PROP_ADDR returns 0), e.g. an object used as a direction.
SIF Z2_P < 1 || Z2_P > 31 || Z2_O < 1 || Z2_O > 255
    RETURNF 0
SIF Z2_HASPROP:Z2_O:Z2_P == 0
    RETURNF 0
RETURNF -(Z2_O * 64 + Z2_P)

@Z2_PTSIZE(Z2_PT)
#FUNCTION
#DIM DYNAMIC Z2_PT
SIF Z2_PT >= 0
    RETURNF 0
RETURNF Z2_HASPROP:((-Z2_PT) / 64):((-Z2_PT) % 64)

@Z2_PT_GETB(Z2_PT, Z2_N)
#FUNCTION
#DIM DYNAMIC Z2_PT
#DIM DYNAMIC Z2_N
RETURNF Z2_PROPB:((-Z2_PT) / 64):((-Z2_PT) % 64):Z2_N

@Z2_PT_GET(Z2_PT, Z2_N)
#FUNCTION
#DIM DYNAMIC Z2_PT
#DIM DYNAMIC Z2_N
#DIM DYNAMIC Z2_V
Z2_V = Z2_PT_GETB(Z2_PT, Z2_N * 2) * 256 + Z2_PT_GETB(Z2_PT, Z2_N * 2 + 1)
SIF Z2_V >= 32768
    Z2_V -= 65536
RETURNF Z2_V

; ZMEMQ on a property (word search, SIZE given in bytes as PTSIZE).
@Z2_PT_MEMQ(Z2_ITM, Z2_PT, Z2_SZ)
#FUNCTION
#DIM DYNAMIC Z2_ITM
#DIM DYNAMIC Z2_PT
#DIM DYNAMIC Z2_SZ
#DIM DYNAMIC Z2_K
SIF Z2_PT == 0
    RETURNF 0
FOR Z2_K, 0, Z2_PTSIZE(Z2_PT) / 2
    SIF Z2_PT_GET(Z2_PT, Z2_K) == Z2_ITM
        RETURNF 1
NEXT
RETURNF 0

; ZMEMQB (ITM TBL SIZE): byte search of TBL[0..SIZE].
@Z2_ZMEMQB(Z2_ITM, Z2_TBL, Z2_SZ)
#FUNCTION
#DIM DYNAMIC Z2_ITM
#DIM DYNAMIC Z2_TBL
#DIM DYNAMIC Z2_SZ
#DIM DYNAMIC Z2_K
FOR Z2_K, 0, Z2_SZ + 1
    IF Z2_TBL < 0
        SIF Z2_PT_GETB(Z2_TBL, Z2_K) == Z2_ITM
            RETURNF 1
    ELSE
        SIF Z2_MEM:(Z2_TBL + Z2_K) == Z2_ITM
            RETURNF 1
    ENDIF
NEXT
RETURNF 0

; NEXTP (OBJ PROP): the next lower property of OBJ; PROP 0 gives the first.
@Z2_NEXTP(Z2_O, Z2_P)
#FUNCTION
#DIM DYNAMIC Z2_O
#DIM DYNAMIC Z2_P
#DIM DYNAMIC Z2_K
SIF Z2_P == 0
    Z2_P = 32
FOR Z2_K, Z2_P - 1, 0, -1
    SIF Z2_HASPROP:Z2_O:Z2_K
        RETURNF Z2_K
NEXT
RETURNF 0

; gmacros ZPROB (LUCKY is never cleared in Zork II, so PROB n is G? n RANDOM 100).
@Z2_ZPROB(Z2_BASE)
#FUNCTION
#DIM DYNAMIC Z2_BASE
SIF Z2_LUCKY
    RETURNF Z2_BASE > Z2_RANDOM(100)
RETURNF Z2_BASE > Z2_RANDOM(300)

; gmacros PICK-ONE: leaves the chosen string in Z2_PICK_S and rotates the table.
@Z2_PICK_ONE(Z2_FROB)
#DIM DYNAMIC Z2_FROB
#DIM DYNAMIC Z2_L
#DIM DYNAMIC Z2_CNT
#DIM DYNAMIC Z2_RND
#DIM DYNAMIC Z2_MSG
#DIM DYNAMIC Z2_RFROB
#DIM DYNAMIC Z2_A
; Z-machine arithmetic: REST and the index are 16-bit; RANDOM gets the signed
; 16-bit difference (0 or less seeds and returns 0).
Z2_L = Z2_GETW(Z2_FROB)
Z2_CNT = Z2_GETW(Z2_FROB + 2)
Z2_L -= 1
Z2_FROB = (Z2_FROB + 2) & 65535
Z2_RFROB = (Z2_FROB + Z2_CNT * 2) & 65535
Z2_A = (Z2_L - Z2_CNT) & 65535
SIF Z2_A >= 32768
    Z2_A -= 65536
Z2_RND = Z2_RANDOM(Z2_A)
Z2_A = (Z2_RFROB + 2 * Z2_RND) & 65535
; The original stores at Z2_A (<PUT .RFROB .RND ...>) and then at RFROB + 2
; (<PUT .RFROB 1 .MSG>). If either is outside dynamic memory its interpreter
; stops there, before anything it read is printed or kept (a first store that
; succeeded is never seen), so the port stops before reading. On FANTASIES the
; second store always is (RFROB + 2 = 38671 > 11767); the RANDOM above is drawn
; first, as in the original.
SIF Z2_STORE_ADDR(Z2_A) < 0 || Z2_STORE_ADDR(Z2_RFROB + 2) < 0
    CALL Z2_FATAL, "Store out of dynamic memory"
Z2_MSG = Z2_GETW(Z2_A) & 65535
CALL Z2_PUTW, Z2_A, Z2_GETW((Z2_RFROB + 2) & 65535)
CALL Z2_PUTW, (Z2_RFROB + 2) & 65535, Z2_MSG
Z2_CNT += 1
SIF Z2_CNT == Z2_L
    Z2_CNT = 0
CALL Z2_PUTW, Z2_FROB, Z2_CNT
Z2_PICK_S '= Z2_PSTR:Z2_MSG
RETURN

@Z2_ENABLE(Z2_RTN, Z2_ON)
#DIM DYNAMIC Z2_RTN
#DIM DYNAMIC Z2_ON
Z2_CINT_ON:(Z2_INT(Z2_RTN)) = Z2_ON
