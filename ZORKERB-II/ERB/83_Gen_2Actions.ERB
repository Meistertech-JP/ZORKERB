    ELSEIF (Z2_PRSA == V_OPEN)
        IF Z2_GLOBAL:G_SAFE_FLAG
            PRINTS "The box has no door!"
            PRINTL
            RETURN 1
        ELSE
            PRINTS "The box is rusted and will not open."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF (Z2_PRSA == V_CLOSE)
        IF Z2_GLOBAL:G_SAFE_FLAG
            PRINTS "The box has no door!"
            PRINTL
            RETURN 1
        ELSE
            PRINTS "The box isn't open!"
            PRINTL
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:407 ROUTINE BRICK-FCN
@Z2R_BRICK_FCN
#DIM DYNAMIC Z2T_1
    IF (Z2_PRSA == V_BURN)
        CALL Z2_REMOVE, O_BRICK
        CALL Z2R_JIGS_UP, Z2_PSTR:((Z2_GLOBAL:G_OTHER_PROPERTIES) & 65535)
        Z2T_1 = RESULT
        RETURN Z2T_1
    ENDIF
    RETURN 0

; 2actions.zil:416 ROUTINE FUSE-FCN
@Z2R_FUSE_FCN
    IF (((Z2_PRSA == V_BURN)) || ((((Z2_PRSA == V_LAMP_ON)) && ((Z2_PARENT:(O_MATCH) == Z2_WINNER)) && (Z2_ATTR:(O_MATCH):(F_ONBIT)))))
        PRINTS "The string starts to burn."
        PRINTL
        CALL Z2_QUEUE, INT_FUSE, 2, 1
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:424 ROUTINE I-FUSE
@Z2R_I_FUSE
#DIM DYNAMIC Z2L_BRICK_ROOM
#DIM DYNAMIC Z2L_F
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
    Z2L_BRICK_ROOM = Z2_PARENT:(O_BRICK)
    IF (Z2_PARENT:(O_FUSE) == O_BRICK)
        Z2T_1 = 0
        WHILE 1
            IF !(Z2L_BRICK_ROOM)
                RETURN 0
            ELSEIF (Z2_PARENT:(Z2L_BRICK_ROOM) == O_ROOMS)
                Z2T_1 = 1
                BREAK
            ELSE
                Z2L_BRICK_ROOM = Z2_PARENT:(Z2L_BRICK_ROOM)
            ENDIF
        WEND
        CALL Z2_MOVE, O_EXPLOSION, Z2L_BRICK_ROOM
        Z2_ATTR:(Z2L_BRICK_ROOM):(F_TOUCHBIT) = 0
        IF (Z2L_BRICK_ROOM == Z2_HERE)
            CALL Z2R_MUNG_ROOM, Z2L_BRICK_ROOM, "The way is blocked by debris from an explosion."
            Z2T_2 = RESULT
            CALL Z2R_JIGS_UP, Z2_PSTR:((Z2_GLOBAL:G_OTHER_PROPERTIES) & 65535)
            Z2T_3 = RESULT
        ELSEIF (Z2L_BRICK_ROOM == O_SAFE_ROOM)
            CALL Z2_QUEUE, INT_SAFE, 5, 1
            Z2_GLOBAL:G_MUNGED_ROOM = O_SAFE_ROOM
            PRINTS "There is an explosion nearby."
            PRINTL
            IF (Z2_PARENT:(O_BRICK) == O_SLOT)
                Z2_ATTR:(O_SLOT):(F_INVISIBLE) = 1
                Z2_ATTR:(O_SAFE):(F_OPENBIT) = 1
                Z2_ATTR:(O_SAFE_ROOM):(F_TOUCHBIT) = 0
                Z2_GLOBAL:G_SAFE_FLAG = 1
            ENDIF
        ELSE
            PRINTS "There is an explosion nearby."
            PRINTL
            CALL Z2_QUEUE, INT_SAFE, 5, 1
            Z2_GLOBAL:G_MUNGED_ROOM = Z2L_BRICK_ROOM
            Z2L_F = Z2_CHILD:(Z2L_BRICK_ROOM)
            IF Z2L_F
                Z2T_4 = 0
                WHILE 1
                    IF Z2_ATTR:(Z2L_F):(F_TAKEBIT)
                        Z2_ATTR:(Z2L_F):(F_INVISIBLE) = 1
                    ENDIF
                    Z2L_F = Z2_SIBLING:(Z2L_F)
                    IF !(Z2L_F)
                        Z2T_4 = 1
                        BREAK
                    ENDIF
                WEND
            ENDIF
        ENDIF
        CALL Z2_REMOVE, O_BRICK
    ELSEIF (Z2_PARENT:(O_FUSE) == Z2_WINNER || Z2_PARENT:(O_FUSE) == Z2_HERE)
        PRINTS "The string rapidly burns into nothingness."
        PRINTL
    ENDIF
    CALL Z2_REMOVE, O_FUSE
    RETURN 1

; 2actions.zil:462 ROUTINE I-SAFE
@Z2R_I_SAFE
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2_HERE == Z2_GLOBAL:G_MUNGED_ROOM)
        CALL Z2R_JIGS_UP, "The room trembles and 5000 tons of rock fall on you, turning you into a pancake."
        Z2T_1 = RESULT
    ELSEIF !(Z2_DEAD)
        PRINTS "You may recall that recent explosion. Probably as a result of it, you hear an ominous rumbling, as if a nearby room had collapsed."
        PRINTL
        IF (Z2_GLOBAL:G_MUNGED_ROOM == O_SAFE_ROOM)
            CALL Z2_QUEUE, INT_LEDGE, 8, 1
        ENDIF
    ENDIF
    CALL Z2R_MUNG_ROOM, Z2_GLOBAL:G_MUNGED_ROOM, "The way is blocked by debris from an explosion."
    Z2T_2 = RESULT
    RETURN Z2T_2

; 2actions.zil:476 ROUTINE I-LEDGE
@Z2R_I_LEDGE
#DIM DYNAMIC Z2L_RM
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
    Z2L_RM = O_LEDGE_2
    IF (Z2_HERE == O_LEDGE_2)
        IF (Z2_PARENT:(Z2_WINNER) == O_BALLOON)
            IF Z2_GLOBAL:G_BTIE_FLAG
                Z2_GLOBAL:G_BLOC = O_VOLCANO_BOTTOM
                CALL Z2_REMOVE, O_BALLOON
                CALL Z2_MOVE, O_DEAD_BALLOON, O_VOLCANO_BOTTOM
                Z2_GLOBAL:G_BTIE_FLAG = 0
                Z2_GLOBAL:G_BINF_FLAG = 0
                CALL Z2_ENABLE, INT_BALLOON, 0
                CALL Z2_ENABLE, INT_BURNUP, 0
                CALL Z2R_JIGS_UP, "The ledge collapses, probably as a result of the explosion, and plummets to the ground far below. Sadly, you were still attached to the ledge."
                Z2T_1 = RESULT
            ELSE
                PRINTS "The ledge collapses, leaving you with no place to land."
                PRINTL
            ENDIF
        ELSE
            CALL Z2R_JIGS_UP, "The force of the recent explosion has caused the ledge to collapse."
            Z2T_2 = RESULT
        ENDIF
    ELSEIF !(Z2_DEAD)
        PRINTS "The ledge collapses. (That was a narrow escape!)"
        PRINTL
    ENDIF
    CALL Z2R_MUNG_ROOM, Z2L_RM, "The ledge has collapsed and cannot be landed on."
    Z2T_3 = RESULT
    RETURN Z2T_3

; 2actions.zil:500 ROUTINE LEDGE-FCN
@Z2R_LEDGE_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
    IF (Z2L_RARG == 3)
        PRINTS "You are on a wide ledge high in the volcano. The rim of the volcano is about 200 feet above and there is a precipitous drop to the bottom."
        IF Z2_ATTR:(O_SAFE_ROOM):(F_RMUNGBIT)
            PRINTS " The way to the south is blocked by rubble."
            PRINTL
            RETURN 1
        ELSE
            PRINTS " There is a small door to the south."
            PRINTL
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:514 ROUTINE I-GNOME
@Z2R_I_GNOME
    IF (Z2_HERE == O_LEDGE_1 || Z2_HERE == O_LEDGE_2)
        PRINTS "A volcano gnome seems to walk straight out of the wall and "
        IF (Z2_PARENT:(O_WAND) == Z2_WINNER)
            PRINTS "noticing the wand, straight back in."
            PRINTL
            RETURN 1
        ELSE
            PRINTS "says \"I have a busy appointment schedule and little time to waste on trespassers, but for a small fee I'll show you the way out.\" You notice the gnome nervously glancing at his watch."
            PRINTL
            CALL Z2_MOVE, O_GNOME, Z2_HERE
            RETURN 1
        ENDIF
    ELSE
        CALL Z2_QUEUE, INT_GNOME, 1, 1
        RETURN 0
    ENDIF

; 2actions.zil:534 ROUTINE GNOME-FCN
@Z2R_GNOME_FCN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2_PRSA == V_TELL)
        Z2_P_CONT = 0
        Z2_QUOTE_FLAG = 0
        IF !(Z2_GLOBAL:G_GNOME_FLAG)
            CALL Z2_QUEUE, INT_NERVOUS, 5, 1
        ENDIF
        Z2_GLOBAL:G_GNOME_FLAG = 1
        PRINTS "The gnome appears increasingly nervous."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_GIVE || Z2_PRSA == V_THROW)) && ((Z2_PRSI == O_GNOME)))
        IF Z2_GETPT(Z2_PRSO, 8)
            PRINTS "\"Thank you very much for the "
            PRINTS Z2_NAME:(Z2_PRSO)
            PRINTS ". I don't believe I've ever seen one as beautiful. Follow me,\" he says, and a door appears on the west end of the ledge. Through the door, you can see a narrow chimney sloping steeply downward. The gnome moves quickly, and disappears from sight."
            PRINTL
            CALL Z2_REMOVE, Z2_PRSO
            CALL Z2_REMOVE, O_GNOME
            Z2_GLOBAL:G_GNOME_DOOR_FLAG = 1
            RETURN Z2_GLOBAL:G_GNOME_DOOR_FLAG
        ELSE
            CALL Z2R_BOMBQ, Z2_PRSO
            Z2T_1 = RESULT
            IF Z2T_1
                CALL Z2_MOVE, O_BRICK, Z2_HERE
                CALL Z2_REMOVE, O_GNOME
                CALL Z2_ENABLE, INT_GNOME, 0
                CALL Z2_ENABLE, INT_NERVOUS, 0
                PRINTS "\"That certainly wasn't what I had in mind,\" he says, and disappears."
                PRINTL
                RETURN 1
            ELSE
                CALL Z2R_REMOVE_CAREFULLY, Z2_PRSO
                Z2T_2 = RESULT
                PRINTS "\"That wasn't quite what I had in mind,\" he says, crunching the "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS " in his rock-hard hands."
                PRINTL
                RETURN 1
            ENDIF
        ENDIF
    ELSE
        PRINTS "The gnome appears increasingly nervous."
        PRINTL
        IF !(Z2_GLOBAL:G_GNOME_FLAG)
            CALL Z2_QUEUE, INT_NERVOUS, 5, 1
        ENDIF
        Z2_GLOBAL:G_GNOME_FLAG = 1
        RETURN Z2_GLOBAL:G_GNOME_FLAG
    ENDIF

; 2actions.zil:573 ROUTINE I-NERVOUS
@Z2R_I_NERVOUS
    IF (Z2_PARENT:(O_GNOME) == Z2_HERE)
        PRINTS "The gnome glances at his watch. \"Oops. I'm late for an appointment!\" He disappears, leaving you alone on the ledge."
        PRINTL
    ENDIF
    CALL Z2_REMOVE, O_GNOME
    RETURN 1

; 2actions.zil:580 ROUTINE PURPLE-BOOK-FCN
@Z2R_PURPLE_BOOK_FCN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (((Z2_PRSA == V_READ)) && ((Z2_PARENT:(O_STAMP) == O_PURPLE_BOOK)) && (!(Z2_ATTR:(O_PURPLE_BOOK):(F_OPENBIT))))
        PRINTS Z2_TEXT:(O_PURPLE_BOOK)
        PRINTL
        CALL Z2_PERFORM, V_OPEN, O_PURPLE_BOOK
        Z2T_1 = RESULT
        RETURN 1
    ELSE
        CALL Z2R_RANDOM_BOOK
        Z2T_2 = RESULT
        RETURN Z2T_2
    ENDIF

; 2actions.zil:589 ROUTINE RANDOM-BOOK
@Z2R_RANDOM_BOOK
    IF (Z2_PRSA == V_TAKE || Z2_PRSA == V_MOVE || Z2_PRSA == V_PUT)
        Z2_ATTR:(O_WHITE_BOOK):(F_TOUCHBIT) = 1
        Z2_ATTR:(O_PURPLE_BOOK):(F_TOUCHBIT) = 1
        Z2_ATTR:(O_GREEN_BOOK):(F_TOUCHBIT) = 1
        Z2_ATTR:(O_BLUE_BOOK):(F_TOUCHBIT) = 1
        RETURN 0
    ENDIF
    RETURN 0

; 2actions.zil:599 ROUTINE HEAD-FCN
@Z2R_HEAD_FCN
#DIM DYNAMIC Z2T_1
    IF (Z2_PRSA == V_HELLO)
        PRINTS "The Flatheads are dead; therefore they do not respond."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_KICK || Z2_PRSA == V_ATTACK || Z2_PRSA == V_RUB || Z2_PRSA == V_OPEN || Z2_PRSA == V_TAKE || Z2_PRSA == V_BURN)
        CALL Z2R_JIGS_UP, "Although the Flatheads are dead, they foresaw that some cretin might tamper with their remains. Therefore, they took steps to punish such actions."
        Z2T_1 = RESULT
        RETURN Z2T_1
    ENDIF
    RETURN 0

; 2actions.zil:608 ROUTINE CRYPT-ANTEROOM-FCN
@Z2R_CRYPT_ANTEROOM_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
    IF (Z2L_RARG == 3)
        PRINTS "The anteroom is large and empty. Marble bas reliefs depict the stirring times and afterlife of the Flatheads (the latter a bit optimistically). The exit is to the west. A huge marble door stands to the south. "
        PRINTS "The door is "
        IF Z2_ATTR:(O_CRYPT_DOOR):(F_OPENBIT)
            PRINTS "open."
        ELSE
            PRINTS "closed."
        ENDIF
        PRINTS " Above the door is the cryptic inscription: \"Feel Free\"."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:621 ROUTINE CRYPT-ROOM-FCN
@Z2R_CRYPT_ROOM_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2L_CLITQ
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
    IF (Z2L_RARG == 3)
        Z2_ATTR:(Z2_HERE):(F_ONBIT) = 0
        CALL Z2_LITQ_OF, Z2_HERE
        Z2T_1 = RESULT
        IF Z2T_1
            PRINTS "The room contains the earthly remains of the mighty Flatheads, twelve somewhat flat heads mounted securely on poles. While the room might be expected to contain funerary urns or other evidence of the ritual practices of the ancient Zorkers, it is empty of all such objects. There is writing carved on the crypt. The only apparent exit is to the north through the door to the anteroom. The door is "
            IF Z2_ATTR:(O_CRYPT_DOOR):(F_OPENBIT)
                PRINTS "open."
            ELSE
                PRINTS "closed."
            ENDIF
            PRINTL
            IF !(Z2_ATTR:(O_DIM_DOOR):(F_INVISIBLE))
                PRINTS "Looking closely at the south wall, you can see the dim outline of a secret door labelled with the letter \"F\"."
                PRINTL
            ENDIF
        ELSE
            CALL Z2R_DIM_DOOR_APPEARS
            Z2T_2 = RESULT
        ENDIF
        Z2_ATTR:(Z2_HERE):(F_ONBIT) = 1
        RETURN 1
    ELSEIF (Z2L_RARG == 6)
        Z2L_CLITQ = Z2_GLOBAL:G_CRYPT_LITQ
        Z2_ATTR:(O_CRYPT_ROOM):(F_ONBIT) = 0
        CALL Z2_LITQ_OF, O_CRYPT_ROOM
        Z2T_3 = RESULT
        Z2_GLOBAL:G_CRYPT_LITQ = Z2T_3
        IF ((Z2L_CLITQ) && (!(Z2_GLOBAL:G_CRYPT_LITQ)))
            CALL Z2R_DIM_DOOR_APPEARS
            Z2T_4 = RESULT
        ENDIF
        Z2_ATTR:(O_CRYPT_ROOM):(F_ONBIT) = 1
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:655 ROUTINE DIM-DOOR-APPEARS
@Z2R_DIM_DOOR_APPEARS
    PRINTS "It is dark, but on the south wall is a faint outline of a rectangle, as though light were shining around a doorway. You can also make out a faintly glowing letter in the center of this area. It might be an \"F\"."
    PRINTL
    Z2_ATTR:(O_DIM_DOOR):(F_INVISIBLE) = 0
    RETURN 1

; 2actions.zil:662 ROUTINE CRYPT-OBJECT
@Z2R_CRYPT_OBJECT
    IF (Z2_PRSA == V_OPEN)
        PRINTS "The crypt is sealed for all time."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_RUB)
        PRINTS "The marble is cool."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:666 ROUTINE CRYPT-DOOR-FCN
@Z2R_CRYPT_DOOR_FCN
#DIM DYNAMIC Z2T_1
    IF (Z2_PRSA == V_OPEN || Z2_PRSA == V_CLOSE)
        CALL Z2R_OPEN_CLOSE, Z2_PRSO, "The crypt door squeaks open.", "The crypt door squeaks closed."
        Z2T_1 = RESULT
        RETURN Z2T_1
    ENDIF
    RETURN 0

; 2actions.zil:672 ROUTINE TOMB-PSEUDO
@Z2R_TOMB_PSEUDO
#DIM DYNAMIC Z2T_1
    IF (Z2_PRSA == V_THROUGH)
        CALL Z2R_DO_WALK, 30
        Z2T_1 = RESULT
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:679 ROUTINE DIM-DOOR-FCN
@Z2R_DIM_DOOR_FCN
#DIM DYNAMIC Z2T_1
    IF (Z2_PRSA == V_KNOCK)
        PRINTS "A hollow echo responds."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_OPEN || Z2_PRSA == V_CLOSE)
        IF (Z2_PRSA == V_OPEN)
            Z2_GLOBAL:G_DIM_DOOR_FLAG = 1
        ELSE
            Z2_GLOBAL:G_DIM_DOOR_FLAG = 0
        ENDIF
        CALL Z2R_OPEN_CLOSE, Z2_PRSO, "The secret door opens noiselessly.", "The secret door closes noiselessly."
        Z2T_1 = RESULT
        RETURN Z2T_1
    ENDIF
    RETURN 0

; 2actions.zil:688 ROUTINE REPELLENT-FCN
@Z2R_REPELLENT_FCN
    IF (Z2_PRSA == V_SHAKE)
        IF Z2_GLOBAL:G_SPRAY_USEDQ
            PRINTS "The can seems empty."
            PRINTL
            RETURN 1
        ELSE
            PRINTS "There is a sloshing sound from inside."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF (((Z2_PRSA == V_SPRAY || Z2_PRSA == V_PUT)) && ((Z2_PRSO == O_REPELLENT)))
        IF Z2_GLOBAL:G_SPRAY_USEDQ
            PRINTS "The repellent is all gone."
            PRINTL
            RETURN 1
        ELSEIF !(Z2_PRSI)
            Z2_GLOBAL:G_SPRAY_USEDQ = 1
            PRINTS "The spray stinks amazingly for a few moments, then drifts away."
            PRINTL
            RETURN 1
        ELSE
            IF (Z2_PRSI == O_ME)
                CALL Z2_QUEUE, INT_SPRAY, 8, 1
                Z2_GLOBAL:G_SPRAYEDQ = 1
            ENDIF
            Z2_GLOBAL:G_SPRAY_USEDQ = 1
            PRINTS "The spray smells like a mixture of old socks and burning rubber. If I were a grue I'd sure stay clear!"
            PRINTL
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:711 ROUTINE I-SPRAY
@Z2R_I_SPRAY
    Z2_GLOBAL:G_SPRAYEDQ = 0
    PRINTS "That horrible smell is much less pungent now."
    PRINTL
    RETURN 1

; 2actions.zil:715 ROUTINE ZORK3-FCN
@Z2R_ZORK3_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2L_RARG == 3)
        PRINTS "Beyond the door is a roughly hewn staircase leading down into darkness. The landing on which you stand is covered with carefully drawn magical runes like those sketched upon the workbench of the Wizard of Frobozz. These have been overlaid with sweeping green lines of enormous power, which undulate back and forth across the landing. "
        IF (Z2_PARENT:(O_WAND) == Z2_WINNER)
            PRINTS "The wand begins to vibrate in harmony with the motion of the lines. You feel yourself compelled downward, and you yield, stepping onto the staircase. As you pass the green lines, they flare and disappear with a burst of light, and you tumble down the staircase!"
            PRINTL
            PRINTL
            PRINTS "At the bottom, a vast red-lit hall stretches off into the distance. Sinister statues guard the entrance to a dimly visible room far ahead. With courage and cunning you have conquered the Wizard of Frobozz and become the master of his domain, but the final challenge awaits!"
            PRINTL
            PRINTL
            PRINTS "(The ultimate adventure concludes in \"Zork III: The Dungeon Master\".)"
            PRINTL
            PRINTL
            PRINTL
            Z2_WON = 1
            CALL Z2_FINISH
            Z2T_1 = RESULT
            RETURN Z2T_1
        ELSE
            CALL Z2R_JIGS_UP, "The green curves begin to vibrate toward you, as if searching for something. One by one your possessions glow bright green. Finally, you are attacked by these magical wardens, and destroyed!"
            Z2T_2 = RESULT
            RETURN Z2T_2
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:754 ROUTINE I-BUCKET
@Z2R_I_BUCKET
    IF (Z2_PARENT:(O_WATER) == O_BUCKET)
        Z2_GLOBAL:G_EVAPORATED = 1
        CALL Z2_REMOVE, O_WATER
    ENDIF
    RETURN 0

; 2actions.zil:760 ROUTINE WATER-FCN
@Z2R_WATER_FCN
#DIM DYNAMIC Z2L_AV
#DIM DYNAMIC Z2L_W
#DIM DYNAMIC Z2L_PIQ
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
    IF (Z2_PRSA == V_SGIVE)
        RETURN 0
    ELSEIF (Z2_PRSA == V_THROUGH)
        CALL Z2_PERFORM, V_SWIM, Z2_PRSO
        Z2T_1 = RESULT
        RETURN 1
    ELSEIF (Z2_PRSA == V_FILL)
        Z2L_W = Z2_PRSI
        Z2_PRSA = V_PUT
        Z2_PRSI = Z2_PRSO
        Z2_PRSO = Z2L_W
        Z2L_PIQ = 0
    ELSEIF (Z2_PRSO == O_GLOBAL_WATER || Z2_PRSO == O_WATER)
        Z2L_W = Z2_PRSO
        Z2L_PIQ = 0
    ELSEIF Z2_PRSI
        Z2L_W = Z2_PRSI
        Z2L_PIQ = 1
    ENDIF
    IF (Z2L_W == O_GLOBAL_WATER)
        Z2L_W = O_WATER
        IF (Z2_PRSA == V_TAKE || Z2_PRSA == V_PUT)
            CALL Z2_REMOVE, Z2L_W
        ENDIF
    ENDIF
    IF Z2L_PIQ
        Z2_PRSI = Z2L_W
    ELSE
        Z2_PRSO = Z2L_W
    ENDIF
    Z2L_AV = Z2_PARENT:(Z2_WINNER)
    IF !(Z2_ATTR:(Z2L_AV):(F_VEHBIT))
        Z2L_AV = 0
    ENDIF
    IF (((Z2_PRSA == V_TAKE || Z2_PRSA == V_PUT)) && (!(Z2L_PIQ)))
        IF ((Z2L_AV) && ((Z2L_AV == Z2_PRSI)))
            CALL Z2R_PUDDLE, Z2L_AV
            Z2T_2 = RESULT
            RETURN Z2T_2
        ELSEIF ((Z2L_AV) && (!(Z2_PRSI)) && (!((Z2_PARENT:(Z2L_W) == Z2L_AV))))
            CALL Z2R_PUDDLE, Z2L_AV
            Z2T_3 = RESULT
            RETURN Z2T_3
        ELSEIF ((Z2_PRSI) && (!((Z2_PRSI == O_TEAPOT))))
            PRINTS "The water leaks out of the "
            PRINTS Z2_NAME:(Z2_PRSI)
            PRINTS " and evaporates immediately."
            PRINTL
            CALL Z2_REMOVE, Z2L_W
            RETURN 1
        ELSEIF (Z2_PARENT:(O_TEAPOT) == Z2_WINNER)
            IF !(Z2_CHILD:(O_TEAPOT))
                IF (Z2_HERE == O_POOL_ROOM)
                    CALL Z2_MOVE, O_SALTY_WATER, O_TEAPOT
                ELSE
                    CALL Z2_MOVE, O_WATER, O_TEAPOT
                ENDIF
                PRINTS "The teapot is now full of water."
                PRINTL
                RETURN 1
            ELSE
                PRINTS "The teapot isn't currently empty."
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (((Z2_PARENT:(Z2_PRSO) == O_TEAPOT)) && ((Z2_PRSA == V_TAKE)) && (!(Z2_PRSI)))
            Z2_PRSO = O_TEAPOT
            CALL Z2R_ITAKE
            Z2T_4 = RESULT
            Z2_PRSO = Z2L_W
            RETURN Z2_PRSO
        ELSE
            PRINTS "The water slips through your fingers."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF Z2L_PIQ
        PRINTS "Nice try."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_DROP || Z2_PRSA == V_GIVE)
        IF (((Z2_PRSO == O_WATER)) && (!(Z2_HELDQ(O_WATER))))
            PRINTS "You don't have any water."
            PRINTL
            RETURN 1
        ENDIF
        CALL Z2_REMOVE, O_WATER
        IF Z2L_AV
            CALL Z2R_PUDDLE, Z2L_AV
            Z2T_5 = RESULT
            RETURN Z2T_5
        ELSE
            PRINTS "The water spills to the floor and evaporates."
            PRINTL
            CALL Z2_REMOVE, O_WATER
            RETURN 1
        ENDIF
    ELSEIF (Z2_PRSA == V_THROW)
        PRINTS "The water splashes on the walls and evaporates."
        PRINTL
        CALL Z2_REMOVE, O_WATER
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:830 ROUTINE PUDDLE
@Z2R_PUDDLE(Z2L_AV = 0)
#DIM DYNAMIC Z2L_AV
    PRINTS "There is now a puddle in the bottom of the "
    PRINTS Z2_NAME:(Z2L_AV)
    PRINTS "."
    PRINTL
    CALL Z2_MOVE, Z2_PRSO, Z2L_AV
    RETURN 1

; 2actions.zil:834 ROUTINE BUCKET-FCN
@Z2R_BUCKET_FCN(Z2L_RARG = 1)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
    IF (Z2L_RARG == 1)
        IF (((Z2_PRSA == V_BURN)) && ((Z2_PRSO == O_BUCKET)))
            PRINTS "The bucket is fireproof, and won't burn."
            PRINTL
            RETURN 1
        ELSEIF (((Z2_PRSA == V_DROP || Z2_PRSA == V_PUT)) && ((Z2_PRSO == O_WATER)) && ((Z2_PRSI == O_BUCKET)) && ((Z2_PARENT:(O_BUCKET) == O_WELL_BOTTOM)) && (!((Z2_PARENT:(Z2_WINNER) == O_BUCKET))))
            PRINTS "The bucket swiftly rises up, and is gone."
            PRINTL
            CALL Z2_MOVE, O_BUCKET, O_WELL_TOP
            CALL Z2_MOVE, O_WATER, O_BUCKET
            Z2_GLOBAL:G_BUCKET_TOP_FLAG = 1
            CALL Z2_QUEUE, INT_BUCKET, 100, 1
            RETURN 1
        ELSEIF (Z2_PRSA == V_KICK)
            CALL Z2R_JIGS_UP, "If you insist."
            Z2T_1 = RESULT
            RETURN Z2T_1
        ENDIF
        RETURN 0
    ELSEIF (Z2L_RARG == 6)
        IF (((Z2_PARENT:(O_WATER) == O_BUCKET)) && (!(Z2_GLOBAL:G_BUCKET_TOP_FLAG)))
            PRINTS "The bucket rises and comes to a stop."
            PRINTL
            PRINTL
            Z2_GLOBAL:G_BUCKET_TOP_FLAG = 1
            Z2_GLOBAL:G_EVAPORATED = 0
            CALL Z2R_PASS_THE_BUCKET, O_WELL_TOP
            Z2T_2 = RESULT
            CALL Z2_QUEUE, INT_BUCKET, 100, 1
            RETURN 1
        ELSEIF ((Z2_GLOBAL:G_BUCKET_TOP_FLAG) && (!((Z2_PARENT:(O_WATER) == O_BUCKET))))
            IF Z2_GLOBAL:G_EVAPORATED
                PRINTS "The last of the water evaporates, and the bucket descends."
                PRINTL
                PRINTL
            ELSE
                PRINTS "The bucket descends and comes to a stop."
                PRINTL
                PRINTL
            ENDIF
            Z2_GLOBAL:G_BUCKET_TOP_FLAG = 0
            CALL Z2R_PASS_THE_BUCKET, O_WELL_BOTTOM
            Z2T_3 = RESULT
            RETURN Z2T_3
        ENDIF
        RETURN 0
    ELSEIF (Z2_PRSA == V_CLIMB_ON)
        CALL Z2_PERFORM, V_BOARD, Z2_PRSO
        Z2T_4 = RESULT
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:876 ROUTINE PASS-THE-BUCKET
@Z2R_PASS_THE_BUCKET(Z2L_R = 0)
#DIM DYNAMIC Z2L_R
#DIM DYNAMIC Z2T_1
    CALL Z2_MOVE, O_BUCKET, Z2L_R
    IF (Z2_PARENT:(Z2_WINNER) == O_BUCKET)
        CALL Z2R_GOTO, Z2L_R
        Z2T_1 = RESULT
        RETURN Z2T_1
    ENDIF
    RETURN 0

; 2actions.zil:886 ROUTINE POSTS-ROOM-FCN
@Z2R_POSTS_ROOM_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
    IF (Z2L_RARG == 1)
        IF (((Z2_PRSA == V_TAKE)) && (Z2_ATTR:(Z2_PRSO):(F_NONLANDBIT)))
            PRINTS "The "
            PRINTS Z2_NAME:(Z2_PRSO)
            PRINTS " is now much larger than you are. You have no hope of taking it."
            PRINTL
            RETURN 1
        ENDIF
        RETURN 0
    ENDIF
    RETURN 0

; 2actions.zil:893 ROUTINE EATME-FCN
@Z2R_EATME_FCN
#DIM DYNAMIC Z2L_F
#DIM DYNAMIC Z2L_N
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
    IF (((Z2_PRSA == V_EAT)) && ((Z2_PRSO == O_EAT_ME_CAKE)) && ((Z2_HERE == O_TEA_ROOM)))
        PRINTS "Suddenly, the room appears to have become very large (although everything you are carrying seems to be its normal size)."
        PRINTL
        PRINTL
        CALL Z2_REMOVE, O_EAT_ME_CAKE
        Z2_ATTR:(O_ROBOT):(F_INVISIBLE) = 1
        Z2_ATTR:(O_ALICE_TABLE):(F_INVISIBLE) = 1
        Z2L_F = Z2_CHILD:(Z2_HERE)
        Z2T_1 = 0
        WHILE 1
            IF !(Z2L_F)
                Z2T_1 = 1
                BREAK
            ELSE
                Z2L_N = Z2_SIBLING:(Z2L_F)
                IF ((!((Z2L_F == O_ADVENTURER))) && (Z2_ATTR:(Z2L_F):(F_TAKEBIT)))
                    Z2_ATTR:(Z2L_F):(F_NONLANDBIT) = 1
                    Z2_ATTR:(Z2L_F):(F_TRYTAKEBIT) = 1
                    CALL Z2_MOVE, Z2L_F, O_POSTS_ROOM
                ENDIF
            ENDIF
            Z2L_F = Z2L_N
        WEND
        CALL Z2R_GOTO, O_POSTS_ROOM
        Z2T_2 = RESULT
        RETURN Z2T_2
    ELSE
        CALL Z2R_CAKE_CRUMBLE
        Z2T_3 = RESULT
        RETURN Z2T_3
    ENDIF

; 2actions.zil:917 ROUTINE CAKE-CRUMBLE
@Z2R_CAKE_CRUMBLE
#DIM DYNAMIC Z2L_CAKE
    IF Z2_ATTR:(Z2_PRSO):(F_FOODBIT)
        Z2L_CAKE = Z2_PRSO
    ELSE
        Z2L_CAKE = Z2_PRSI
    ENDIF
    IF (((Z2_HERE == O_TEA_ROOM || Z2_HERE == O_POSTS_ROOM || Z2_HERE == O_POOL_ROOM)) || ((Z2_HERE == O_MACHINE_ROOM || Z2_HERE == O_MAGNET_ROOM || Z2_HERE == O_CAGE_ROOM)) || ((Z2_HERE == O_WELL_TOP || Z2_HERE == O_IN_CAGE)))
        RETURN 0
    ELSE
        CALL Z2_REMOVE, Z2L_CAKE
        PRINTS "The "
        PRINTS Z2_NAME:(Z2L_CAKE)
        PRINTS " has crumbled to dust."
        PRINTL
        RETURN 1
    ENDIF

; 2actions.zil:929 ROUTINE CAKE-FCN
@Z2R_CAKE_FCN
#DIM DYNAMIC Z2L_F
#DIM DYNAMIC Z2L_N
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
#DIM DYNAMIC Z2T_6
#DIM DYNAMIC Z2T_7
#DIM DYNAMIC Z2T_8
    IF (Z2_PRSA == V_READ)
        IF Z2_ATTR:(Z2_PRSO):(F_NONLANDBIT)
            PRINTS "The cake is much too tall now for you to read the lettering."
            PRINTL
            RETURN 1
        ELSEIF Z2_PRSI
            IF (Z2_PRSI == O_PALANTIR_1 || Z2_PRSI == O_PALANTIR_2 || Z2_PRSI == O_PALANTIR_3)
                CALL Z2_PERFORM, V_LOOK_INSIDE, Z2_PRSI
                Z2T_1 = RESULT
                RETURN Z2T_1
            ELSEIF (Z2_PRSI == O_FLASK)
                PRINTS "The letters, now visible, say \""
                IF (Z2_PRSO == O_RED_ICING)
                    PRINTS "Evaporate"
                ELSEIF (Z2_PRSO == O_ORANGE_ICING)
                    PRINTS "Explode"
                ELSE
                    PRINTS "Enlarge"
                ENDIF
                PRINTS "\"."
                PRINTL
                RETURN 1
            ELSE
                PRINTS "You can't see through that!"
                PRINTL
                RETURN 1
            ENDIF
        ELSE
            PRINTS "The first letter is a capital E. The rest is too small to read."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF (((Z2_PRSA == V_EAT)) && ((Z2_HERE == O_TEA_ROOM || Z2_HERE == O_POSTS_ROOM || Z2_HERE == O_POOL_ROOM)))
        IF (Z2_PRSO == O_ORANGE_ICING)
            CALL Z2_REMOVE, Z2_PRSO
            CALL Z2R_ICEBOOM
            Z2T_2 = RESULT
            RETURN Z2T_2
        ELSEIF (Z2_PRSO == O_RED_ICING)
            CALL Z2_REMOVE, Z2_PRSO
            CALL Z2R_JIGS_UP, "That was delicious, but your dying memory is of feeling horribly dehydrated and thirsty."
            Z2T_3 = RESULT
            RETURN Z2T_3
        ELSEIF (Z2_PRSO == O_BLUE_ICING)
            CALL Z2_REMOVE, Z2_PRSO
            PRINTS "The room around you seems to be getting smaller."
            PRINTL
            PRINTL
            IF (Z2_HERE == O_POSTS_ROOM)
                Z2_ATTR:(O_ROBOT):(F_INVISIBLE) = 0
                Z2_ATTR:(O_ALICE_TABLE):(F_INVISIBLE) = 0
                Z2_ATTR:(O_POSTS):(F_INVISIBLE) = 1
                Z2L_F = Z2_CHILD:(Z2_HERE)
                Z2T_4 = 0
                WHILE 1
                    IF !(Z2L_F)
                        Z2T_4 = 1
                        BREAK
                    ELSE
                        Z2L_N = Z2_SIBLING:(Z2L_F)
                        IF ((!((Z2L_F == O_ADVENTURER))) && (Z2_ATTR:(Z2L_F):(F_TAKEBIT)))
                            Z2_ATTR:(Z2L_F):(F_NONLANDBIT) = 0
                            Z2_ATTR:(Z2L_F):(F_TRYTAKEBIT) = 0
                            CALL Z2_MOVE, Z2L_F, O_TEA_ROOM
                        ENDIF
                    ENDIF
                    Z2L_F = Z2L_N
                WEND
                CALL Z2R_GOTO, O_TEA_ROOM
                Z2T_5 = RESULT
                RETURN Z2T_5
            ELSE
                CALL Z2R_JIGS_UP, "The room seems to have become too small to hold you. The walls are not as compressible as your body, which is demolished."
                Z2T_6 = RESULT
                RETURN Z2T_6
            ENDIF
        ENDIF
        RETURN 0
    ELSEIF (((Z2_PRSA == V_THROW || Z2_PRSA == V_PUT)) && ((Z2_PRSO == O_ORANGE_ICING)) && ((Z2_HERE == O_TEA_ROOM || Z2_HERE == O_POSTS_ROOM || Z2_HERE == O_POOL_ROOM)))
        CALL Z2_REMOVE, Z2_PRSO
        CALL Z2R_ICEBOOM
        Z2T_7 = RESULT
        RETURN Z2T_7
    ELSEIF (((Z2_PRSA == V_THROW || Z2_PRSA == V_PUT)) && ((Z2_PRSO == O_RED_ICING || Z2_PRSO == O_BLUE_ICING || Z2_PRSO == O_ORANGE_ICING)) && ((Z2_PRSI == O_POOL)))
        IF (Z2_PRSO == O_BLUE_ICING || Z2_PRSO == O_ORANGE_ICING)
            PRINTS "The cake sinks majestically into the pool."
            PRINTL
            CALL Z2_REMOVE, Z2_PRSO
            RETURN 1
        ENDIF
        CALL Z2_MOVE, Z2_PRSO, Z2_HERE
        CALL Z2_REMOVE, Z2_PRSI
        PRINTS "Most of the pool evaporates, revealing a (slightly damp but still valuable) package of rare candies. The red cake must be pretty strong stuff, since it remains intact!"
        PRINTL
        Z2_ATTR:(O_CANDY):(F_INVISIBLE) = 0
        RETURN 1
    ELSE
        CALL Z2R_CAKE_CRUMBLE
        Z2T_8 = RESULT
        RETURN Z2T_8
    ENDIF

