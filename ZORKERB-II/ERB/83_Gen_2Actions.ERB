; 2actions.zil:1076 ROUTINE FLASK-FCN
@Z2R_FLASK_FCN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
    IF (Z2_PRSA == V_LOOK_INSIDE)
        PRINTS "You notice that objects behind the flask appear to be magnified. You might try looking at something through the flask."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_READ)) && ((Z2_PRSI == O_FLASK)))
        PRINTS "The flask distorts and magnifies the "
        PRINTS Z2_NAME:(Z2_PRSO)
        PRINTS ", showing details not noticed earlier."
        PRINTL
        RETURN 0
    ELSEIF (Z2_PRSA == V_OPEN)
        CALL Z2R_MUNG_ROOM, Z2_HERE, "Noxious vapors prevent your entry."
        Z2T_1 = RESULT
        CALL Z2R_JIGS_UP, Z2_PSTR:((Z2_GLOBAL:G_FATAL_VAPORS) & 65535)
        Z2T_2 = RESULT
        RETURN Z2T_2
    ELSEIF (Z2_PRSA == V_MUNG || Z2_PRSA == V_THROW)
        PRINTS "The flask breaks into pieces."
        PRINTL
        CALL Z2_REMOVE, Z2_PRSO
        CALL Z2R_JIGS_UP, Z2_PSTR:((Z2_GLOBAL:G_FATAL_VAPORS) & 65535)
        Z2T_3 = RESULT
        RETURN Z2T_3
    ENDIF
    RETURN 0

; 2actions.zil:1098 ROUTINE PLEAK
@Z2R_PLEAK
#DIMS DYNAMIC Z2T_1
    IF (Z2_PRSA == V_TAKE)
        CALL Z2_PICK_ONE, Z2_GLOBAL:G_YUKS
