        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:1104 ROUTINE ICEBOOM
@Z2R_ICEBOOM
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    CALL Z2R_MUNG_ROOM, Z2_HERE, "The entrance is blocked by sticky orange rubble. Probably some careless adventurer was playing with blasting cakes."
    Z2T_1 = RESULT
    CALL Z2R_JIGS_UP, "You have been blasted to smithereens (wherever they are)."
    Z2T_2 = RESULT
    RETURN Z2T_2

; 2actions.zil:1111 ROUTINE MAGNET-ROOM-FCN
@Z2R_MAGNET_ROOM_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIMS DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2L_RARG == 3)
        PRINTS "You are in a circular room with a low ceiling. There are exits to the east and southeast."
        PRINTL
        RETURN 1
    ELSEIF (((Z2L_RARG == 2)) && (Z2_GLOBAL:G_CAROUSEL_FLIP_FLAG))
        IF Z2_GLOBAL:G_CAROUSEL_ZOOM_FLAG
            IF (O_ADVENTURER == Z2_WINNER)
                Z2T_1 '= "According to Prof. TAA of GUE Tech, the rapidly changing magnetic fields in the room are intense enough to electrocute you. I really don't know, but in any event, something just killed you."
            ELSE
                Z2T_1 '= "According to Prof. TAA of GUE Tech, the magnetic fields in the room are intense enough to fry the delicate innards of the robot. I really don't know, but in any event, smoke pours from its ears and it has stopped moving."
            ENDIF
            CALL Z2R_JIGS_UP, Z2T_1
            Z2T_2 = RESULT
            RETURN Z2T_2
        ELSEIF (Z2_WINNER == O_ADVENTURER)
            PRINTS "As you enter, your compass starts spinning wildly."
            PRINTL
            IF !(Z2_GLOBAL:G_COMPASS_KLUDGE)
                PRINTS "What compass, you ask? The one which allows you to specify compass directions for movement."
                Z2_GLOBAL:G_COMPASS_KLUDGE = 1
            ENDIF
            PRINTL
            RETURN 1
        ENDIF
        RETURN 0
    ENDIF
    RETURN 0

; 2actions.zil:1139 ROUTINE MAGNET-ROOM-EXIT
@Z2R_MAGNET_ROOM_EXIT
    IF ((Z2_GLOBAL:G_CAROUSEL_FLIP_FLAG) && ((Z2_WINNER == O_ADVENTURER)))
        PRINTS "You cannot get your bearings..."
        PRINTL
        PRINTL
        IF (50 > Z2_RANDOM(100))
            RETURN O_MACHINE_ROOM
        ELSE
            RETURN O_TEA_ROOM
        ENDIF
    ELSEIF (Z2_PRSO == 30)
        RETURN O_MACHINE_ROOM
    ELSEIF (((Z2_PRSO == 25)) || ((Z2_PRSO == 20)))
        RETURN O_TEA_ROOM
    ELSE
        PRINTS "You can't go that way."
        PRINTL
        RETURN 0
    ENDIF

; 2actions.zil:1159 ROUTINE BUTTONS
@Z2R_BUTTONS
#DIM DYNAMIC Z2T_1
    IF (Z2_PRSA == V_PUSH)
        IF (Z2_WINNER == O_ADVENTURER)
            CALL Z2R_JIGS_UP, "There is a giant spark and you are fried to a crisp."
            Z2T_1 = RESULT
            RETURN Z2T_1
        ELSEIF (Z2_PRSO == O_SQUARE_BUTTON)
            IF Z2_GLOBAL:G_CAROUSEL_ZOOM_FLAG
                PRINTS "Nothing seems to happen."
                PRINTL
                RETURN 1
            ELSE
                Z2_GLOBAL:G_CAROUSEL_ZOOM_FLAG = 1
                PRINTS "The whirring increases in intensity."
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (Z2_PRSO == O_ROUND_BUTTON)
            IF Z2_GLOBAL:G_CAROUSEL_ZOOM_FLAG
                Z2_GLOBAL:G_CAROUSEL_ZOOM_FLAG = 0
                PRINTS "The whirring decreases in intensity."
                PRINTL
                RETURN 1
            ELSE
                PRINTS "Nothing seems to happen."
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (Z2_PRSO == O_TRIANGULAR_BUTTON)
            Z2_GLOBAL:G_CAROUSEL_FLIP_FLAG = !(Z2_GLOBAL:G_CAROUSEL_FLIP_FLAG)
            IF (Z2_PARENT:(O_IRON_BOX) == O_CAROUSEL_ROOM)
                PRINTS "A dull thump is heard in the distance."
                PRINTL
                IF Z2_ATTR:(O_IRON_BOX):(F_INVISIBLE)
                    Z2_ATTR:(O_IRON_BOX):(F_INVISIBLE) = 0
                ELSE
                    Z2_ATTR:(O_IRON_BOX):(F_INVISIBLE) = 1
                ENDIF
                IF !(Z2_ATTR:(O_IRON_BOX):(F_INVISIBLE))
                    Z2_ATTR:(O_CAROUSEL_ROOM):(F_TOUCHBIT) = 0
                ENDIF
                RETURN 1
            ELSE
                PRINTS "Click."
                PRINTL
                RETURN 1
            ENDIF
        ENDIF
        RETURN 0
    ENDIF
    RETURN 0

; 2actions.zil:1192 ROUTINE SPHERE-FCN
@Z2R_SPHERE_FCN
#DIM DYNAMIC Z2L_FL
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
    IF ((!(Z2_GLOBAL:G_CAGE_SOLVE_FLAG)) && ((Z2_PRSA == V_TAKE || Z2_PRSA == V_MOVE || Z2_PRSA == V_PUT)))
        Z2L_FL = 1
    ELSE
        Z2L_FL = 0
    ENDIF
    IF ((Z2L_FL) && ((O_ADVENTURER == Z2_WINNER)))
        PRINTS "As you reach for the sphere, a solid steel cage falls from the ceiling to entrap you. To make matters worse, poisonous gas starts coming into the room."
        PRINTL
        PRINTL
        IF (Z2_PARENT:(O_ROBOT) == Z2_HERE)
            CALL Z2_MOVE, O_ROBOT, O_IN_CAGE
            Z2_ATTR:(O_ROBOT):(F_NDESCBIT) = 1
        ENDIF
        CALL Z2R_GOTO, O_IN_CAGE
        Z2T_1 = RESULT
        CALL Z2_MOVE, O_CAGE, Z2_HERE
        Z2_ATTR:(O_CAGE):(F_NDESCBIT) = 1
        Z2_ATTR:(O_CAGE):(F_INVISIBLE) = 0
        CALL Z2_QUEUE, INT_SPHERE, 6, 1
        RETURN 1
    ELSEIF Z2L_FL
        Z2_ATTR:(O_PALANTIR_1):(F_INVISIBLE) = 1
        CALL Z2_REMOVE, O_ROBOT
        Z2_ATTR:(Z2_PRSO):(F_INVISIBLE) = 1
        CALL Z2_MOVE, O_CAGE, O_CAGE_ROOM
        Z2_ATTR:(O_CAGE):(F_INVISIBLE) = 0
        CALL Z2R_JIGS_UP, "As the robot reaches for the sphere, a solid steel cage falls from the ceiling, trapping him. You can faintly hear his last words: \"Whirr, buzz, click!\" A cloud of smoke rising from beneath the cage confirms your fears about the fate of your brave mechanical friend."
        Z2T_2 = RESULT
        RETURN 1
    ELSEIF (Z2_PRSA == V_LOOK_INSIDE || Z2_PRSA == V_EXAMINE)
        CALL Z2R_PALANTIR
        Z2T_3 = RESULT
        RETURN Z2T_3
    ENDIF
    RETURN 0

; 2actions.zil:1226 ROUTINE I-SPHERE
@Z2R_I_SPHERE
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2_HERE == O_CAGE_ROOM || Z2_HERE == O_IN_CAGE)
        Z2_ATTR:(O_PALANTIR_1):(F_INVISIBLE) = 1
        CALL Z2R_MUNG_ROOM, O_CAGE_ROOM, "You are stopped by a cloud of poisonous gas."
        Z2T_1 = RESULT
        CALL Z2R_JIGS_UP, "Time passes...and you die from some obscure poisoning."
        Z2T_2 = RESULT
        RETURN Z2T_2
    ENDIF
    RETURN 0

; 2actions.zil:1234 ROUTINE IN-CAGE-FCN
@Z2R_IN_CAGE_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
    IF Z2_GLOBAL:G_CAGE_SOLVE_FLAG
        Z2_HERE = O_CAGE_ROOM
        RETURN Z2_HERE
    ENDIF
    RETURN 0

; 2actions.zil:1237 ROUTINE ROBOT-FCN
@Z2R_ROBOT_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2_WINNER == O_ROBOT)
        IF (Z2_PRSA == V_SGIVE)
            RETURN 0
        ELSEIF (Z2_PRSA == V_FOLLOW)
            PRINTS "\"My memory circuits are not that advanced. I can move as directed, though.\""
            PRINTL
            RETURN 1
        ELSEIF (((Z2_PRSA == V_RAISE || Z2_PRSA == V_TAKE || Z2_PRSA == V_MOVE)) && ((Z2_PRSO == O_CAGE)))
            PRINTS "The cage shakes and is hurled across the room. It's hard to say, but the robot appears to be smiling."
            PRINTL
            PRINTL
            CALL Z2_ENABLE, INT_SPHERE, 0
            Z2_WINNER = O_ADVENTURER
            CALL Z2R_GOTO, O_CAGE_ROOM
            Z2T_1 = RESULT
            CALL Z2_MOVE, O_MANGLED_CAGE, O_CAGE_ROOM
            Z2_ATTR:(O_ROBOT):(F_NDESCBIT) = 0
            Z2_ATTR:(O_PALANTIR_1):(F_TAKEBIT) = 1
            CALL Z2_MOVE, O_ROBOT, O_CAGE_ROOM
            Z2_GLOBAL:G_CAGE_SOLVE_FLAG = 1
            RETURN Z2_GLOBAL:G_CAGE_SOLVE_FLAG
        ELSEIF (Z2_PRSA == V_EAT || Z2_PRSA == V_DRINK)
            IF (Z2_PARENT:(O_ADVENTURER) == Z2_HERE)
                PRINTS "\"I am sorry but that is difficult for a being with no mouth.\""
                PRINTL
            ENDIF
            RETURN 1
        ELSEIF (((2 > Z2_RANDOM(100))) && ((Z2_META_LOC(O_ADVENTURER) == Z2_HERE)))
            PRINTS "\"Buzz! Buzz! Buzz! My circuits are getting rusty. Try again.\""
            PRINTL
            RETURN 1
        ELSEIF (Z2_PRSA == V_READ || Z2_PRSA == V_EXAMINE)
            IF (Z2_META_LOC(O_ADVENTURER) == Z2_HERE)
                PRINTS "\"My vision is not sufficiently acute to do that.\""
                PRINTL
            ENDIF
            RETURN 1
        ELSEIF (Z2_PRSA == V_DROP || Z2_PRSA == V_PUT || Z2_PRSA == V_THROW)
            IF !((Z2_META_LOC(O_ADVENTURER) == Z2_HERE))
                RETURN 0
            ELSEIF (Z2_PARENT:(Z2_PRSO) == O_ROBOT)
                PRINTS "\"Whirr, buzz, click!\""
                PRINTL
                RETURN 0
            ELSE
                PRINTS "\"Click! I don't have that. Buzz! Whirr!\""
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (((Z2_PRSA == V_WALK)) || ((((Z2_PRSA == V_TAKE || Z2_PRSA == V_PUSH || Z2_PRSA == V_TURN)) && (!(Z2_ATTR:(Z2_PRSO):(F_ACTORBIT))))))
            IF !((Z2_META_LOC(O_ADVENTURER) == Z2_HERE))
                RETURN 0
            ELSEIF (80 > Z2_RANDOM(100))
                PRINTS "\"Whirr, buzz, click!\""
                PRINTL
            ELSE
                PRINTS "\"Buzz, click, whirr!\""
                PRINTL
            ENDIF
            RETURN 0
        ELSE
            IF (Z2_META_LOC(O_ADVENTURER) == Z2_HERE)
                PRINTS "\"My programming is insufficient to allow me to perform that task.\""
                PRINTL
            ENDIF
            RETURN 1
        ENDIF
    ELSEIF (Z2_PRSA == V_OPEN || Z2_PRSA == V_LOOK_INSIDE || Z2_PRSA == V_CLOSE)
        PRINTS "There's no access panel or door on the robot."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_GIVE)) && ((Z2_PRSI == O_ROBOT)))
        CALL Z2_MOVE, Z2_PRSO, O_ROBOT
        PRINTS "The robot gladly takes the "
        PRINTS Z2_NAME:(Z2_PRSO)
        PRINTS " and nods his head-like appendage in thanks."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_THROW || Z2_PRSA == V_MUNG)
        PRINTS "The robot falls to the ground and (being of shoddy construction) disintegrates before your eyes."
        PRINTL
        IF (Z2_PRSA == V_THROW)
            Z2T_2 = Z2_PRSI
        ELSE
            Z2T_2 = Z2_PRSO
            IF Z2T_2
            ELSE
                Z2T_2 = 0
            ENDIF
        ENDIF
        CALL Z2_REMOVE, Z2T_2
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:1314 ROUTINE BILLS-OBJECT
@Z2R_BILLS_OBJECT
    Z2_GLOBAL:G_BANK_SOLVE_FLAG = 1
    IF (Z2_PRSA == V_BURN)
        PRINTS "Nothing like having money to burn!"
        PRINTL
        RETURN 0
    ELSEIF (Z2_PRSA == V_EAT)
        PRINTS "Talk about eating rich foods!"
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:1322 ROUTINE BKLEAVEE
@Z2R_BKLEAVEE(Z2L_RM = O_TELLER_EAST)
#DIM DYNAMIC Z2L_RM
    IF ((Z2_HELDQ(O_BILLS)) || (Z2_HELDQ(O_PORTRAIT)))
        PRINTS "An alarm rings briefly, and an invisible force bars your way."
        PRINTL
        RETURN 0
    ELSE
        RETURN Z2L_RM
    ENDIF

; 2actions.zil:1330 ROUTINE BKLEAVEW
@Z2R_BKLEAVEW
#DIM DYNAMIC Z2T_1
    CALL Z2R_BKLEAVEE, O_TELLER_WEST
    Z2T_1 = RESULT
    RETURN Z2T_1

; 2actions.zil:1359 ROUTINE DEPOSITORY-FCN
@Z2R_DEPOSITORY_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2T_1
    IF (Z2L_RARG == 2)
        CALL Z2R_LKP, Z2_PRSO, Z2_GLOBAL:G_SCOL_ROOMS
        Z2T_1 = RESULT
        Z2_GLOBAL:G_SCOL_ROOM = Z2T_1
        RETURN Z2_GLOBAL:G_SCOL_ROOM
    ENDIF
    RETURN 0

; 2actions.zil:1363 ROUTINE TELLER-ROOM
@Z2R_TELLER_ROOM(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
    IF (Z2L_RARG == 3)
        PRINTS "You are in a small room, which was used by a bank officer who retrieved safety deposit boxes for the customer. On the north side of the room is a sign which reads  \"Viewing Room\". On the "
        IF (Z2_HERE == O_TELLER_WEST)
            PRINTS "west"
        ELSE
            PRINTS "east"
        ENDIF
        PRINTS " side of the room, above an open door, is a sign reading:"
        PRINTL
        PRINTL
        PRINTS "          BANK PERSONNEL ONLY"
        PRINTL
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:1376 ROUTINE SCOL-OBJECT
@Z2R_SCOL_OBJECT(Z2L_OBJ = 0)
#DIM DYNAMIC Z2L_OBJ
#DIM DYNAMIC Z2T_1
    IF (Z2_PRSA == V_PUSH || Z2_PRSA == V_MOVE || Z2_PRSA == V_TAKE || Z2_PRSA == V_RUB)
        PRINTS "As you try, your hand seems to go through it."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_ATTACK)) && (Z2_PRSI))
        PRINTS "The "
        PRINTS Z2_NAME:(Z2_PRSI)
        PRINTS " goes through it."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_THROW || Z2_PRSA == V_OVERBOARD)) && ((Z2_PRSI == O_CURTAIN || Z2_PRSI == Z2L_OBJ)))
        IF (Z2_PARENT:(Z2_PRSO) == Z2_WINNER)
            CALL Z2R_V_THROUGH, Z2_PRSO
            Z2T_1 = RESULT
            RETURN Z2T_1
        ELSE
            PRINTS "You don't have that!"
            PRINTL
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:1386 ROUTINE GET-WALL
@Z2R_GET_WALL(Z2L_RM = 0)
#DIM DYNAMIC Z2L_RM
#DIM DYNAMIC Z2L_W
#DIM DYNAMIC Z2T_1
    Z2L_W = Z2_GLOBAL:G_SCOL_WALLS
    Z2T_1 = 0
    WHILE 1
        IF (Z2_GETW(Z2L_W + 2 * 0) == Z2L_RM)
            Z2T_1 = Z2L_W
            BREAK
        ELSE
            Z2L_W = (Z2L_W + 6)
        ENDIF
    WEND
    RETURN Z2T_1

; 2actions.zil:1394 ROUTINE SCOLWALL
@Z2R_SCOLWALL
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
    Z2T_2 = 1
    Z2T_2 = ((Z2_PRSA == V_THROW || Z2_PRSA == V_OVERBOARD || Z2_PRSA == V_PUT)) != 0
    IF Z2T_2
        Z2T_2 = ((Z2_HERE == Z2_GLOBAL:G_SCOL_ACTIVE)) != 0
        IF Z2T_2
            CALL Z2R_GET_WALL, Z2_HERE
            Z2T_3 = RESULT
            Z2T_2 = ((Z2_PRSI == Z2_GETW(Z2T_3 + 2 * 1))) != 0
        ENDIF
    ENDIF
    IF Z2T_2
        CALL Z2R_SCOL_OBJECT, Z2_PRSI
        Z2T_4 = RESULT
        RETURN Z2T_4
    ENDIF
    RETURN 0

; 2actions.zil:1400 ROUTINE SCOL-GO
@Z2R_SCOL_GO(Z2L_OBJ = 0)
#DIM DYNAMIC Z2L_OBJ
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    Z2_GLOBAL:G_SCOL_ACTIVE = Z2_GLOBAL:G_SCOL_ROOM
    IF Z2L_OBJ
        CALL Z2R_SCOL_OBJ, Z2L_OBJ, 0, Z2_GLOBAL:G_SCOL_ROOM
        Z2T_1 = RESULT
        RETURN Z2T_1
    ELSE
        CALL Z2R_SCOL_THROUGH, 12, Z2_GLOBAL:G_SCOL_ROOM
        Z2T_2 = RESULT
        RETURN Z2T_2
    ENDIF

; 2actions.zil:1407 ROUTINE SCOL-OBJ
@Z2R_SCOL_OBJ(Z2L_OBJ = 0, Z2L_CINT = 0, Z2L_RM = 0)
#DIM DYNAMIC Z2L_OBJ
#DIM DYNAMIC Z2L_CINT
#DIM DYNAMIC Z2L_RM
    CALL Z2_QUEUE, INT_CURTAIN, Z2L_CINT, 1
    CALL Z2_MOVE, Z2L_OBJ, Z2L_RM
    IF (Z2L_RM == O_DEPOSITORY)
        PRINTS "The "
        PRINTS Z2_NAME:(Z2L_OBJ)
        PRINTS " passes through the wall and vanishes."
        PRINTL
        RETURN 1
    ELSE
        PRINTS "The curtain dims slightly as the "
        PRINTS Z2_NAME:(Z2L_OBJ)
        PRINTS " passes through."
        PRINTL
        Z2_GLOBAL:G_SCOL_ROOM = 0
        RETURN 1
    ENDIF

; 2actions.zil:1419 ROUTINE SCOL-THROUGH
@Z2R_SCOL_THROUGH(Z2L_CINT = 0, Z2L_RM = 0)
#DIM DYNAMIC Z2L_CINT
#DIM DYNAMIC Z2L_RM
#DIM DYNAMIC Z2T_1
    CALL Z2_QUEUE, INT_CURTAIN, Z2L_CINT, 1
    PRINTS "You feel somewhat disoriented as you pass through..."
    PRINTL
    PRINTL
    CALL Z2R_GOTO, Z2L_RM
    Z2T_1 = RESULT
    RETURN Z2T_1

; 2actions.zil:1427 ROUTINE I-CURTAIN
@Z2R_I_CURTAIN
#DIM DYNAMIC Z2T_1
    Z2_GLOBAL:G_SCOL_ACTIVE = 0
    IF (Z2_HERE == O_VAULT)
        CALL Z2R_JIGS_UP, "A metallic voice says \"Hello, Intruder! Your unauthorized presence in the vault of the Bank of Zork has set off all sorts of nasty surprises, most of which are fatal. This message brought to you by the Frobozz Magic Vault Company.\""
        Z2T_1 = RESULT
        RETURN Z2T_1
    ELSEIF (Z2_HERE == O_VIEWING_EAST || Z2_HERE == O_VIEWING_WEST || Z2_HERE == O_SMALL_ROOM)
        PRINTS "You hear a faint voice say \"Curtain Door Closed.\""
        PRINTL
        IF (Z2_HERE == O_SMALL_ROOM)
            IF Z2_GLOBAL:G_ZGNOME_FLAG
                RETURN 1
            ELSE
                CALL Z2_QUEUE, INT_ZGNOME, 3, 1
                Z2_GLOBAL:G_ZGNOME_FLAG = 1
                RETURN Z2_GLOBAL:G_ZGNOME_FLAG
            ENDIF
        ENDIF
        RETURN 0
    ENDIF
    RETURN 0

; 2actions.zil:1445 ROUTINE I-ZGNOME
@Z2R_I_ZGNOME
    IF (Z2_HERE == O_SMALL_ROOM)
        CALL Z2_QUEUE, INT_ZGNOME_OUT, 12, 1
        PRINTS "An epicene gnome of Zurich wearing a three-piece suit and carrying a safety deposit box materializes in the room."
        IF (Z2_PARENT:(O_WAND) == Z2_WINNER)
            PRINTS " He notices the wand and dematerializes speedily."
            PRINTL
            RETURN 1
        ELSE
            PRINTS " \"You seem to have forgotten to deposit your valuables,\" he says, tapping the lid of the box impatiently. \"We don't usually allow customers to use the boxes here, but we can make this ONE exception, I suppose...\" He looks askance at you over his wire-rimmed bifocals."
            PRINTL
            CALL Z2_MOVE, O_GNOME_OF_ZURICH, Z2_HERE
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:1462 ROUTINE BOX-F
@Z2R_BOX_F
    PRINTS "The gnome clutches it possessively."
    PRINTL
    RETURN 1

; 2actions.zil:1465 ROUTINE ZGNOME-FCN
@Z2R_ZGNOME_FCN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
    IF (Z2_PRSA == V_TELL)
        Z2_P_CONT = 0
        Z2_QUOTE_FLAG = 0
        PRINTS "The gnome appears increasingly impatient."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_GIVE || Z2_PRSA == V_THROW)) && ((Z2_PRSI == O_GNOME_OF_ZURICH)))
        IF Z2_GETPT(Z2_PRSO, 8)
            PRINTS "The gnome carefully places the "
            PRINTS Z2_NAME:(Z2_PRSO)
            PRINTS " in the deposit box. \"Let me show you the way out,\" he says, making it clear he will be pleased to see the last of you. Then, you are momentarily disoriented, and when you recover you are back at the Bank Entrance."
            PRINTL
            CALL Z2_REMOVE, O_GNOME_OF_ZURICH
            CALL Z2_REMOVE, Z2_PRSO
            CALL Z2_ENABLE, INT_ZGNOME_OUT, 0
            CALL Z2R_GOTO, O_BANK_ENTRANCE
            Z2T_1 = RESULT
            RETURN 1
        ELSE
            CALL Z2R_BOMBQ, Z2_PRSO
            Z2T_2 = RESULT
            IF Z2T_2
                CALL Z2_REMOVE, O_GNOME_OF_ZURICH
                CALL Z2_MOVE, Z2_PRSO, Z2_HERE
                CALL Z2_ENABLE, INT_ZGNOME, 0
                CALL Z2_ENABLE, INT_ZGNOME_OUT, 0
                PRINTS "\"You are so very gracious. I really cannot accept.\" he says. He disappears, a wry smile on his lips."
                PRINTL
                RETURN 1
            ELSE
                PRINTS "\"I wouldn't put THAT in a safety deposit box,\" remarks the gnome with disdain, tossing it over his shoulder, where it disappears with an understated \"pop\"."
                PRINTL
                CALL Z2R_REMOVE_CAREFULLY, Z2_PRSO
                Z2T_3 = RESULT
                RETURN 1
            ENDIF
        ENDIF
    ELSEIF (Z2_PRSA == V_ATTACK)
        PRINTS "The gnome says \"Well, I never...\" and disappears with a snap of his fingers, leaving you alone."
        PRINTL
        CALL Z2_REMOVE, O_GNOME_OF_ZURICH
        CALL Z2_ENABLE, INT_ZGNOME_OUT, 0
        RETURN 1
    ELSE
        PRINTS "The gnome appears increasingly impatient."
        PRINTL
        RETURN 1
    ENDIF

; 2actions.zil:1508 ROUTINE I-ZGNOME-OUT
@Z2R_I_ZGNOME_OUT
    CALL Z2_REMOVE, O_GNOME_OF_ZURICH
    IF (Z2_HERE == O_SMALL_ROOM)
        PRINTS "The gnome looks impatient: \"I may have another customer waiting; you'll just have to fend for yourself, I'm afraid.\" He disappears, leaving you alone."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:1516 ROUTINE BOMB?
@Z2R_BOMBQ(Z2L_O = 0)
#DIM DYNAMIC Z2L_O
    IF (((Z2L_O == O_BRICK)) && ((Z2_PARENT:(O_FUSE) == O_BRICK)) && (!((Z2_CINT_ON:(Z2_INT(INT_FUSE)) == 0))))
        RETURN 1
    ELSE
        RETURN 0
    ENDIF

; 2actions.zil:1527 ROUTINE GO&LOOK
@Z2R_GOANDLOOK(Z2L_RM = 0)
#DIM DYNAMIC Z2L_RM
#DIM DYNAMIC Z2L_OHERE
#DIM DYNAMIC Z2L_OLIT
#DIM DYNAMIC Z2L_OSEEN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    Z2L_OSEEN = 0
    Z2L_OHERE = Z2_HERE
    IF Z2_ATTR:(Z2L_OHERE):(F_TOUCHBIT)
        Z2L_OSEEN = 1
    ENDIF
    Z2L_OLIT = Z2_LITQ
    Z2_HERE = Z2L_RM
    CALL Z2_LITQ_OF, Z2L_RM
    Z2T_1 = RESULT
    Z2_LITQ = Z2T_1
    CALL Z2_PERFORM, V_LOOK
    Z2T_2 = RESULT
    IF !(Z2L_OSEEN)
        Z2_ATTR:(Z2L_OHERE):(F_TOUCHBIT) = 0
    ENDIF
    Z2_HERE = Z2L_OHERE
    Z2_LITQ = Z2L_OLIT
    RETURN 1

; 2actions.zil:1541 ROUTINE TINY-ROOM-FCN
@Z2R_TINY_ROOM_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2L_RARG == 3)
        PRINTS "This is a tiny room carved out of the wall of the ravine. There is an exit down a precarious climb. "
        CALL Z2R_P_DOOR, "north", O_LID_1, O_KEYHOLE_1
        Z2T_1 = RESULT
        RETURN 1
    ELSEIF !((Z2_PRSA == V_LOOK))
        CALL Z2R_PCHECK
        Z2T_2 = RESULT
        RETURN 0
    ENDIF
    RETURN 0

; 2actions.zil:1551 ROUTINE DREARY-ROOM-FCN
@Z2R_DREARY_ROOM_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2L_RARG == 3)
        PRINTS "This is a small and rather dreary room, eerily illuminated by a red glow emanating from a crack in one wall. The light falls upon a dusty wooden table in the center of the room. "
        CALL Z2R_P_DOOR, "south", O_LID_2, O_KEYHOLE_2
        Z2T_1 = RESULT
        RETURN 1
    ENDIF
    CALL Z2R_PCHECK
    Z2T_2 = RESULT
    RETURN 0

; 2actions.zil:1562 ROUTINE PCHECK
@Z2R_PCHECK
#DIM DYNAMIC Z2L_LID
#DIM DYNAMIC Z2T_1
    CALL Z2R_PLID
    Z2T_1 = RESULT
    Z2L_LID = Z2T_1
    Z2_GLOBAL:G_PLOOK_FLAG = 0
    IF (((Z2_PARENT:(O_KEY) == O_KEYHOLE_1)) || ((Z2_PARENT:(O_KEY) == O_KEYHOLE_2)))
        Z2_ATTR:(O_KEY):(F_NDESCBIT) = 1
    ELSE
        Z2_ATTR:(O_KEY):(F_NDESCBIT) = 0
    ENDIF
    IF Z2_HELDQ(O_PLACE_MAT)
        Z2_GLOBAL:G_MUD_FLAG = 0
    ENDIF
    IF Z2_GLOBAL:G_MUD_FLAG
        CALL Z2_MOVE, O_PLACE_MAT, Z2_HERE
        Z2_ATTR:(O_PLACE_MAT):(F_NDESCBIT) = 1
        RETURN 1
    ELSE
        Z2_ATTR:(O_PLACE_MAT):(F_NDESCBIT) = 0
        RETURN 1
    ENDIF

; 2actions.zil:1578 ROUTINE P-DOOR
@Z2R_P_DOOR(Z2L_STR = "", Z2L_LID = 0, Z2L_KEYHOLE = 0)
#DIMS DYNAMIC Z2L_STR
#DIM DYNAMIC Z2L_LID
#DIM DYNAMIC Z2L_KEYHOLE
#DIM DYNAMIC Z2L_F
    IF Z2_GLOBAL:G_PLOOK_FLAG
        Z2_GLOBAL:G_PLOOK_FLAG = 0
        RETURN 0
    ENDIF
    PRINTS "On the "
    PRINTS Z2L_STR
    PRINTS " side of the room is a massive wooden door, which has a small window barred with iron. A formidable bolt lock is set within the door frame. A keyhole "
    IF !(Z2_ATTR:(Z2L_LID):(F_OPENBIT))
        PRINTS "covered by a thin metal lid "
    ENDIF
    PRINTS "lies within the lock."
    Z2L_F = Z2_CHILD:(Z2L_KEYHOLE)
    IF Z2L_F
        PRINTS " A "
        PRINTS Z2_NAME:(Z2L_F)
        PRINTS " is in place within the keyhole."
    ENDIF
    IF Z2_GLOBAL:G_MUD_FLAG
        PRINTS " The edge of a place mat is visible under the door."
        IF Z2_GLOBAL:G_MATOBJ
            PRINTS " Lying on the place mat is a "
            PRINTS Z2_NAME:(Z2_GLOBAL:G_MATOBJ)
            PRINTS "."
        ENDIF
    ENDIF
    PRINTL
    RETURN 1

; 2actions.zil:1598 ROUTINE PLID
@Z2R_PLID(Z2L_OBJ1 = O_LID_1, Z2L_OBJ2 = O_LID_2)
#DIM DYNAMIC Z2L_OBJ1
#DIM DYNAMIC Z2L_OBJ2
    IF (Z2_PARENT:(Z2L_OBJ1) == Z2_HERE)
        RETURN Z2L_OBJ1
    ELSE
        RETURN Z2L_OBJ2
    ENDIF

; 2actions.zil:1604 ROUTINE PKH
@Z2R_PKH(Z2L_KEYHOLE = 0, Z2L_THIS = 0)
#DIM DYNAMIC Z2L_KEYHOLE
#DIM DYNAMIC Z2L_THIS
    IF (((Z2L_KEYHOLE == O_KEYHOLE_1)) && (!(Z2L_THIS)))
        RETURN O_KEYHOLE_2
    ELSEIF ((!((Z2L_KEYHOLE == O_KEYHOLE_1))) && (Z2L_THIS))
        RETURN O_KEYHOLE_2
    ELSE
        RETURN O_KEYHOLE_1
    ENDIF

; 2actions.zil:1612 ROUTINE PKH-FCN
@Z2R_PKH_FCN
#DIM DYNAMIC Z2L_OBJ
#DIM DYNAMIC Z2L_KH
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
#DIM DYNAMIC Z2T_6
#DIM DYNAMIC Z2T_7
#DIM DYNAMIC Z2T_8
    IF (Z2_PRSA == V_LOOK_INSIDE)
        Z2T_3 = 1
        Z2T_3 = (Z2_ATTR:(O_LID_1):(F_OPENBIT)) != 0
        IF Z2T_3
            Z2T_3 = (Z2_ATTR:(O_LID_2):(F_OPENBIT)) != 0
            IF Z2T_3
                Z2T_3 = (!(Z2_CHILD:(O_KEYHOLE_1))) != 0
                IF Z2T_3
                    Z2T_3 = (!(Z2_CHILD:(O_KEYHOLE_2))) != 0
                    IF Z2T_3
                        IF (Z2_HERE == O_DREARY_ROOM)
                            Z2T_4 = O_TINY_ROOM
                        ELSE
                            Z2T_4 = O_DREARY_ROOM
                        ENDIF
                        CALL Z2_LITQ_OF, Z2T_4
                        Z2T_5 = RESULT
                        Z2T_3 = (Z2T_5) != 0
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
        IF Z2T_3
            PRINTS "You can see a lighted room at the other end."
            PRINTL
            RETURN 1
        ELSE
            PRINTS "No light can be seen through the keyhole."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF (Z2_PRSA == V_PUT)
        CALL Z2R_PLID
        Z2T_6 = RESULT
        IF Z2_ATTR:(Z2T_6):(F_OPENBIT)
            CALL Z2R_PKH, Z2_PRSI, 1
            Z2T_7 = RESULT
            IF Z2_CHILD:(Z2T_7)
                PRINTS "The keyhole is blocked."
                PRINTL
                RETURN 1
            ELSEIF (Z2_PRSO == O_LETTER_OPENER || Z2_PRSO == O_KEY)
                CALL Z2R_PKH, Z2_PRSI
                Z2T_8 = RESULT
                Z2L_KH = Z2T_8
                IF Z2_CHILD:(Z2L_KH)
                    PRINTS "There is a faint noise from behind the door and a small cloud of dust rises from beneath it."
                    PRINTL
                    Z2L_OBJ = Z2_CHILD:(Z2L_KH)
                    CALL Z2_REMOVE, Z2L_OBJ
                    IF Z2_GLOBAL:G_MUD_FLAG
                        Z2_GLOBAL:G_MATOBJ = Z2L_OBJ
                    ENDIF
                    RETURN 0
                ENDIF
                RETURN 0
            ELSE
                PRINTS "The "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS " doesn't fit."
                PRINTL
                RETURN 1
            ENDIF
        ELSE
            PRINTS "The lid is in the way."
            PRINTL
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:1644 ROUTINE PLID-FCN
@Z2R_PLID_FCN
#DIM DYNAMIC Z2T_1
    IF (Z2_PRSA == V_OPEN || Z2_PRSA == V_RAISE || Z2_PRSA == V_MOVE)
        IF Z2_ATTR:(Z2_PRSO):(F_OPENBIT)
            PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_DUMMY + 2 * Z2_RANDOM(Z2_GETW(Z2_GLOBAL:G_DUMMY)))) & 65535)
            PRINTL
        ELSE
            PRINTS "The lid is now open."
            PRINTL
        ENDIF
        Z2_ATTR:(Z2_PRSO):(F_OPENBIT) = 1
        RETURN 1
    ELSEIF (Z2_PRSA == V_CLOSE || Z2_PRSA == V_LOWER)
        IF (Z2_HERE == O_DREARY_ROOM)
            Z2T_1 = O_KEYHOLE_2
        ELSE
            Z2T_1 = O_KEYHOLE_1
        ENDIF
        IF Z2_CHILD:(Z2T_1)
            PRINTS "The keyhole is occupied."
            PRINTL
            RETURN 1
        ELSE
            PRINTS "The lid covers the keyhole."
            PRINTL
            Z2_ATTR:(Z2_PRSO):(F_OPENBIT) = 0
            RETURN 1
        ENDIF
    ELSEIF (Z2_PRSA == V_LOOK_BEHIND)
        PRINTS "There's a keyhole behind the lid."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:1669 ROUTINE ROOM?
@Z2R_ROOMQ(Z2L_OBJ = 0)
#DIM DYNAMIC Z2L_OBJ
#DIM DYNAMIC Z2L_NOBJ
#DIM DYNAMIC Z2T_1
    Z2T_1 = 0
    WHILE 1
        Z2L_NOBJ = Z2_PARENT:(Z2L_OBJ)
        IF !(Z2L_NOBJ)
            RETURN 0
        ELSEIF (Z2L_NOBJ == Z2_WINNER)
            RETURN 0
        ELSEIF (Z2L_NOBJ == O_ROOMS)
            Z2T_1 = Z2L_OBJ
            BREAK
        ENDIF
        Z2L_OBJ = Z2L_NOBJ
    WEND
    RETURN Z2T_1

; 2actions.zil:1677 ROUTINE PALANTIR
@Z2R_PALANTIR
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2_PRSA == V_LOOK_INSIDE)
        IF (Z2_PRSO == O_PALANTIR_1)
            Z2T_1 = O_PALANTIR_2
        ELSEIF (Z2_PRSO == O_PALANTIR_2)
            Z2T_1 = O_PALANTIR_3
        ELSEIF (Z2_PRSO == O_PALANTIR_3)
            Z2T_1 = O_PALANTIR_1
        ELSE
            Z2T_1 = O_PALANTIR_4
        ENDIF
        CALL Z2R_PALANTIR_LOOK, Z2T_1
        Z2T_2 = RESULT
        RETURN Z2T_2
    ELSEIF (Z2_PRSA == V_EXAMINE)
        PRINTS "There is something misty in the sphere. Perhaps if you were to look into it..."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_TAKE)) && ((Z2_PRSO == O_PALANTIR_3)))
        Z2_LDESC:(Z2_PRSO) '= ""
        RETURN 0
    ENDIF
    RETURN 0

; 2actions.zil:1694 ROUTINE DEAD-PALANTIR
@Z2R_DEAD_PALANTIR(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2L_P
#DIMS DYNAMIC Z2T_1
#DIMS DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
#DIM DYNAMIC Z2T_6
    IF (Z2L_RARG == 3)
        PRINTS "You are inside a huge crystalline sphere filled with thin "
        IF (Z2_HERE == O_DEAD_PALANTIR_1)
            Z2L_P = O_PALANTIR_1
            Z2T_1 '= "red"
        ELSEIF (Z2_HERE == O_DEAD_PALANTIR_2)
            Z2L_P = O_PALANTIR_2
            Z2T_1 '= "blue"
        ELSE
            Z2L_P = O_PALANTIR_3
            Z2T_1 '= "white"
        ENDIF
        PRINTS Z2T_1
        PRINTS " mist. The mist becomes "
        IF (Z2_HERE == O_DEAD_PALANTIR_1)
            Z2T_2 '= "blue"
        ELSEIF (Z2_HERE == O_DEAD_PALANTIR_2)
            Z2T_2 '= "white"
        ELSE
            Z2T_2 '= "black"
        ENDIF
        PRINTS Z2T_2
        PRINTS " to the west."
        PRINTL
        PRINTS "You strain to look out through the mist... "
        PRINTL
        IF Z2_ATTR:(Z2L_P):(F_TOUCHBIT)
            CALL Z2R_PALANTIR_LOOK, Z2L_P, 1
            Z2T_3 = RESULT
        ELSEIF (Z2L_P == O_PALANTIR_1)
            PRINTS "You see a small room with a sign on the wall, but it is too blurry to read."
            PRINTL
        ELSEIF (Z2L_P == O_PALANTIR_2)
            PRINTS "You look out into a large, dreary room with a great door and a huge table. There is an odd glow to the mist."
            PRINTL
        ELSEIF (Z2L_P == O_PALANTIR_3)
            PRINTS "A strange blurry room is barely visible."
            IF (((Z2_PARENT:(O_SERPENT) == O_AQUARIUM)) && ((25 > Z2_RANDOM(100))))
                PRINTS " An odd sinuous shadow crosses the mist as you look."
            ENDIF
            PRINTL
        ENDIF
        RETURN 1
    ELSEIF (((Z2L_RARG == 2)) && ((Z2_HERE == O_DEAD_PALANTIR_4)))
        PRINTS "You follow a corridor of black mist into a black walled spherical room."
        IF (Z2_PARENT:(O_GENIE) == O_PENTAGRAM_ROOM)
            PRINTS " The room is empty. A huge face looks down on you from outside and laughs sardonically. It doesn't look like you're getting out of this predicament!"
            PRINTL
            CALL Z2_FINISH
            Z2T_4 = RESULT
        ENDIF
        PRINTS " As you enter, a huge and horrible face materializes out of the mist."
        PRINTL
        PRINTL
        PRINTS "\"What brings you here to trouble my imprisonment, wanderer?\" it asks. Hearing no immediate answer, it studies you for a moment."
        PRINTL
        IF !((Z2_DEATHS < 3))
            PRINTS "\"Not you again! This is getting tedious. You'll obviously never be much help to me. Better luck next time, oh wondrous adventurer.\" The face disappears and everything goes black."
            PRINTL
            CALL Z2_FINISH
            Z2T_5 = RESULT
            RETURN Z2T_5
        ELSE
            PRINTS "\"Perhaps you may be of some use to me in gaining my freedom from this place. Return to your foolish quest! I shall not destroy you this time. Mayhap you will repay this favor in kind someday.\" The face vanishes and the mist begins to swirl. When it clears you are returned to the world of life."
            PRINTL
            Z2_DEAD = 0
            CALL Z2R_GOTO, O_INSIDE_BARROW
            Z2T_6 = RESULT
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:1765 ROUTINE GLOBAL-PALANTIRS
@Z2R_GLOBAL_PALANTIRS
#DIM DYNAMIC Z2T_1
    IF (Z2_PRSA == V_LOOK_INSIDE || Z2_PRSA == V_EXAMINE)
        CALL Z2R_DEAD_PALANTIR, 3
        Z2T_1 = RESULT
        RETURN Z2T_1
    ELSEIF (Z2_PRSA == V_MUNG)
        PRINTS "The sphere is unbreakable."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:1770 ROUTINE PALANTIR-LOOK
@Z2R_PALANTIR_LOOK(Z2L_OBJ = 0, Z2L_INSIDEQ = 0)
#DIM DYNAMIC Z2L_OBJ
#DIM DYNAMIC Z2L_INSIDEQ
#DIM DYNAMIC Z2L_RM
#DIM DYNAMIC Z2L_OHERE
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
#DIM DYNAMIC Z2T_6
#DIM DYNAMIC Z2T_7
    IF (Z2L_OBJ == O_PALANTIR_4)
        PRINTS "As you peer into the sphere, a strange vision takes shape...a huge and fearful face with yellow eyes. The face peers out at you expectantly."
        PRINTL
        RETURN 1
    ENDIF
    Z2L_RM = (Z2_HERE == Z2L_OBJ)
    Z2T_2 = 0
    Z2T_2 = (!(Z2L_RM)) != 0
    IF !Z2T_2
        CALL Z2_LITQ_OF, Z2L_RM
        Z2T_3 = RESULT
        Z2T_2 = (!(Z2T_3)) != 0
    ENDIF
    IF Z2T_2
        PRINTS "You see only darkness."
        PRINTL
    ELSE
        Z2T_5 = 0
        Z2T_5 = ((Z2_PARENT:(Z2L_OBJ) == Z2L_RM)) != 0
        IF !Z2T_5
            CALL Z2R_SEE_INSIDEQ, Z2_PARENT:(Z2L_OBJ)
            Z2T_6 = RESULT
            Z2T_5 = (Z2T_6) != 0
        ENDIF
        IF Z2T_5
            Z2L_OHERE = Z2_HERE
            IF Z2L_INSIDEQ
                PRINTS "As you peer through the mist, a strangely colored vision of a huge room takes shape..."
                PRINTL
                PRINTL
            ELSE
                PRINTS "As you peer into the sphere, a strange vision takes shape of a distant room, which can be described clearly...."
                PRINTL
                PRINTL
            ENDIF
            Z2_ATTR:(Z2L_OBJ):(F_INVISIBLE) = 1
            CALL Z2R_GOANDLOOK, Z2L_RM
            Z2T_7 = RESULT
            IF (Z2L_OHERE == Z2L_RM)
                PRINTS "An astonished adventurer is staring into a crystal sphere."
                PRINTL
            ENDIF
            Z2_ATTR:(Z2L_OBJ):(F_INVISIBLE) = 0
            IF !(Z2L_INSIDEQ)
                PRINTS "The vision fades, revealing only an ordinary crystal sphere."
                PRINTL
            ENDIF
        ELSE
            PRINTS "You see only darkness."
            PRINTL
        ENDIF
    ENDIF
    RETURN 1

; 2actions.zil:1802 ROUTINE PWINDOW-FCN
@Z2R_PWINDOW_FCN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2_PRSA == V_LOOK_INSIDE)
        Z2_GLOBAL:G_PLOOK_FLAG = 1
        IF Z2_ATTR:(O_PDOOR):(F_OPENBIT)
            PRINTS "The door is open, dummy."
            PRINTL
            RETURN 1
        ELSEIF (Z2_HERE == O_DREARY_ROOM)
            CALL Z2R_GOANDLOOK, O_TINY_ROOM
            Z2T_1 = RESULT
            RETURN Z2T_1
        ELSE
            CALL Z2R_GOANDLOOK, O_DREARY_ROOM
            Z2T_2 = RESULT
            RETURN Z2T_2
        ENDIF
    ELSEIF (Z2_PRSA == V_THROUGH)
        PRINTS "Perhaps if you were diced...."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:1813 ROUTINE PDOOR-FCN
@Z2R_PDOOR_FCN
#DIM DYNAMIC Z2L_K
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
    IF (((Z2_PRSA == V_LOOK_UNDER)) && (Z2_GLOBAL:G_MUD_FLAG))
        PRINTS "The place mat is under the door."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_UNLOCK)
        IF (Z2_PRSI == O_KEY)
            Z2T_2 = 1
            CALL Z2R_PLID, O_KEYHOLE_1, O_KEYHOLE_2
            Z2T_3 = RESULT
            Z2L_K = Z2_CHILD:(Z2T_3)
            Z2T_2 = (Z2L_K) != 0
            IF Z2T_2
                Z2T_2 = (!((Z2L_K == O_KEY))) != 0
            ENDIF
            IF Z2T_2
                PRINTS "The keyhole is blocked."
                PRINTL
                RETURN 1
            ELSE
                PRINTS "The door is now unlocked."
                PRINTL
                Z2_GLOBAL:G_PUNLOCK_FLAG = 1
                RETURN Z2_GLOBAL:G_PUNLOCK_FLAG
            ENDIF
        ELSEIF (Z2_PRSI == O_GOLD_KEY)
            PRINTS "It doesn't fit the lock."
            PRINTL
            RETURN 1
        ELSE
            PRINTS "It can't be unlocked with that."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF (Z2_PRSA == V_LOCK)
        IF (Z2_PRSI == O_KEY)
            PRINTS "The door is locked."
            PRINTL
            Z2_GLOBAL:G_PUNLOCK_FLAG = 0
            RETURN 1
        ELSEIF (Z2_PRSI == O_GOLD_KEY)
            PRINTS "It doesn't fit the lock."
            PRINTL
            RETURN 1
        ELSE
            PRINTS "It can't be locked with that."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF (Z2_PRSA == V_PUT_UNDER)
        IF (Z2_PRSO == O_ROBOT_LABEL)
            PRINTS "The paper is very small and vanishes under the door."
            PRINTL
            IF (Z2_HERE == O_TINY_ROOM)
                Z2T_4 = O_DREARY_ROOM
            ELSE
                Z2T_4 = O_TINY_ROOM
            ENDIF
            CALL Z2_MOVE, Z2_PRSO, Z2T_4
            RETURN 1
        ELSEIF (Z2_PRSO == O_NEWSPAPER)
            PRINTS "The newspaper crumples up and won't go under the door."
            PRINTL
            RETURN 1
        ENDIF
        RETURN 0
    ELSEIF (Z2_PRSA == V_OPEN || Z2_PRSA == V_CLOSE)
        IF Z2_GLOBAL:G_PUNLOCK_FLAG
            CALL Z2R_OPEN_CLOSE, Z2_PRSO, "The door is now open.", "The door is now closed."
            Z2T_5 = RESULT
            RETURN Z2T_5
        ELSE
            PRINTS "The door is locked."
            PRINTL
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:1851 ROUTINE PKEY-FCN
@Z2R_PKEY_FCN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2_PRSA == V_TURN)
        IF Z2_GLOBAL:G_PUNLOCK_FLAG
            CALL Z2_PERFORM, V_LOCK, O_PDOOR, Z2_PRSO
            Z2T_1 = RESULT
            RETURN Z2T_1
        ELSE
            CALL Z2_PERFORM, V_UNLOCK, O_PDOOR, Z2_PRSO
            Z2T_2 = RESULT
            RETURN Z2T_2
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:1858 ROUTINE PLACE-MAT-FCN
@Z2R_PLACE_MAT_FCN
    IF (Z2_PRSA == V_PUT_UNDER)
        IF (Z2_PRSI == O_PDOOR)
            PRINTS "The place mat fits easily under the door."
            PRINTL
            CALL Z2_MOVE, Z2_PRSO, Z2_HERE
            Z2_GLOBAL:G_MUD_FLAG = 1
            RETURN Z2_GLOBAL:G_MUD_FLAG
        ELSEIF (Z2_PRSI == O_WIZ_DOOR || Z2_PRSI == O_RIDDLE_DOOR || Z2_PRSI == O_CRYPT_DOOR)
            PRINTS "There's not enough room under this door."
            PRINTL
            RETURN 1
        ENDIF
        RETURN 0
    ELSEIF (((Z2_PRSA == V_TAKE || Z2_PRSA == V_MOVE)) && (Z2_GLOBAL:G_MATOBJ))
        CALL Z2_MOVE, Z2_GLOBAL:G_MATOBJ, Z2_HERE
        PRINTS "As the place mat is moved, a "
        PRINTS Z2_NAME:(Z2_GLOBAL:G_MATOBJ)
        PRINTS " falls from it and onto the floor."
        PRINTL
        Z2_GLOBAL:G_MATOBJ = 0
        Z2_GLOBAL:G_MUD_FLAG = 0
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:1876 ROUTINE WISH-FCN
@Z2R_WISH_FCN
    IF (Z2_PRSA == V_MAKE)
        IF (((Z2_HERE == O_WELL_BOTTOM)) && ((Z2_PARENT:(O_COIN) == Z2_HERE)))
            PRINTS "A whispering voice replies: \"Water makes the bucket go.\" Unfortunately, wishing makes the coin go...."
            PRINTL
            CALL Z2_REMOVE, O_COIN
            RETURN 1
        ELSE
            PRINTS "No one is listening."
            PRINTL
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:1887 ROUTINE WELL-FCN
@Z2R_WELL_FCN
    IF ((Z2_ATTR:(Z2_PRSO):(F_TAKEBIT)) && ((Z2_PRSA == V_THROW || Z2_PRSA == V_PUT || Z2_PRSA == V_DROP)))
        PRINTS "The "
        PRINTS Z2_NAME:(Z2_PRSO)
        PRINTS " is now sitting at the bottom of the well."
        PRINTL
        CALL Z2_MOVE, Z2_PRSO, O_WELL_BOTTOM
        RETURN 1
    ELSEIF (Z2_PRSA == V_CLIMB_UP || Z2_PRSA == V_CLIMB_DOWN || Z2_PRSA == V_CLIMB_FOO)
        PRINTS "You can't climb the well."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:1897 ROUTINE MATCH-FCN
@Z2R_MATCH_FCN
#DIM DYNAMIC Z2L_CNT
    IF (((Z2_PRSA == V_LAMP_ON || Z2_PRSA == V_BURN)) && ((Z2_PRSO == O_MATCH)))
        IF (Z2_GLOBAL:G_MATCH_COUNT > 0)
            Z2_GLOBAL:G_MATCH_COUNT = (Z2_GLOBAL:G_MATCH_COUNT - 1)
        ENDIF
        IF !((Z2_GLOBAL:G_MATCH_COUNT > 0))
            PRINTS "I'm afraid you have run out of matches."
            PRINTL
            RETURN 1
        ELSE
            Z2_ATTR:(O_MATCH):(F_FLAMEBIT) = 1
            Z2_ATTR:(O_MATCH):(F_ONBIT) = 1
            CALL Z2_QUEUE, INT_MATCH, 2, 1
            PRINTS "One of the matches starts to burn."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF (((Z2_PRSA == V_LAMP_OFF)) && (Z2_ATTR:(O_MATCH):(F_FLAMEBIT)))
        PRINTS "The match is out."
        PRINTL
        Z2_ATTR:(O_MATCH):(F_FLAMEBIT) = 0
        Z2_ATTR:(O_MATCH):(F_ONBIT) = 0
        CALL Z2_QUEUE, INT_MATCH, 0, 0
        RETURN 1
    ELSEIF (Z2_PRSA == V_COUNT)
        PRINTS "You have "
        Z2L_CNT = (Z2_GLOBAL:G_MATCH_COUNT - 1)
        PRINTV Z2L_CNT
        PRINTS " match"
        IF !((Z2L_CNT == 1))
            PRINTS "es."
        ELSE
            PRINTS "."
        ENDIF
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_EXAMINE)
        IF Z2_ATTR:(O_MATCH):(F_ONBIT)
            PRINTS "A match is burning."
        ELSE
            PRINTS "No match is burning."
        ENDIF
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:1928 ROUTINE I-MATCH
@Z2R_I_MATCH
    PRINTS "The match has gone out."
    PRINTL
    Z2_ATTR:(O_MATCH):(F_FLAMEBIT) = 0
    Z2_ATTR:(O_MATCH):(F_ONBIT) = 0
    RETURN 1

; 2actions.zil:1943 ROUTINE LANTERN
@Z2R_LANTERN
    IF (((Z2_PRSA == V_THROW)) && ((Z2_PRSO == O_LAMP)))
        PRINTS "The lamp has smashed into the floor, and the light has gone out."
        PRINTL
        CALL Z2_ENABLE, INT_LANTERN, 0
        CALL Z2_REMOVE, O_LAMP
        CALL Z2_MOVE, O_BROKEN_LAMP, Z2_HERE
        RETURN 1
    ELSEIF (Z2_PRSA == V_LAMP_ON)
        IF Z2_ATTR:(O_LAMP):(F_RMUNGBIT)
            PRINTS "A burned-out lamp won't light."
            PRINTL
            RETURN 1
        ELSE
            CALL Z2_ENABLE, INT_LANTERN, 1
            RETURN 0
        ENDIF
    ELSEIF (Z2_PRSA == V_LAMP_OFF)
        IF Z2_ATTR:(O_LAMP):(F_RMUNGBIT)
            PRINTS "The lamp has already burned out."
            PRINTL
            RETURN 1
        ELSE
            CALL Z2_ENABLE, INT_LANTERN, 0
            RETURN 0
        ENDIF
    ELSEIF (Z2_PRSA == V_EXAMINE)
        IF Z2_ATTR:(O_LAMP):(F_RMUNGBIT)
            PRINTS "The lamp has burned out."
        ELSEIF Z2_ATTR:(O_LAMP):(F_ONBIT)
            PRINTS "The lamp is on."
        ELSE
            PRINTS "The lamp is turned off."
        ENDIF
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:1971 ROUTINE I-LANTERN
@Z2R_I_LANTERN
#DIM DYNAMIC Z2L_TICK
#DIM DYNAMIC Z2L_TBL
#DIM DYNAMIC Z2T_1
    Z2L_TBL = Z2_GLOBAL:G_LAMP_TABLE
    Z2L_TICK = Z2_GETW(Z2L_TBL + 2 * 0)
    CALL Z2_QUEUE, INT_LANTERN, Z2L_TICK, 1
    CALL Z2R_LIGHT_INT, O_LAMP, Z2L_TBL, Z2L_TICK
    Z2T_1 = RESULT
    IF !((Z2L_TICK == 0))
        Z2_GLOBAL:G_LAMP_TABLE = (Z2L_TBL + 4)
        RETURN Z2_GLOBAL:G_LAMP_TABLE
    ENDIF
    RETURN 0

; 2actions.zil:1977 ROUTINE LIGHT-INT
@Z2R_LIGHT_INT(Z2L_OBJ = 0, Z2L_TBL = 0, Z2L_TICK = 0)
#DIM DYNAMIC Z2L_OBJ
#DIM DYNAMIC Z2L_TBL
#DIM DYNAMIC Z2L_TICK
    IF (Z2L_TICK == 0)
        Z2_ATTR:(Z2L_OBJ):(F_ONBIT) = 0
        Z2_ATTR:(Z2L_OBJ):(F_RMUNGBIT) = 1
    ENDIF
    IF ((Z2_HELDQ(Z2L_OBJ)) || ((Z2_PARENT:(Z2L_OBJ) == Z2_HERE)))
        IF (Z2L_TICK == 0)
            PRINTS "You'd better have more light than from the "
            PRINTS Z2_NAME:(Z2L_OBJ)
            PRINTS "."
            PRINTL
            RETURN 1
        ELSE
            PRINTS Z2_PSTR:((Z2_GETW(Z2L_TBL + 2 * 1)) & 65535)
            PRINTL
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:2007 ROUTINE RIDDLE-ROOM-FCN
@Z2R_RIDDLE_ROOM_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2T_1
    IF (Z2L_RARG == 3)
        PRINTS "This is a room which is bare on all sides. There is an exit down in the northwest corner of the room. To the east is a great "
        IF Z2_ATTR:(O_RIDDLE_DOOR):(F_OPENBIT)
            PRINTS "open"
        ELSE
            PRINTS "closed"
        ENDIF
        PRINTS " door made of stone. Above the stone, the following words are written: \"No man shall pass this door without solving this riddle:"
        PRINTL
        PRINTL
        PRINTS "  What is tall as a house,"
        PRINTL
        PRINTS "    round as a cup,"
        PRINTL
        PRINTS "      and all the king's horses"
        PRINTL
        PRINTS "        can't draw it up?\""
        PRINTL
        RETURN 1
    ELSEIF (Z2L_RARG == 1)
        IF (Z2_PRSA == V_ANSWER || Z2_PRSA == V_SAY)
            IF Z2_ATTR:(O_RIDDLE_DOOR):(F_OPENBIT)
                RETURN 0
            ELSEIF (((Z2_LEXV_AT(Z2_P_CONT, 0) == 656)) || ((Z2_LEXV_AT(Z2_P_CONT, 2) == 656)))
                PRINTS "There is a deafening clap of thunder and the stone door quietly swings open to reveal a passageway beyond."
                PRINTL
                CALL Z2R_SCORE_UPD, 5
                Z2T_1 = RESULT
                Z2_ATTR:(O_RIDDLE_DOOR):(F_OPENBIT) = 1
            ELSE
                PRINTS "A hollow laugh seems to come from the stone door."
                PRINTL
            ENDIF
            Z2_P_CONT = 0
            Z2_QUOTE_FLAG = 0
            RETURN 1
        ENDIF
        RETURN 0
    ENDIF
    RETURN 0

; 2actions.zil:2043 ROUTINE RIDDLE-DOOR-FCN
@Z2R_RIDDLE_DOOR_FCN
    IF (Z2_PRSA == V_OPEN)
        IF Z2_ATTR:(O_RIDDLE_DOOR):(F_OPENBIT)
            PRINTS "It is open!"
            PRINTL
            RETURN 1
        ELSE
            PRINTS "The door can only be opened by answering the riddle."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF (Z2_PRSA == V_CLOSE)
        IF Z2_ATTR:(O_RIDDLE_DOOR):(F_OPENBIT)
            PRINTS "Not a chance. The door weighs many tons."
            PRINTL
            RETURN 1
        ELSE
            PRINTS "It is closed!"
            PRINTL
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:2061 ROUTINE RIDDLE-PSEUDO
@Z2R_RIDDLE_PSEUDO
    IF (Z2_PRSA == V_EXAMINE)
        PRINTS "Use the \"Look\" command."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:2065 ROUTINE MAGIC-ACTOR
@Z2R_MAGIC_ACTOR
#DIM DYNAMIC Z2L_V
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
#DIM DYNAMIC Z2T_6
#DIM DYNAMIC Z2T_7
#DIM DYNAMIC Z2T_8
#DIM DYNAMIC Z2T_9
#DIM DYNAMIC Z2T_10
#DIM DYNAMIC Z2T_11
    IF Z2_SPELL
        IF (Z2_SPELL == 6)
            IF (((Z2_PRSA == V_CLIMB_UP || Z2_PRSA == V_CLIMB_DOWN || Z2_PRSA == V_CROSS)) || ((((Z2_PRSA == V_WALK)) && (Z2_GETPT(Z2_HERE, 22)))))
                Z2L_V = Z2_GETPT(Z2_HERE, 12)
                IF Z2_ZMEMQB(O_BRIDGE, Z2L_V, Z2_PTSIZE(Z2L_V))
                    CALL Z2R_JIGS_UP, "You find yourself drawn toward the edge of the bridge. You peer over the side. Oops, that was clumsy of you! You tripped on something and fell in. Too bad."
                    Z2T_1 = RESULT
                    RETURN Z2T_1
                ELSEIF (25 > Z2_RANDOM(100))
                    CALL Z2R_JIGS_UP, "For some odd reason you have tripped on your own feet, or perhaps an invisible cord stretched across the path. The resulting fall seems to have done you in."
                    Z2T_2 = RESULT
                    RETURN Z2T_2
                ELSE
                    PRINTS "You just tripped on an invisible cord, or perhaps your own feet. But this must be your lucky day, as you managed to regain your balance before what could have been a fatal fall."
                    PRINTL
                    RETURN 1
                ENDIF
            ELSEIF (Z2_PRSA == V_BOARD)
                PRINTS "You get in the "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS " but you fall out again, almost as though an invisible hand had tipped it over."
                PRINTL
                RETURN 1
            ENDIF
            RETURN 0
        ELSEIF (Z2_SPELL == 9)
            IF (Z2_PRSA == V_DIAGNOSE || Z2_PRSA == V_WAIT)
                RETURN 0
            ELSEIF (Z2_PRSA == V_WALK)
                PRINTS "I suppose you plan to do that by flapping your arms?"
                PRINTL
                RETURN 1
            ELSEIF (Z2_PRSA == V_DROP)
                CALL Z2_MOVE, Z2_PRSO, Z2_HERE
                PRINTS "The "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS " drops to the ground."
                PRINTL
                RETURN 1
            ELSEIF (((Z2_PRSA == V_TAKE)) && ((Z2_PARENT:(Z2_PRSO) == Z2_HERE)))
                PRINTS "You can't reach that! It's on the ground."
                PRINTL
                RETURN 1
            ENDIF
            RETURN 0
        ELSEIF (Z2_SPELL == 5)
            IF (Z2_PRSA == V_DIAGNOSE || Z2_PRSA == V_WAIT)
                RETURN 0
            ELSE
                PRINTS "You are frozen solid. You might as well wait it out, because you can't do anything else in this state."
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (((Z2_SPELL == 11)) && ((Z2_PRSA == V_WALK)))
            PRINTS "An invisible fence of magical force bars your way."
            PRINTL
            RETURN 1
        ELSE
            Z2T_4 = 1
            Z2T_4 = ((Z2_SPELL == 8)) != 0
            IF Z2T_4
                CALL Z2R_INFESTEDQ, Z2_HERE
                Z2T_5 = RESULT
                Z2L_V = Z2T_5
                Z2T_4 = (Z2L_V) != 0
            ENDIF
            IF Z2T_4
                IF (Z2_PRSA == V_ATTACK || Z2_PRSA == V_MUNG)
                    RETURN 0
                ELSE
                    CALL Z2R_FORCE_FIGHT, Z2L_V
                    Z2T_6 = RESULT
                    RETURN 1
                ENDIF
            ELSEIF (((Z2_SPELL == 7)) && ((Z2_PRSA == V_WALK)) && ((Z2_PARENT:(Z2_WINNER) == Z2_HERE)))
                PRINTS "Oops, you seem a little unsteady... I'm not sure you got where you intended going."
                PRINTL
                PRINTL
                CALL Z2R_RANDOM_WALK
                Z2T_7 = RESULT
                RETURN Z2T_7
            ELSE
                Z2T_9 = 1
                Z2T_9 = ((Z2_SPELL == 3)) != 0
                IF Z2T_9
                    CALL Z2R_INFESTEDQ, Z2_HERE
                    Z2T_10 = RESULT
                    Z2L_V = Z2T_10
                    Z2T_9 = (Z2L_V) != 0
                ENDIF
                IF Z2T_9
                    PRINTS "All at once, you are overcome by fear! There's is a "
                    PRINTS Z2_NAME:(Z2L_V)
                    PRINTS " in here! Maybe it's after you! "
                    IF Z2_ATTR:(Z2_PARENT:(Z2_WINNER)):(F_VEHBIT)
                        PRINTS "You huddle in the corner, terrified."
                        PRINTL
                        RETURN 1
                    ELSE
                        PRINTS "You run from the room screaming in terror!"
                        PRINTL
                        PRINTL
                        CALL Z2R_RANDOM_WALK
                        Z2T_11 = RESULT
                        RETURN Z2T_11
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
        RETURN 0
    ENDIF
    RETURN 0

; 2actions.zil:2139 ROUTINE RANDOM-WALK
@Z2R_RANDOM_WALK
#DIM DYNAMIC Z2L_P
#DIM DYNAMIC Z2L_TX
#DIM DYNAMIC Z2L_L
#DIM DYNAMIC Z2L_S
#DIM DYNAMIC Z2L_D
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    Z2L_D = 0
    Z2L_P = 0
    Z2T_1 = 0
    WHILE 1
        Z2L_P = Z2_NEXTP(Z2_HERE, Z2L_P)
        IF (Z2L_P < 18)
            IF Z2L_D
                Z2L_S = Z2_SPELL
                Z2_SPELL = 0
                Z2_WINNER = O_ADVENTURER
                CALL Z2_MOVE, Z2_WINNER, Z2_HERE
                CALL Z2R_DO_WALK, Z2L_D
                Z2T_2 = RESULT
                Z2_SPELL = Z2L_S
            ENDIF
            Z2T_1 = 1
            BREAK
        ELSE
            Z2L_TX = Z2_GETPT(Z2_HERE, Z2L_P)
            Z2L_L = Z2_PTSIZE(Z2L_TX)
            IF (((Z2L_L == 1)) || ((((Z2L_L == 4)) && (Z2_GLOBAL:(Z2_PT_GETB(Z2L_TX, 1))))) || ((((Z2L_L == 5)) && (Z2_ATTR:(Z2_PT_GETB(Z2L_TX, 1)):(F_OPENBIT)))))
                IF !(Z2L_D)
                    Z2L_D = Z2L_P
                ELSEIF (50 > Z2_RANDOM(100))
                    Z2L_D = Z2L_P
                ENDIF
            ENDIF
        ENDIF
    WEND
    RETURN Z2T_1

; 2actions.zil:2162 ROUTINE FORCE-FIGHT
@Z2R_FORCE_FIGHT(Z2L_V = 0)
#DIM DYNAMIC Z2L_V
#DIM DYNAMIC Z2L_W
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    CALL Z2R_FIND_IN, O_ADVENTURER, F_WEAPONBIT
    Z2T_1 = RESULT
    Z2L_W = Z2T_1
    IF !(Z2L_W)
        Z2L_W = O_HANDS
    ENDIF
    PRINTS "You are maddened by an overwhelming ferocity, and attack the "
    PRINTS Z2_NAME:(Z2L_V)
    PRINTS " instead."
    PRINTL
    CALL Z2_PERFORM, V_ATTACK, Z2L_V, Z2L_W
    Z2T_2 = RESULT
    RETURN Z2T_2

; 2actions.zil:2187 ROUTINE DWINDOW-DESC
@Z2R_DWINDOW_DESC
    PRINTS "On the floor is a very small diamond shaped window which is "
    IF Z2_GLOBAL:G_DIAMOND_SOLVE
        PRINTS "glowing serenely"
    ELSE
        PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_DWDESCS + 2 * Z2_GLOBAL:G_DIAMOND_COUNT)) & 65535)
    ENDIF
    PRINTS "."
    PRINTL
    RETURN 1

; 2actions.zil:2194 ROUTINE DWINDOW-FCN
@Z2R_DWINDOW_FCN
#DIM DYNAMIC Z2T_1
    IF (Z2_PRSA == V_TAKE)
        PRINTS "The window is an integral part of the floor."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_MUNG)
        PRINTS "The window is diamond-hard and cannot be broken."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_EXAMINE || Z2_PRSA == V_LOOK_INSIDE)
        CALL Z2R_DWINDOW_DESC
        Z2T_1 = RESULT
        RETURN Z2T_1
    ENDIF
    RETURN 0

; 2actions.zil:2204 ROUTINE DIAMOND-MOTION
@Z2R_DIAMOND_MOTION(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2L_DC
#DIM DYNAMIC Z2L_DIR
#DIM DYNAMIC Z2L_RM
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
#DIM DYNAMIC Z2T_6
#DIM DYNAMIC Z2T_7
    IF (Z2L_RARG == 3)
        PRINTS "This is a room with oddly angled walls and passages in all directions. The walls are made of some glassy substance."
        PRINTL
        IF (Z2_HERE == O_DIAMOND_5)
            PRINTS "A marble stairway leads upward."
            IF Z2_GLOBAL:G_DIAMOND_SOLVE
                PRINTS " The floor has swung down at the end of the stairway to reveal a secret passage leading down into unrelieved darkness."
            ENDIF
            PRINTL
        ELSE
            CALL Z2R_DWINDOW_DESC
            Z2T_1 = RESULT
        ENDIF
        RETURN 1
    ELSEIF (Z2L_RARG == 4)
        CALL Z2R_DWINDOW_DESC
        Z2T_2 = RESULT
        RETURN 1
    ELSEIF (((Z2L_RARG == 1)) && ((Z2_PRSA == V_WALK)) && (!(Z2_GLOBAL:G_DIAMOND_SOLVE)))
        IF (((Z2_HERE == O_DIAMOND_2 || Z2_HERE == O_DIAMOND_4)) || ((Z2_HERE == O_DIAMOND_6 || Z2_HERE == O_DIAMOND_8)))
            Z2L_DIR = Z2_GETW(Z2_GLOBAL:G_DIDIRS + 2 * (Z2_GLOBAL:G_DIAMOND_COUNT - 1))
            IF (Z2_PRSO == Z2L_DIR)
                Z2_GLOBAL:G_DIAMOND_COUNT = (Z2_GLOBAL:G_DIAMOND_COUNT + 1)
                IF (Z2_GLOBAL:G_DIAMOND_COUNT > Z2_GLOBAL:G_DIAMOND_BASE)
                    Z2_GLOBAL:G_DIAMOND_BASE = Z2_GLOBAL:G_DIAMOND_COUNT
                    Z2_GLOBAL:G_DIAMOND_MOVES = 0
                ENDIF
                IF (Z2_GLOBAL:G_DIAMOND_COUNT == 5)
                    PRINTS "You hear a strange rusty squeal echoing in the distance."
                    PRINTL
                    Z2_ATTR:(O_DIAMOND_5):(F_TOUCHBIT) = 0
                    CALL Z2R_SCORE_UPD, 5
                    Z2T_3 = RESULT
                    Z2_GLOBAL:G_DIAMOND_SOLVE = 1
                ENDIF
                IF (Z2_HERE == O_DIAMOND_2)
                    Z2L_DIR = O_DIAMOND_4
                ELSEIF (Z2_HERE == O_DIAMOND_4)
                    Z2L_DIR = O_DIAMOND_8
                ELSEIF (Z2_HERE == O_DIAMOND_8)
                    Z2L_DIR = O_DIAMOND_6
                ELSEIF (Z2_HERE == O_DIAMOND_6)
                    Z2L_DIR = O_DIAMOND_2
                ENDIF
                CALL Z2R_GOTO, Z2L_DIR
                Z2T_4 = RESULT
            ELSE
                CALL Z2R_DIAMOND_LOSS
                Z2T_5 = RESULT
            ENDIF
            RETURN 1
        ELSEIF (((Z2_HERE == O_DIAMOND_5)) && ((Z2_PRSO == 23)))
            RETURN 0
        ELSE
            Z2_GLOBAL:G_DIAMOND_COUNT = 0
            IF (33 > Z2_RANDOM(100))
                PRINTS "There is no way to go in that direction."
                PRINTL
                RETURN 1
            ELSEIF (25 > Z2_RANDOM(100))
                CALL Z2R_DIAMOND_LOSS
                Z2T_6 = RESULT
                RETURN 1
            ELSE
                Z2_GLOBAL:G_DIAMOND_COUNT = 1
                IF (Z2_GLOBAL:G_DIAMOND_COUNT > Z2_GLOBAL:G_DIAMOND_BASE)
                    Z2_GLOBAL:G_DIAMOND_BASE = Z2_GLOBAL:G_DIAMOND_COUNT
                    Z2_GLOBAL:G_DIAMOND_MOVES = 0
                ENDIF
                Z2L_RM = Z2_GETW(Z2_GLOBAL:G_DIAMOND_ROOMS + 2 * (Z2_RANDOM(4) - 1))
                IF Z2_ATTR:(O_BAT):(F_INVISIBLE)
                    Z2_ATTR:(O_BAT):(F_INVISIBLE) = 0
                    CALL Z2_MOVE, O_BAT, Z2L_RM
                ENDIF
                CALL Z2R_GOTO, Z2L_RM
                Z2T_7 = RESULT
                RETURN 1
            ENDIF
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:2274 ROUTINE DIAMOND-LOSS
@Z2R_DIAMOND_LOSS
#DIM DYNAMIC Z2T_1
    Z2_GLOBAL:G_DIAMOND_MOVES = (Z2_GLOBAL:G_DIAMOND_MOVES + 1)
    IF (Z2_GLOBAL:G_DIAMOND_MOVES == 20)
        PRINTS "As you thrash about in the maze, the mirthful voice of the Wizard taunts you: \"Fool! You'll never get past "
        PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_BASES + 2 * Z2_GLOBAL:G_DIAMOND_BASE)) & 65535)
        PRINTS " base at this rate!\""
        PRINTL
    ENDIF
    CALL Z2R_GOTO, Z2_GETW(Z2_GLOBAL:G_DIAMOND_ROOMS + 2 * (3 + Z2_RANDOM(5)))
    Z2T_1 = RESULT
    RETURN Z2T_1

; 2actions.zil:2298 ROUTINE CERBERUS-FCN
@Z2R_CERBERUS_FCN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
    IF (((Z2_PRSA == V_WAVE || Z2_PRSA == V_RUB || Z2_PRSA == V_RAISE)) && ((Z2_PRSO == O_WAND)))
        PRINTS "The dog looks puzzled."
        PRINTL
        RETURN 0
    ELSEIF ((Z2_GLOBAL:G_WAND_ON) && ((Z2_PRSA == V_SAY || Z2_PRSA == V_INCANT)))
        RETURN 0
    ELSE
        CALL Z2R_HELLOQ, O_CERBERUS
        Z2T_1 = RESULT
        IF Z2T_1
            IF Z2_GLOBAL:G_CERBERUS_LEASHED
                PRINTS "\"Arf! Arf! Arf!\""
                PRINTL
                RETURN 1
            ELSE
                PRINTS "\"Grrrr!\""
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (Z2_PRSA == V_ATTACK || Z2_PRSA == V_MUNG || Z2_PRSA == V_STAB)
            IF Z2_GLOBAL:G_CERBERUS_LEASHED
                CALL Z2_REMOVE, O_CERBERUS
                PRINTS "With a quiet bark of disappointment, the creature expires. Its six eyes look at you reproachfully. As it dies, it collapses into a small pile of dust which blows away into nothing."
                PRINTL
                RETURN 1
            ELSEIF (50 > Z2_RANDOM(100))
                CALL Z2R_JIGS_UP, "The dog-thing snaps at you viciously, and succeeds. Your head, it seems, is only a small mouthful for the poor animal, who is just as hungry afterward."
                Z2T_2 = RESULT
                RETURN Z2T_2
            ELSE
                PRINTS "The maddened dog-thing snaps viciously at you."
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (((Z2_PRSA == V_PUT || Z2_PRSA == V_PUT_ON)) && ((Z2_PRSO == O_COLLAR)))
            CALL Z2_MOVE, O_COLLAR, O_CERBERUS
            Z2_ATTR:(O_COLLAR):(F_NDESCBIT) = 1
            Z2_ATTR:(O_COLLAR):(F_TRYTAKEBIT) = 1
            Z2_LDESC:(O_CERBERUS) '= "An insipidly grinning three-headed dog is wagging its tail here. It is wearing a huge dog collar."
            Z2_GLOBAL:G_CERBERUS_LEASHED = 1
            PRINTS "The creature whines happily, then the center head licks your face (which is roughly like experiencing a sandpaper washcloth). The other two heads look about, as though the monster felt a sudden need to find a pair of slippers somewhere. Its huge tail wags enthusiastically, knocking small rocks around and almost blowing you over from the breeze it creates."
            PRINTL
            RETURN 1
        ELSEIF (Z2_PRSA == V_ENCHANT)
            IF (Z2_GLOBAL:G_SPELL_USED == 213)
                Z2_GLOBAL:G_SPELL_HANDLEDQ = 1
                PRINTS "The huge dog rises about an inch off the ground, for a moment."
                PRINTL
                RETURN 1
            ELSEIF (Z2_GLOBAL:G_SPELL_USED == 203)
                Z2_GLOBAL:G_SPELL_HANDLEDQ = 1
                CALL Z2R_JIGS_UP, "Cerberus tears you limb from limb! What ferocity!"
                Z2T_3 = RESULT
                RETURN Z2T_3
            ELSEIF (Z2_GLOBAL:G_SPELL_USED == 198)
                PRINTS "What an effect! He now has the strength of just one elephant, rather than ten!"
                PRINTL
                RETURN 1
            ENDIF
            RETURN 0
        ELSEIF !(Z2_GLOBAL:G_CERBERUS_LEASHED)
            PRINTS "The three-headed dog snaps at you viciously!"
            PRINTL
            RETURN 1
        ELSEIF ((Z2_GLOBAL:G_CERBERUS_LEASHED) && ((Z2_PRSA == V_RUB)))
            PRINTS "The dog is now insanely happy, slobbering all over the place and whining with uncontained doggish joy."
            PRINTL
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:2356 ROUTINE COLLAR-FCN
@Z2R_COLLAR_FCN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (((Z2_PRSA == V_TAKE)) && (Z2_GLOBAL:G_CERBERUS_LEASHED))
        CALL Z2R_JIGS_UP, "That wasn't such a good idea. The creature was enjoying being your pet. As you unfasten the collar, the disappointed monster hound begins to growl, and then its three fang-crammed mouths rend you into little doggy biscuits."
        Z2T_1 = RESULT
        RETURN Z2T_1
    ELSEIF (((Z2_PRSA == V_ENCHANT)) && ((Z2_GLOBAL:G_SPELL_USED == 213)))
        CALL Z2_PERFORM, V_ENCHANT, O_CERBERUS
        Z2T_2 = RESULT
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:2372 ROUTINE GLACIER-FCN
@Z2R_GLACIER_FCN
    IF (Z2_PRSA == V_MELT)
        PRINTS "This is a big glacier; you'll need a lot of heat."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:2377 ROUTINE GLACIER-ROOM-FCN
@Z2R_GLACIER_ROOM_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
    IF (Z2L_RARG == 3)
        PRINTS "This is a large hall of ancient lava, since worn smooth by the movement of a glacier. A large passage exits to the east and an upward lava tube is at the top of a jumble of fallen rocks."
        PRINTL
        IF Z2_GLOBAL:G_ICE_MELTED
            PRINTS "A damp and scorched passage leads west. It is still partly full of steam."
            PRINTL
        ENDIF
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:2389 ROUTINE DRAGON-FCN
@Z2R_DRAGON_FCN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    CALL Z2_QUEUE, INT_DRAGON, -1, 1
    CALL Z2R_HELLOQ, O_DRAGON
    Z2T_1 = RESULT
    IF Z2T_1
        PRINTS "The dragon looks amused. He speaks in a voice so deep you feel it rather than hear it, but the tongue is unknown to you. You find yourself almost hypnotized."
        PRINTL
        Z2_DRAGON_ANGER = (Z2_DRAGON_ANGER + 2)
        RETURN Z2_DRAGON_ANGER
    ELSEIF (Z2_PRSA == V_EXAMINE)
        PRINTS "He turns and looks back at you, his cat's eyes yellow in the gloom. You start to feel weak, and quickly turn away."
        PRINTL
        Z2_DRAGON_ANGER = (Z2_DRAGON_ANGER + 1)
        RETURN Z2_DRAGON_ANGER
    ELSEIF (Z2_PRSA == V_ATTACK || Z2_PRSA == V_MUNG || Z2_PRSA == V_KICK || Z2_PRSA == V_LAMP_ON)
        IF (((Z2_PRSA == V_LAMP_ON)) || ((((Z2_PRSA == V_ATTACK)) && (!(Z2_PRSI)))))
            PRINTS "With your bare hands? I doubt the dragon even noticed."
            PRINTL
        ELSE
            PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_DRAGON_ATTACKS + 2 * Z2_RANDOM(Z2_GETW(Z2_GLOBAL:G_DRAGON_ATTACKS)))) & 65535)
            PRINTL
        ENDIF
        Z2_DRAGON_ANGER = (Z2_DRAGON_ANGER + 4)
        RETURN Z2_DRAGON_ANGER
    ELSEIF (((Z2_PRSA == V_GIVE)) && ((Z2_PRSI == O_DRAGON)))
        Z2_DRAGON_ANGER = (Z2_DRAGON_ANGER + 1)
        IF Z2_GETPT(Z2_PRSO, 8)
            CALL Z2_MOVE, Z2_PRSO, O_CHEST
            PRINTS "The dragon is pleased by your gift, excuses himself for a moment, and returns without it."
            PRINTL
            RETURN 1
        ELSE
            CALL Z2R_BOMBQ, Z2_PRSO
            Z2T_2 = RESULT
            IF Z2T_2
                Z2_DRAGON_ANGER = (Z2_DRAGON_ANGER + 2)
                CALL Z2_REMOVE, O_BRICK
                PRINTS "The dragon snakes his long red tongue around the bomb and politely swallows it. A few moments later he belches and smoke curls out of his nostrils."
                PRINTL
                RETURN 1
            ELSE
                PRINTS "The dragon refuses your gift."
                PRINTL
                RETURN 1
            ENDIF
        ENDIF
    ELSEIF (((Z2_PRSA == V_WALK)) && ((Z2_HERE == O_DRAGON_ROOM)) && ((Z2_PRSO == 31)))
        Z2_DRAGON_ANGER = (Z2_DRAGON_ANGER + 3)
        PRINTS "The dragon puts out a claw, grins (all of his sword-sharp teeth glinting in the light), and blocks your way."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:2446 ROUTINE HELLO?
@Z2R_HELLOQ(Z2L_WHO = 0)
#DIM DYNAMIC Z2L_WHO
    IF (((Z2_WINNER == Z2L_WHO)) || ((Z2_PRSA == V_TELL || Z2_PRSA == V_ANSWER || Z2_PRSA == V_REPLY || Z2_PRSA == V_SAY || Z2_PRSA == V_HELLO || Z2_PRSA == V_INCANT)))
        IF (Z2_PRSA == V_TELL || Z2_PRSA == V_ANSWER || Z2_PRSA == V_SAY || Z2_PRSA == V_INCANT || Z2_PRSA == V_REPLY)
            Z2_P_CONT = 0
            Z2_QUOTE_FLAG = 0
        ENDIF
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:2454 ROUTINE FIND-TARGET
@Z2R_FIND_TARGET(Z2L_TARGET = 0)
#DIM DYNAMIC Z2L_TARGET
#DIM DYNAMIC Z2L_P
#DIM DYNAMIC Z2L_TX
#DIM DYNAMIC Z2L_L
#DIM DYNAMIC Z2L_ROOM
#DIM DYNAMIC Z2T_1
    IF (Z2_PARENT:(Z2L_TARGET) == Z2_HERE)
        RETURN Z2_HERE
    ELSE
        Z2L_P = 0
        Z2T_1 = 0
        WHILE 1
            Z2L_P = Z2_NEXTP(Z2_HERE, Z2L_P)
            IF (Z2L_P == 0)
                Z2T_1 = 0
                BREAK
            ELSEIF !((Z2L_P < 18))
                Z2L_TX = Z2_GETPT(Z2_HERE, Z2L_P)
                Z2L_L = Z2_PTSIZE(Z2L_TX)
                IF (Z2L_L == 1 || Z2L_L == 4 || Z2L_L == 5)
                    Z2L_ROOM = Z2_PT_GETB(Z2L_TX, 0)
                    IF (Z2_PARENT:(Z2L_TARGET) == Z2L_ROOM)
                        Z2T_1 = Z2L_ROOM
                        BREAK
                    ENDIF
                ENDIF
            ENDIF
        WEND
        RETURN Z2T_1
    ENDIF

; 2actions.zil:2471 ROUTINE I-DRAGON
@Z2R_I_DRAGON
#DIM DYNAMIC Z2L_ROOM
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
#DIM DYNAMIC Z2T_6
#DIM DYNAMIC Z2T_7
#DIM DYNAMIC Z2T_8
#DIM DYNAMIC Z2T_9
    IF (Z2_DRAGON_ANGER > 6)
        PRINTS "The dragon tires of this game. With an almost bored yawn, he opens his mouth and "
        IF (Z2_SPELL == 10)
            PRINTS "blasts you with a great gout of fire, but it washes over you harmlessly."
            PRINTL
        ELSE
            CALL Z2R_DRAGON_LEAVES
            Z2T_1 = RESULT
            CALL Z2R_JIGS_UP, "incinerates you in a blast of white-hot dragon fire."
            Z2T_2 = RESULT
        ENDIF
    ELSEIF (((Z2_PARENT:(Z2_WINNER) == O_DRAGON_ROOM)) && (!((Z2_PARENT:(O_DRAGON) == O_DRAGON_ROOM))))
        CALL Z2_MOVE, O_DRAGON, O_DRAGON_ROOM
        PRINTS "The dragon doubles back and charges into the room, maddened by your attempt to sneak past him. His eyes glow with a white heat of anger."
        PRINTL
        IF (Z2_SPELL == 10)
            CALL Z2R_JIGS_UP, "A huge ball of flame envelops you, but you don't even feel the heat. The dragon is puzzled, but not too puzzled to crush you in his jaws."
            Z2T_3 = RESULT
        ELSE
            CALL Z2R_JIGS_UP, "Worse for you, his mouth opens and a great gout of flame puffs out and consumes you on the spot."
            Z2T_4 = RESULT
        ENDIF
    ELSEIF !((Z2_DRAGON_ANGER > 0))
        IF (((50 > Z2_RANDOM(100))) && ((Z2_PARENT:(O_DRAGON) == Z2_HERE)))
            PRINTS "The dragon looks bored."
            PRINTL
        ELSE
            CALL Z2R_DRAGON_LEAVES
            Z2T_5 = RESULT
            IF (Z2_HERE == O_GLACIER_ROOM)
                PRINTS "The dragon is no longer around. He must have become bored with you."
                PRINTL
            ELSEIF (Z2_HERE == Z2_GLOBAL:G_OLD_HERE)
                PRINTS "The dragon seems to have lost interest in you."
                IF (Z2_GLOBAL:G_OLD_HERE == O_DRAGON_ROOM)
                    PRINTL
                ELSE
                    PRINTS " He wanders off."
                    PRINTL
                ENDIF
            ENDIF
        ENDIF
    ELSE
        CALL Z2R_FIND_TARGET, Z2_WINNER
        Z2T_6 = RESULT
        Z2L_ROOM = Z2T_6
        IF !(Z2L_ROOM)
            IF (25 > Z2_RANDOM(100))
                CALL Z2R_DRAGON_LEAVES
                Z2T_7 = RESULT
            ENDIF
        ELSEIF (((Z2L_ROOM == O_CAROUSEL_ROOM || Z2L_ROOM == O_TINY_ROOM)) || ((Z2L_ROOM == O_RAVINE_LEDGE || Z2L_ROOM == O_FRESCO_ROOM)))
            IF (25 > Z2_RANDOM(100))
                CALL Z2R_DRAGON_LEAVES
                Z2T_8 = RESULT
            ENDIF
            PRINTS "The dragon will follow no further."
            PRINTL
        ELSEIF (Z2L_ROOM == O_GLACIER_ROOM)
            PRINTL
            PRINTS "As the dragon enters, he sees his reflection on the icy surface of the glacier at its western end. He becomes enraged: There is another dragon here, behind that glass, he thinks! Dragons are smart, but sometimes naive, and this one has never seen ice before. He rears up to his full height to challenge this intruder into his territory. He roars a challenge! The intruder responds! The dragon takes a deep breath, and out of his mouth pours a massive gout of flame. It washes over the ice, which melts rapidly, sending out torrents of water and a huge cloud of steam! You manage to clamber up to a small shelf, but the dragon is terrified! A huge splash goes down his throat! There is a muffled explosion and the dragon, a puzzled expression on his face, dies. He is carried away by the water."
            PRINTL
            PRINTL
            PRINTS "When the flood recedes you climb gingerly down. While no trace of the dragon can be found, the melting of the ice has revealed a passage leading west."
            PRINTL
            CALL Z2_REMOVE, O_DRAGON
            CALL Z2_REMOVE, O_ICE
            CALL Z2_MOVE, O_DEAD_DRAGON, O_DEEP_FORD
            CALL Z2_ENABLE, INT_DRAGON, 0
            CALL Z2R_SCORE_UPD, 5
            Z2T_9 = RESULT
            Z2_GLOBAL:G_ICE_MELTED = 1
        ELSE
            IF !((Z2L_ROOM == Z2_GLOBAL:G_OLD_HERE))
                CALL Z2_MOVE, O_DRAGON, Z2L_ROOM
                PRINTS "The dragon follows you, out of mingled curiosity and anger."
                PRINTL
            ELSE
                PRINTS "The dragon continues to watch you carefully."
                PRINTL
            ENDIF
            IF !((Z2_DRAGON_ANGER > 0))
                Z2_DRAGON_ANGER = 0
                CALL Z2_ENABLE, INT_DRAGON, 0
            ENDIF
        ENDIF
    ENDIF
    Z2_GLOBAL:G_OLD_HERE = Z2_PARENT:(O_DRAGON)
    Z2_DRAGON_ANGER = (Z2_DRAGON_ANGER - 2)
    IF (Z2_DRAGON_ANGER < 0)
        Z2_DRAGON_ANGER = 0
    ENDIF
    RETURN 1

; 2actions.zil:2559 ROUTINE DRAGON-LEAVES
@Z2R_DRAGON_LEAVES
    IF !(Z2_PARENT:(O_DEAD_DRAGON))
        CALL Z2_MOVE, O_DRAGON, O_DRAGON_ROOM
        Z2_DRAGON_ANGER = 0
        CALL Z2_ENABLE, INT_DRAGON, 0
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:2565 ROUTINE I-GARDEN
@Z2R_I_GARDEN
#DIM DYNAMIC Z2T_1
    IF (((Z2_HERE == O_GARDEN_NORTH || Z2_HERE == O_GAZEBO_ROOM)) || ((Z2_HERE == O_TOPIARY_ROOM || Z2_HERE == O_FORMAL_GARDEN)))
        IF (((Z2_PARENT:(O_UNICORN) == O_GARDEN_NORTH)) && ((33 > Z2_RANDOM(100))))
            CALL Z2_REMOVE, O_UNICORN
            IF !((Z2_HERE == O_TOPIARY_ROOM))
                PRINTS "The unicorn bounds lightly away."
                PRINTL
                RETURN 1
            ENDIF
            RETURN 0
        ELSEIF (((Z2_PARENT:(O_PRINCESS) == O_DRAGON_LAIR)) && (!((Z2_PARENT:(O_UNICORN) == O_GARDEN_NORTH))) && ((25 > Z2_RANDOM(100))) && (!((Z2_HERE == O_TOPIARY_ROOM))))
            IF Z2_GLOBAL:G_UNICORN_FRIGHTENED
                Z2_GLOBAL:G_UNICORN_FRIGHTENED = 0
                RETURN 0
            ENDIF
            CALL Z2_MOVE, O_UNICORN, O_GARDEN_NORTH
            IF (Z2_HERE == O_GARDEN_NORTH)
                PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_UNICORN_MSGS + 2 * Z2_RANDOM(Z2_GETW(Z2_GLOBAL:G_UNICORN_MSGS)))) & 65535)
                PRINTL
                RETURN 1
            ELSE
                PRINTS "A unicorn is peacefully cropping grass at the north end of the garden. There is something hanging around its neck."
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (Z2_HERE == O_TOPIARY_ROOM)
            IF ((!(Z2_GLOBAL:G_TOPIARY_MOVED)) && ((12 > Z2_RANDOM(100))))
                Z2_GLOBAL:G_TOPIARY_MOVED = 1
                PRINTS "You look around, and strangely, the topiary animals seem to have changed position slightly."
                PRINTL
                RETURN 1
            ELSEIF ((Z2_GLOBAL:G_TOPIARY_MOVED) && (!(Z2_GLOBAL:G_TOPIARY_NEAR)) && ((8 > Z2_RANDOM(100))))
                Z2_GLOBAL:G_TOPIARY_NEAR = 1
                PRINTS "The topiary animals seem to close in on you. You turn and they are very close. They seem to be leering at you."
                PRINTL
                RETURN 1
            ELSEIF ((Z2_GLOBAL:G_TOPIARY_NEAR) && ((4 > Z2_RANDOM(100))))
                Z2_GLOBAL:G_TOPIARY_MOVED = 0
                Z2_GLOBAL:G_TOPIARY_NEAR = 0
                CALL Z2R_JIGS_UP, "The topiary animals attack! You are crushed by their branches and clawed by their thorns."
                Z2T_1 = RESULT
                RETURN Z2T_1
            ENDIF
            RETURN 0
        ENDIF
        RETURN 0
    ELSE
        CALL Z2_REMOVE, O_UNICORN
        CALL Z2_ENABLE, INT_GARDEN, 0
        RETURN 0
    ENDIF

; 2actions.zil:2622 ROUTINE GARDEN-ROOM-FCN
@Z2R_GARDEN_ROOM_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
    IF (Z2L_RARG == 2)
        CALL Z2_QUEUE, INT_GARDEN, -1, 1
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:2626 ROUTINE GLOBAL-UNICORN-FCN
@Z2R_GLOBAL_UNICORN_FCN
    IF (Z2_PARENT:(O_UNICORN) == O_GARDEN_NORTH)
        PRINTS "The unicorn is way up at the north end of the garden."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_FIND || Z2_PRSA == V_FOLLOW)
        IF Z2_ATTR:(O_UNICORN):(F_TOUCHBIT)
            PRINTS "I don't know where it is now."
            PRINTL
            RETURN 1
        ELSE
            PRINTS "The unicorn is a mythical beast."
            PRINTL
            RETURN 1
        ENDIF
    ELSE
        PRINTS "Unicorn? What unicorn?"
        PRINTL
        RETURN 1
    ENDIF

; 2actions.zil:2639 ROUTINE UNICORN-FCN
@Z2R_UNICORN_FCN
#DIM DYNAMIC Z2T_1
    CALL Z2R_HELLOQ, O_UNICORN
    Z2T_1 = RESULT
    IF Z2T_1
        PRINTS "The unicorn listens distractedly, then goes back to cropping grass."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_FOLLOW)
        PRINTS "The unicorn shies away as you approach."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_EXAMINE)) && ((Z2_PRSO == O_UNICORN)))
        PRINTS "The unicorn shies away as you approach for a closer look, but you do notice a tiny gold key hanging from a red satin ribbon looped around the animal's neck."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_EXAMINE)
        PRINTS "The unicorn shies away as you approach."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_TAKE || Z2_PRSA == V_PUT || Z2_PRSA == V_RUB || Z2_PRSA == V_MUNG || Z2_PRSA == V_ATTACK)
        CALL Z2_REMOVE, O_UNICORN
        Z2_GLOBAL:G_UNICORN_FRIGHTENED = 1
        PRINTS "The unicorn, unsurprised by this evidence that you are indeed the uncouth sort of vagabond it suspected you were, melts into the hedges and is gone."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:2663 ROUTINE GAZEBO-FCN
@Z2R_GAZEBO_FCN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (((Z2_HERE == O_GARDEN_NORTH)) && ((Z2_PRSA == V_THROUGH)))
        CALL Z2R_DO_WALK, 21
        Z2T_1 = RESULT
        RETURN 1
    ELSEIF (((Z2_HERE == O_GAZEBO_ROOM)) && ((Z2_PRSA == V_THROUGH)))
        PRINTS "You're already in it."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_HERE == O_GAZEBO_ROOM)) && ((Z2_PRSA == V_LEAVE || Z2_PRSA == V_EXIT)))
        CALL Z2R_DO_WALK, 20
        Z2T_2 = RESULT
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:2672 ROUTINE CHEST-FCN
@Z2R_CHEST_FCN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2_PRSA == V_OPEN)
        IF (25 > Z2_RANDOM(100))
            CALL Z2R_V_OPEN
            Z2T_1 = RESULT
            IF (((Z2_PARENT:(O_PRINCESS) == Z2_HERE)) && (!(Z2_GLOBAL:G_PRINCESS_AWAKE)))
                PRINTS "The opening of the squeaky lid startles the young woman."
                PRINTL
            ENDIF
        ELSE
            PRINTS "The hinges are very rusty, but they seem to be starting to give. You can probably open it if you try again. There is something bumping around inside."
            IF (((Z2_PARENT:(O_PRINCESS) == Z2_HERE)) && (!(Z2_GLOBAL:G_PRINCESS_AWAKE)))
                PRINTS " All this rummaging around has startled the young woman."
            ENDIF
            PRINTL
        ENDIF
        Z2_ACTION_R:(O_CHEST) '= ""
        IF (((Z2_PARENT:(O_PRINCESS) == Z2_HERE)) && (!(Z2_GLOBAL:G_PRINCESS_AWAKE)))
            CALL Z2_PERFORM, V_ALARM, O_PRINCESS
            Z2T_2 = RESULT
        ENDIF
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:2699 ROUTINE PRINCESS-FCN
@Z2R_PRINCESS_FCN
#DIM DYNAMIC Z2L_DEM
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
    Z2L_DEM = Z2_INT(INT_PRINCESS)
    IF (Z2_PRSA == V_FOLLOW)
        IF (Z2_PARENT:(O_PRINCESS) == Z2_HERE)
            PRINTS "You can't follow her until she leaves..."
            PRINTL
        ELSEIF Z2_GLOBAL:G_PRFOLLOW
            CALL Z2R_DO_WALK, Z2_GLOBAL:G_PRFOLLOW
            Z2T_1 = RESULT
        ELSE
            PRINTS "I seem to have lost track of her."
            PRINTL
        ENDIF
        RETURN 1
    ELSEIF !((Z2_PARENT:(O_PRINCESS) == Z2_HERE))
        PRINTS "There is no princess here."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_ATTACK || Z2_PRSA == V_MUNG || Z2_PRSA == V_RAPE)
        CALL Z2_REMOVE, O_PRINCESS
        PRINTS "The princess screams as you approach. \"Won't someone deliver me from this awful fate?\" she cries. "
        IF (Z2_PARENT:(O_WIZARD) == Z2_HERE)
            PRINTS "Shocked, the Wizard of Frobozz turns toward you."
        ELSE
            PRINTS "Just in time, the Wizard of Frobozz appears, seeming to unroll himself out of nothing like a window shade."
        ENDIF
        PRINTS " \"Fry!\" he intones, and a massive bolt of lightning reduces you to a pile of smoking ashes. (Serves you right, too, if you ask me.)"
        CALL Z2R_JIGS_UP
        Z2T_2 = RESULT
        RETURN Z2T_2
    ELSE
        Z2T_4 = 0
        CALL Z2R_HELLOQ, O_PRINCESS
        Z2T_5 = RESULT
        Z2T_4 = (Z2T_5) != 0
        IF !Z2T_4
            Z2T_4 = ((Z2_PRSA == V_ALARM || Z2_PRSA == V_KISS || Z2_PRSA == V_EXAMINE || Z2_PRSA == V_RUB)) != 0
        ENDIF
        IF Z2T_4
            IF (((Z2_PARENT:(O_PRINCESS) == O_DRAGON_LAIR)) && ((Z2_CINT_ON:(Z2L_DEM) == 0)))
                Z2_LDESC:(O_PRINCESS) '= "There is a dishevelled and slightly unkempt princess here."
                CALL Z2_QUEUE, INT_PRINCESS, 2, 1
                Z2_GLOBAL:G_PRINCESS_AWAKE = 1
                PRINTS "The princess (for she is obviously one) shakes herself awake, then notices you for the first time. She smiles. \"Thank you for rescuing me from that horrid worm,\" she says. \"I must depart. My parents will be worried about me.\" With that, she arises, looking purposefully out of the lair."
                PRINTL
                RETURN 1
            ELSE
                PRINTS "The princess ignores you. She looks about the room, but her eyes fix on the "
                IF (Z2_HERE == O_GAZEBO_ROOM)
                    PRINTS "garden outside"
                ELSEIF (Z2_HERE == O_GARDEN_NORTH)
                    PRINTS "gazebo"
                ELSEIF (Z2_HERE == O_RAVINE_LEDGE)
                    PRINTS "ledge"
                ELSE
                    PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_PRDIRS + 2 * (Z2_GLOBAL:G_PRCOUNT * 4))) & 65535)
                ENDIF
                PRINTS "."
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF !(Z2_GLOBAL:G_PRINCESS_AWAKE)
            PRINTS "She's in a trance!"
            PRINTL
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:2770 ROUTINE I-PRINCESS
@Z2R_I_PRINCESS
#DIM DYNAMIC Z2L_DEM
#DIM DYNAMIC Z2L_OLDP
#DIM DYNAMIC Z2L_PC
#DIM DYNAMIC Z2T_1
    Z2L_DEM = Z2_INT(INT_PRINCESS)
    Z2L_OLDP = Z2_PARENT:(O_PRINCESS)
    Z2L_PC = (Z2_GLOBAL:G_PRCOUNT * 4)
    CALL Z2_MOVE, O_PRINCESS, Z2_GETW(Z2_GLOBAL:G_PRDIRS + 2 * (Z2L_PC + 1))
    Z2_GLOBAL:G_PRFOLLOW = 0
    IF (((Z2_PARENT:(O_PRINCESS) == O_STREAM_PATH)) && ((Z2_PARENT:(Z2_WINNER) == O_MARBLE_HALL)))
        PRINTS "The princess presses a loose piece of marble in the wall and a large section of the wall slides away, revealing a passage to the east. She enters it."
        PRINTL
        IF (Z2_PARENT:(Z2_WINNER) == Z2L_OLDP)
            Z2_GLOBAL:G_PRFOLLOW = Z2_GETW(Z2_GLOBAL:G_PRDIRS + 2 * (Z2L_PC + 3))
        ENDIF
        Z2_GLOBAL:G_SECRET_DOOR = 1
    ELSEIF (((Z2_PARENT:(O_PRINCESS) == O_STREAM_PATH)) && ((Z2_PARENT:(Z2_WINNER) == O_STREAM_PATH)))
        Z2_GLOBAL:G_SECRET_DOOR = 1
        PRINTS "The princess appears from behind some rocks, as though she had walked through a wall."
        PRINTL
    ELSEIF (Z2_PARENT:(Z2_WINNER) == Z2L_OLDP)
        Z2_GLOBAL:G_PRFOLLOW = Z2_GETW(Z2_GLOBAL:G_PRDIRS + 2 * (Z2L_PC + 3))
        IF (Z2L_OLDP == O_GARDEN_NORTH)
            PRINTS "The princess enters the gazebo"
            IF Z2_ATTR:(O_GAZEBO_ROOM):(F_RMUNGBIT)
                PRINTS ", although you would never get past the debris. She must be magically protected."
            ENDIF
            PRINTS "."
            PRINTL
        ELSEIF (Z2L_OLDP == O_RAVINE_LEDGE)
            PRINTS "The princess climbs daintily down the rock face."
            PRINTL
        ELSE
            PRINTS "The princess walks "
            PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_PRDIRS + 2 * Z2L_PC)) & 65535)
            PRINTS ". She glances back at you as she goes."
            PRINTL
        ENDIF
    ELSEIF (Z2_PARENT:(O_PRINCESS) == Z2_HERE)
        IF (Z2_HERE == O_GAZEBO_ROOM)
            PRINTS "The princess joins you in the gazebo."
            PRINTL
        ELSEIF (Z2_HERE == O_DEEP_FORD)
            PRINTS "The princess climbs down the rock wall onto the beach."
            PRINTL
        ELSE
            PRINTS "The princess enters from the "
            PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_PRDIRS + 2 * (2 + Z2L_PC))) & 65535)
            PRINTS ". She seems surprised to see you."
            PRINTL
        ENDIF
    ENDIF
    IF (Z2_PARENT:(O_PRINCESS) == O_GAZEBO_ROOM)
        Z2_CINT_ON:(Z2L_DEM) = 0
        CALL Z2_QUEUE, INT_UNICORN, 6, 1
    ELSE
        Z2_GLOBAL:G_PRCOUNT = (Z2_GLOBAL:G_PRCOUNT + 1)
        IF (75 > Z2_RANDOM(100))
            Z2T_1 = 1
        ELSE
            Z2T_1 = 2
        ENDIF
        CALL Z2_QUEUE, INT_PRINCESS, Z2T_1, 1
    ENDIF
    RETURN 1

; 2actions.zil:2822 ROUTINE I-UNICORN
@Z2R_I_UNICORN
#DIM DYNAMIC Z2T_1
    IF (Z2_HERE == O_GAZEBO_ROOM || Z2_HERE == O_GARDEN_NORTH)
        CALL Z2_MOVE, O_ROSE, Z2_WINNER
        Z2_ATTR:(O_GOLD_KEY):(F_NDESCBIT) = 0
        CALL Z2_MOVE, O_GOLD_KEY, Z2_WINNER
        CALL Z2R_SCORE_OBJ, O_GOLD_KEY
        Z2T_1 = RESULT
        Z2_ACTION_R:(O_GOLD_KEY) '= ""
        PRINTS "Shyly, a unicorn peeks out of the hedges. It notices the princess and seems captivated. It approaches her and bows its head as though curtseying to her. Around its neck is a red satin ribbon on which is strung a delicate gold key. The princess takes the ribbon and uses it to tie up her hair. She looks at you and then, smiling, hands you the key and a fresh rose which she plucks from the arbor. \"You may have use of such a thing,\" she says. \"It is the least I can do for one who rescued me from a fate I dare not contemplate.\" With that, she mounts the unicorn (side-saddle, of course) and rides off into the gloom."
        PRINTL
        CALL Z2_REMOVE, O_PRINCESS
        RETURN 1
    ELSE
        CALL Z2_REMOVE, O_PRINCESS
        CALL Z2_MOVE, O_ROSE, O_GAZEBO_ROOM
        RETURN 0
    ENDIF

; 2actions.zil:2849 ROUTINE MENHIR-ROOM-FCN
@Z2R_MENHIR_ROOM_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (((Z2L_RARG == 4)) && (Z2_GLOBAL:G_MENHIR_POSITION))
        CALL Z2R_DESCRIBE_MENHIR
        Z2T_1 = RESULT
        RETURN Z2T_1
    ELSEIF (Z2L_RARG == 3)
        PRINTS "This is a large room which was evidently used once as a quarry. Many large limestone chunks lie helter-skelter around the room. Some are rough-hewn and unworked, others smooth and well-finished. One side of the room appears to have been used to quarry building blocks, the other to produce menhirs (standing stones). Obvious passages lead north and south."
        PRINTL
        IF (Z2_PARENT:(O_MENHIR) == O_LOCAL_GLOBALS)
            CALL Z2R_DESCRIBE_MENHIR
            Z2T_2 = RESULT
        ENDIF
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:2864 ROUTINE DESCRIBE-MENHIR
@Z2R_DESCRIBE_MENHIR
    IF (Z2_HERE == O_MENHIR_ROOM)
        IF (Z2_GLOBAL:G_MENHIR_POSITION == 0)
            PRINTS "One particularly large menhir, at least twenty feet tall and eight feet thick, is leaning against the wall blocking a dark opening leading southwest. On this side of the menhir is carved an ornate letter \"F\"."
            PRINTL
        ELSEIF (Z2_GLOBAL:G_MENHIR_POSITION == 1)
            PRINTS "There is a huge menhir lying on the floor near a southwest passage."
            PRINTL
        ELSEIF (Z2_GLOBAL:G_MENHIR_POSITION == 2)
            PRINTS "A dark opening leads southwest."
            PRINTL
        ELSEIF (Z2_GLOBAL:G_MENHIR_POSITION == 3)
            PRINTS "There is a huge menhir here."
            PRINTL
        ELSE
            PRINTS "There is a huge menhir floating like a feather in midair here. A passage to the southwest opens beneath it."
            PRINTL
        ENDIF
        IF (Z2_HERE == Z2_GLOBAL:G_MUNGED_ROOM)
            PRINTS "The explosion appears to have had no effect on the menhir."
            PRINTL
        ENDIF
        RETURN 1
    ELSE
        PRINTS "A dark opening leads southwest."
        PRINTL
        RETURN 1
    ENDIF

; 2actions.zil:2891 ROUTINE MENHIR-FCN
@Z2R_MENHIR_FCN
    IF (Z2_PRSA == V_LOOK_UNDER || Z2_PRSA == V_LOOK_BEHIND)
        IF Z2_GLOBAL:G_MENHIR_POSITION
            PRINTS "Behind the menhir is some air and then a wall."
            PRINTL
            RETURN 1
        ELSE
            PRINTS "The gap between the menhir and the wall is very narrow, but it is clear that there is a sizeable room in there. Your light only reveals a part of the far wall."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF (Z2_PRSA == V_TAKE || Z2_PRSA == V_MOVE || Z2_PRSA == V_TURN)
        PRINTS "The menhir weighs many tons and is eight feet wide. You can't even get a grip on it, much less move it."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_READ)
        PRINTS "\"F\""
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_EXAMINE)
        PRINTS "It is nicely finished, and the letter \"F\" on it is particularly well carved."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_ENCHANT)) && ((Z2_GLOBAL:G_SPELL_USED == 213)))
        PRINTS "The menhir floats majestically into the air, rising about ten feet. The passage beneath it beckons invitingly."
        PRINTL
        Z2_GLOBAL:G_MENHIR_POSITION = 3
        RETURN Z2_GLOBAL:G_MENHIR_POSITION
    ELSEIF (((Z2_PRSA == V_DISENCHANT)) && ((Z2_GLOBAL:G_SPELL_USED == 213)))
        Z2_GLOBAL:G_MENHIR_POSITION = 0
        IF (Z2_HERE == O_MENHIR_ROOM || Z2_HERE == O_KENNEL)
            PRINTS "The menhir sinks to the ground."
            PRINTL
            RETURN 1
        ENDIF
        RETURN 0
    ENDIF
    RETURN 0

; 2actions.zil:2924 ROUTINE DOOR-KEEPER-FCN
@Z2R_DOOR_KEEPER_FCN
#DIM DYNAMIC Z2T_1
    IF (((Z2_PRSA == V_ALARM)) && (Z2_GLOBAL:G_GUARDIAN_FED))
        PRINTS "Try as you may, you can't wake it."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_GIVE)) && ((Z2_PRSI == O_DOOR_KEEPER)))
        IF Z2_GLOBAL:G_GUARDIAN_FED
            PRINTS "He is asleep, at least for the moment."
            PRINTL
            RETURN 1
        ELSEIF (Z2_PRSO == O_CANDY)
            Z2_GLOBAL:G_GUARDIAN_FED = 1
            CALL Z2_REMOVE, O_CANDY
            PRINTS "The guardian greedily wolfs down the candy, including the package. (It seemed to enjoy the grasshoppers particularly.) It then becomes quiet and its eyes close. (Lizards are known to sleep a long time while digesting their meals.)"
            PRINTL
            RETURN 1
        ELSEIF (Z2_PRSO == O_FLASK)
            PRINTS "The lizard sniffs it experimentally, then looks at you angrily, hissing and snapping."
            PRINTL
            RETURN 1
        ELSE
            CALL Z2R_BOMBQ, Z2_PRSO
            Z2T_1 = RESULT
            IF Z2T_1
                CALL Z2_REMOVE, Z2_PRSO
                PRINTS "The guardian greedily wolfs it down. After a while, you hear a very small pop and the guardian's eyes bulge out. It hisses nastily at you."
                PRINTL
                RETURN 1
            ELSEIF (Z2_PRSO == O_PALANTIR_1 || Z2_PRSO == O_PALANTIR_2 || Z2_PRSO == O_PALANTIR_3)
                PRINTS "The guardian greedily gobbles the sphere, but finds it unchewable. He then tries repeatedly to swallow it whole, with disappointing results. Finally, he spits it on the ground."
                PRINTL
                CALL Z2_MOVE, Z2_PRSO, Z2_HERE
                RETURN 1
            ELSE
                CALL Z2_REMOVE, Z2_PRSO
                PRINTS "The lizard wolfs down the "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS ", crunching greedily."
                PRINTL
                RETURN 1
            ENDIF
        ENDIF
    ELSEIF (Z2_PRSA == V_ATTACK || Z2_PRSA == V_MUNG)
        PRINTS "The guardian seems impervious to your attack. In fact, your blows don't even seem to be landing."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:2966 ROUTINE WIZ-DOOR-FCN
@Z2R_WIZ_DOOR_FCN
#DIM DYNAMIC Z2T_1
    IF !(Z2_GLOBAL:G_GUARDIAN_FED)
        IF (Z2_PRSA == V_OPEN)
            PRINTS "The lizard comes to life and snaps at you as you reach for the handle."
            PRINTL
            RETURN 1
        ELSEIF (Z2_PRSA == V_UNLOCK)
            PRINTS "The lizard door keeper comes awake and bites at your hand. You jerk away just in time."
            IF (((Z2_PRSI == O_GOLD_KEY)) && ((5 > Z2_RANDOM(100))))
                CALL Z2_REMOVE, O_GOLD_KEY
                PRINTS " The guardian does get the key, though. It grins maniacally."
                PRINTL
                RETURN 1
            ELSEIF (20 > Z2_RANDOM(100))
                CALL Z2_MOVE, O_GOLD_KEY, Z2_HERE
                PRINTS " You drop the key, though."
                PRINTL
                RETURN 1
            ELSE
                PRINTL
                RETURN 1
            ENDIF
        ENDIF
        RETURN 0
    ELSEIF (Z2_PRSA == V_UNLOCK)
        IF Z2_GLOBAL:G_WIZ_DOOR_FLAG
            PRINTS "It is already!"
            PRINTL
            RETURN 1
        ELSEIF (Z2_PRSI == O_GOLD_KEY)
            Z2_GLOBAL:G_WIZ_DOOR_FLAG = 1
            PRINTS "The key turns and the bolt clicks. The door is unlocked."
            PRINTL
            RETURN 1
        ELSE
            Z2_GLOBAL:G_WIZ_DOOR_FLAG = 0
            PRINTS "That won't unlock it."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF (Z2_PRSA == V_LOCK)
        IF !(Z2_GLOBAL:G_WIZ_DOOR_FLAG)
            PRINTS "It is locked already."
            PRINTL
            RETURN 1
        ELSEIF (Z2_PRSI == O_GOLD_KEY)
            PRINTS "The door is now locked."
            PRINTL
            Z2_GLOBAL:G_WIZ_DOOR_FLAG = 0
            RETURN 1
        ELSE
            PRINTS "That won't lock it."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF (Z2_PRSA == V_OPEN || Z2_PRSA == V_CLOSE)
        IF Z2_GLOBAL:G_WIZ_DOOR_FLAG
            CALL Z2R_OPEN_CLOSE, Z2_PRSO, "The door creaks open.", "The door reluctantly closes."
            Z2T_1 = RESULT
            RETURN Z2T_1
        ELSEIF (Z2_PRSA == V_OPEN)
            PRINTS "The door is locked!"
            PRINTL
            RETURN 1
        ENDIF
        RETURN 0
    ENDIF
    RETURN 0

; 2actions.zil:3010 ROUTINE GUARDIAN-ROOM-FCN
@Z2R_GUARDIAN_ROOM_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
    IF (Z2L_RARG == 3)
        PRINTS "This room is cobwebby and musty, but tracks in the dust show that it has seen visitors recently. At the south end of the room is a stained and battered (but very strong-looking) door. To the north, a corridor exits."
        PRINTL
        IF Z2_ATTR:(O_WIZ_DOOR):(F_OPENBIT)
            PRINTS "The door is open."
            PRINTL
        ENDIF
        IF !(Z2_GLOBAL:G_GUARDIAN_FED)
            PRINTS "Imbedded in the door is a nasty-looking lizard head, with sharp teeth and beady eyes. "
            IF (Z2_PARENT:(O_CANDY) == Z2_WINNER)
                PRINTS "The lizard is sniffing at you."
                PRINTL
                RETURN 1
            ELSE
                PRINTS "The eyes move to watch you approach."
                PRINTL
                RETURN 1
            ENDIF
        ELSE
            PRINTS "A sleepy-looking lizard head is mounted on the door."
            PRINTL
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:3031 ROUTINE WORKSHOP-FCN
@Z2R_WORKSHOP_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
    IF (Z2L_RARG == 3)
        PRINTS "You are standing in the entry hall of the Wizard's Workshop. Dark corridors lead west and south from here. The corridor to the west smells slightly of incense or candle smoke."
        IF Z2_ATTR:(O_WIZ_DOOR):(F_OPENBIT)
            PRINTS " The workshop door is open."
        ENDIF
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3042 ROUTINE ARCANA-PSEUDO
@Z2R_ARCANA_PSEUDO
    IF (Z2_PRSA == V_TAKE)
        PRINTS "The stuff on the bench appears to be so much junk, and you decide that it would only get in your way if you took it."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3048 ROUTINE TROPHY-PSEUDO
@Z2R_TROPHY_PSEUDO
    IF (Z2_PRSA == V_READ)
        RETURN 0
    ELSEIF (Z2_PRSA == V_TAKE || Z2_PRSA == V_RUB)
        PRINTS "As your fingers near it, you get a nasty shock (but fortunately not a fatal one)."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3055 ROUTINE STAND-FCN
@Z2R_STAND_FCN
#DIM DYNAMIC Z2T_1
    IF (Z2_PRSA == V_TAKE)
        PRINTS "The "
        PRINTS Z2_NAME:(Z2_PRSO)
        PRINTS " is firmly attached to the bench."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_PUT || Z2_PRSA == V_PUT_ON)) && ((Z2_PRSO == O_PALANTIR_1 || Z2_PRSO == O_PALANTIR_2 || Z2_PRSO == O_PALANTIR_3)) && ((Z2_PRSI == O_STAND_1 || Z2_PRSI == O_STAND_2 || Z2_PRSI == O_STAND_3)))
        CALL Z2R_V_PUT
        Z2T_1 = RESULT
        IF (((Z2_PARENT:(O_PALANTIR_1) == O_STAND_1)) && ((Z2_PARENT:(O_PALANTIR_2) == O_STAND_2)) && ((Z2_PARENT:(O_PALANTIR_3) == O_STAND_3)))
            CALL Z2_REMOVE, O_PALANTIR_1
            CALL Z2_REMOVE, O_PALANTIR_2
            CALL Z2_REMOVE, O_PALANTIR_3
            CALL Z2_MOVE, O_STAND_4, O_WORKBENCH
            PRINTS "As you place the "
            PRINTS Z2_NAME:(Z2_PRSO)
            PRINTS " in the "
            PRINTS Z2_NAME:(Z2_PRSI)
            PRINTS ", a low humming noise begins, and you can feel the hairs on the back of your neck begin to stand up. The three spheres begin to vibrate, faster and faster, as the noise becomes higher and higher pitched. Three puffs of smoke, one red, one blue, one white, rise up from empty stands. The spheres are gone! But in the center of the triangle formed by the stands is now a black stand of obsidian in which rests a strange black sphere."
            PRINTL
        ENDIF
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3079 ROUTINE IN-AQUARIUM-FCN
@Z2R_IN_AQUARIUM_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2L_RARG == 3)
        PRINTS "There is a sandy floor here, and your vision seems murky and blurred. The wall you are looking at is nicely dressed stone."
        PRINTL
        IF (Z2_PARENT:(O_SERPENT) == O_AQUARIUM)
            IF (25 > Z2_RANDOM(100))
                PRINTS "While you watch a shadow seems to pass overhead."
                PRINTL
            ELSEIF (5 > Z2_RANDOM(100))
                PRINTS "The head of some horrible serpent pokes into view, its beady green eyes almost seeming to see you."
                PRINTL
            ENDIF
        ENDIF
        RETURN 1
    ELSEIF (Z2L_RARG == 2)
        IF (Z2_PARENT:(O_SERPENT) == O_AQUARIUM)
            CALL Z2R_JIGS_UP, "You drop into the aquarium with a splash (which attracts the serpent). He greedily eats you. He's just a baby, after all, and needs all the food he can get."
            Z2T_1 = RESULT
            RETURN Z2T_1
        ELSE
            CALL Z2R_JIGS_UP, "Oh dear, you have cut yourself severely on the broken glass. I'm afraid you've bled to death."
            Z2T_2 = RESULT
            RETURN Z2T_2
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:3103 ROUTINE AQUARIUM-FCN
@Z2R_AQUARIUM_FCN
#DIM DYNAMIC Z2L_OBJ
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
    IF (Z2_PRSA == V_BOARD || Z2_PRSA == V_THROUGH)
        CALL Z2R_DO_WALK, 21
        Z2T_1 = RESULT
        RETURN 1
    ELSEIF (((Z2_PRSA == V_LOOK_INSIDE)) && ((Z2_PARENT:(O_SERPENT) == O_AQUARIUM)))
        PRINTS "In the aquarium is a baby sea-serpent who eyes you suspiciously. His scaly body writhes about in the huge tank."
        PRINTL
        RETURN 1
    ELSEIF (((((Z2_PRSA == V_MUNG || Z2_PRSA == V_ATTACK)) && ((Z2_PRSO == O_AQUARIUM)))) || ((((Z2_PRSA == V_THROW)) && ((Z2_PRSI == O_AQUARIUM)))))
        IF (Z2_PRSO == O_AQUARIUM)
            IF !(Z2_PRSI)
                RETURN 0
            ELSE
                Z2L_OBJ = Z2_PRSI
            ENDIF
        ELSE
            Z2L_OBJ = Z2_PRSO
        ENDIF
        CALL Z2_MOVE, Z2L_OBJ, Z2_HERE
        IF (Z2_PARENT:(O_DEAD_SERPENT) == Z2_HERE)
            PRINTS "The aquarium is already broken!"
            PRINTL
            RETURN 1
        ELSEIF (Z2L_OBJ == O_FLASK)
            CALL Z2R_JIGS_UP, "The flask shatters, and poison gas fills the room!"
            Z2T_2 = RESULT
            RETURN 1
        ELSE
            CALL Z2R_BOMBQ, Z2L_OBJ
            Z2T_3 = RESULT
            IF Z2T_3
                CALL Z2_ENABLE, INT_FUSE, 0
                RETURN 1
            ELSEIF ((Z2_ATTR:(Z2L_OBJ):(F_WEAPONBIT)) || ((Z2_SIZE:(Z2L_OBJ) > 10)))
                CALL Z2_REMOVE, O_SERPENT
                CALL Z2_MOVE, O_PALANTIR_3, O_AQUARIUM
                Z2_ATTR:(O_PALANTIR_3):(F_NDESCBIT) = 0
                Z2_LDESC:(O_AQUARIUM) '= "A shattered aquarium fills the northern half of the room."
                CALL Z2_MOVE, O_DEAD_SERPENT, Z2_HERE
                PRINTS "The "
                PRINTS Z2_NAME:(Z2L_OBJ)
                PRINTS " shatters the glass wall of the aquarium, spilling out an impressive amount of salt water and wet sand. It also spills out an extremely annoyed sea serpent who bites angrily at the "
                PRINTS Z2_NAME:(Z2L_OBJ)
                PRINTS ", and then at you. He is having difficulty breathing, and he seems to hold you responsible for his current problem."
                IF (Z2_PRSA == V_MUNG)
                    PRINTS " He manages to rend you limb from limb before he drowns in the air."
                    PRINTL
                    CALL Z2R_JIGS_UP, "I guess you were too careless."
                    Z2T_4 = RESULT
                    RETURN Z2T_4
                ELSE
                    PRINTS " He tries to slither across the stone floor towards you. Fortunately, he expires mere inches away from biting off your foot. A clear crystal sphere sits amid the sand and broken glass on the bottom of the aquarium."
                    PRINTL
                    RETURN 1
                ENDIF
            ELSE
                PRINTS "The "
                PRINTS Z2_NAME:(Z2L_OBJ)
                PRINTS " bounces harmlessly off the glass."
                PRINTL
                RETURN 1
            ENDIF
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:3156 ROUTINE SERPENT-FCN
@Z2R_SERPENT_FCN
#DIM DYNAMIC Z2T_1
    IF (O_SERPENT == Z2_WINNER)
        PRINTS "The serpent only stares hungrily at you."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_ATTACK || Z2_PRSA == V_MUNG)
        PRINTS "He swims towards you with a powerful stroke of his flippers, dagger-like teeth dripping. Fortunately, he doesn't want to crash into the aquarium wall, and contents himself with splashing you with water."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_PUT)) && ((Z2_PRSO == O_SERPENT)))
        PRINTS "Impossible for many reasons."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_TAKE || Z2_PRSA == V_GIVE)
        CALL Z2R_JIGS_UP, "He takes you instead. *Uurrp!*"
        Z2T_1 = RESULT
        RETURN Z2T_1
    ENDIF
    RETURN 0

; 2actions.zil:3172 ROUTINE DEAD-SERPENT-FCN
@Z2R_DEAD_SERPENT_FCN
    IF (Z2_PRSA == V_TAKE)
        PRINTS "This may only be a baby sea serpent, but it's as big as a small whale."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3177 ROUTINE GENIE-FCN
@Z2R_GENIE_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2L_V
#DIM DYNAMIC Z2L_HOARD
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
#DIM DYNAMIC Z2T_6
#DIM DYNAMIC Z2T_7
#DIM DYNAMIC Z2T_8
#DIM DYNAMIC Z2T_9
#DIM DYNAMIC Z2T_10
#DIM DYNAMIC Z2T_11
#DIM DYNAMIC Z2T_12
#DIM DYNAMIC Z2T_13
#DIM DYNAMIC Z2T_14
#DIM DYNAMIC Z2T_15
#DIM DYNAMIC Z2T_16
#DIM DYNAMIC Z2T_17
    IF (Z2_PRSA == V_HELLO)
        PRINTS "The genie grins demonically, but says nothing."
        PRINTL
        RETURN 1
    ELSEIF (Z2_WINNER == O_GENIE)
        IF !(Z2_GLOBAL:G_GENIE_READYQ)
            PRINTS "\"My fee is not paid! I perform no tasks for free! We demons have a strong union these days.\""
            PRINTL
            RETURN 2
        ELSEIF (Z2_PRSA == V_SGIVE)
            RETURN 0
        ELSEIF (((Z2_MT:MT_PRSO:0 > 1)) || ((Z2_MT:MT_PRSI:0 > 1)))
            PRINTS "\"I will do one thing only, oh gracious master!\""
            PRINTL
            RETURN 2
        ELSEIF (((Z2_PRSA == V_MOVE)) && ((Z2_PRSO == O_GLOBAL_MENHIR)))
            Z2_GLOBAL:G_MENHIR_POSITION = 1
            PRINTS "The demon is gone for a moment. \"A trifle... My little finger alone was enough.\""
            PRINTL
            CALL Z2R_GENIE_LEAVES
            Z2T_1 = RESULT
            RETURN Z2T_1
        ELSEIF (Z2_PRSA == V_TAKE)
            IF (Z2_PRSO == O_GLOBAL_MENHIR)
                CALL Z2_REMOVE, O_MENHIR
                Z2_GLOBAL:G_MENHIR_POSITION = 2
                PRINTS "The demon flashes away for a second. \"I have little use for such a thing, but perhaps as a doorstop...\""
                PRINTL
                CALL Z2R_GENIE_LEAVES
                Z2T_2 = RESULT
                RETURN Z2T_2
            ELSEIF (Z2_PRSO == O_WAND)
                PRINTS "\"This I do gladly, oh fool!\" cackles the demon gleefully. He stretches out an enormous hand towards the wand and taking it like a toothpick (this is a large demon), points it at himself. \"Free!\" he commands, and the demon and his wand vanish forever."
                PRINTL
                CALL Z2R_GENIE_LEAVES, 0
                Z2T_3 = RESULT
                CALL Z2_REMOVE, O_WAND
                RETURN 1
            ELSEIF Z2_ATTR:(Z2_PRSO):(F_TAKEBIT)
                CALL Z2R_GENIE_LEAVES, 0
                Z2T_4 = RESULT
                CALL Z2_REMOVE, Z2_PRSO
                PRINTS "The demon snaps his fingers, the "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS " spins wildly in the air in front of him, then he and it depart."
                PRINTL
                RETURN 1
            ELSE
                PRINTS "\"I fear that I cannot take such a thing.\""
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (((Z2_PRSA == V_GIVE)) && ((Z2_PRSI == O_ME)))
            IF (Z2_PRSO == O_WAND)
                PRINTS "\"I hear and obey!\" says the demon. He stretches out an enormous hand towards the wand. The Wizard is unsure what to do, pointing it threateningly at the demon, then at you. \"Fudge!\" he cries, but aside from a strong odor of chocolate in the air, there is no effect. The demon plucks the wand out of his hand (it's about toothpick-size to him) and gingerly lays it before you. He fades into the smoke, which disperses. The wizard runs from the room in terror."
                PRINTL
                CALL Z2_REMOVE, O_WIZARD
                CALL Z2R_GENIE_LEAVES, 0
                Z2T_5 = RESULT
                Z2_ATTR:(O_WAND):(F_NDESCBIT) = 0
                CALL Z2_MOVE, O_WAND, Z2_HERE
                RETURN 1
            ELSEIF (Z2_PRSO == O_GLOBAL_MENHIR)
                CALL Z2_MOVE, O_MENHIR, O_PENTAGRAM_ROOM
                Z2_ATTR:(O_MENHIR):(F_NDESCBIT) = 0
                Z2_ATTR:(O_MENHIR):(F_TAKEBIT) = 0
                Z2_GLOBAL:G_MENHIR_POSITION = 3
                PRINTS "He waves his hands, and the menhir drops softly at your feet."
                PRINTL
                CALL Z2R_GENIE_LEAVES
                Z2T_6 = RESULT
                RETURN Z2T_6
            ELSEIF Z2_ATTR:(Z2_PRSO):(F_TAKEBIT)
                CALL Z2_MOVE, Z2_PRSO, O_PENTAGRAM_ROOM
                PRINTS "The "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS " appears before you and settles to the ground."
                PRINTL
                CALL Z2R_GENIE_LEAVES
                Z2T_7 = RESULT
                RETURN Z2T_7
            ELSE
                PRINTS "\"Were it possible, this would be my fondest wish, but alas...\""
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (Z2_PRSA == V_ATTACK)
            IF (Z2_PRSO == O_GLOBAL_CERBERUS)
                PRINTS "\"This may prove taxing, but we'll see. Perhaps I'll tame him for a pup instead.\" The demon disappears for an instant, then reappears. He looks rather gnawed and scratched. He winces. \"Too much for me. Puppy dog, indeed. You're welcome to him. Never did like dogs anyway... Any other orders, oh beneficent one?\""
                PRINTL
                RETURN 1
            ELSEIF (Z2_PRSO == O_WIZARD)
                PRINTS "The demon grins hideously. \"This has been my desire e'er since this charlatan bent me to his service. I perform this deed with pleasure!\" The demon forms himself back into a cloud of greasy smoke. The cloud envelops the Wizard, who waves his wand fruitlessly, mumbling various phrases which begin with \"F\". A horrible scream is heard, and the smoke begins to clear. Nothing remains of the Wizard but his wand."
                PRINTL
                CALL Z2_REMOVE, O_WIZARD
                Z2_ATTR:(O_WAND):(F_NDESCBIT) = 0
                CALL Z2_MOVE, O_WAND, Z2_HERE
                CALL Z2R_GENIE_LEAVES
                Z2T_8 = RESULT
                RETURN Z2T_8
            ELSEIF (Z2_PRSO == O_ME)
                CALL Z2R_GENIE_LEAVES, 0
                Z2T_9 = RESULT
                Z2_WINNER = O_ADVENTURER
                CALL Z2R_JIGS_UP, "\"Foolish mortal, if you insist...\" The demon crushes you with one blow of his enormous hand."
                Z2T_10 = RESULT
                RETURN Z2T_10
            ELSE
                PRINTS "\"I know no way to kill a "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS ".\""
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (Z2_PRSA == V_FIND || Z2_PRSA == V_EXAMINE)
            PRINTS "\"I am not permitted to "
            IF (Z2_PRSA == V_FIND)
                PRINTS "answer questions"
            ELSE
                PRINTS "perform such menial tasks"
            ENDIF
            PRINTS ". The terms of my contract are explicit on this matter, learned one. Surely you would not wish to violate my contract?\" He licks his lips with a forked tongue like a snake's. \"The penalty clauses are ... hmm ... devilish.\""
            PRINTL
            RETURN 1
        ELSE
            PRINTS "\"Apologies, oh master, but even for such a one as I this is not possible.\" He seems somewhat chagrined to have to admit this."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF (Z2_PRSA == V_EXORCISE || Z2_PRSA == V_ATTACK || Z2_PRSA == V_MUNG)
        PRINTS "The demon laughs uproariously."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_GIVE)) && ((Z2_PRSI == O_GENIE)))
        IF (((Z2_PRSO == O_IRON_BOX)) && ((Z2_PARENT:(O_VIOLIN) == Z2_PRSO)))
            PRINTS "The genie frowns briefly, then "
            IF Z2_ATTR:(Z2_PRSO):(F_OPENBIT)
                PRINTS "looks inside"
            ELSE
                PRINTS "opens"
            ENDIF
            PRINTS " the box. He smiles horribly."
            PRINTL
            CALL Z2R_REMOVE_CAREFULLY, O_IRON_BOX
            Z2T_11 = RESULT
            Z2_PRSO = O_VIOLIN
        ENDIF
        IF ((Z2_GETPT(Z2_PRSO, 8)) && (!((Z2_PRSO == O_SWORD))))
            CALL Z2R_REMOVE_CAREFULLY, Z2_PRSO
            Z2T_12 = RESULT
            Z2_GLOBAL:G_GENIE_HOARD = (Z2_GLOBAL:G_GENIE_HOARD + 1)
            CALL Z2R_SCORE_UPD, 2
            Z2T_13 = RESULT
            CALL Z2R_CASE_WORTH
            Z2T_14 = RESULT
            Z2L_HOARD = (Z2_GLOBAL:G_GENIE_HOARD + Z2T_14)
            IF !((Z2L_HOARD < 10))
                Z2_GLOBAL:G_GENIE_READYQ = 1
                Z2_LDESC:(O_WIZARD) '= "A dejected and fearful Wizard watches from the corner."
                PRINTS "\"This will do for my fee. 'Tis a paltry hoard, but as you have done me a small service by loosing me from this wizard, it will suffice.\""
                PRINTL
                RETURN 1
            ELSE
                PRINTS "\""
                PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_GENIE_THANKS + 2 * Z2L_HOARD)) & 65535)
                PRINTS "\""
                PRINTL
                IF (Z2L_HOARD == 8)
                    PRINTS "The Wizard looks at you as if you are a madman. He tears his beard and stares at you fearfully."
                    PRINTL
                ENDIF
                RETURN 1
            ENDIF
        ELSE
            CALL Z2R_BOMBQ, Z2_PRSO
            Z2T_15 = RESULT
            IF Z2T_15
                CALL Z2R_GENIE_LEAVES, 0
                Z2T_16 = RESULT
                PRINTS "\"I fear that this violates my contract, oh foolish one. Thus, I am free to depart.\""
                PRINTL
                RETURN 1
            ELSE
                CALL Z2R_REMOVE_CAREFULLY, Z2_PRSO
                Z2T_17 = RESULT
                PRINTS "The demon gladly takes the "
                PRINTS Z2_NAME:(Z2_PRSO)
                PRINTS " and smiles balefully, revealing enormous fangs."
                PRINTL
                RETURN 1
            ENDIF
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:3343 ROUTINE GENIE-LEAVES
@Z2R_GENIE_LEAVES(Z2L_NOISYQ = 1)
#DIM DYNAMIC Z2L_NOISYQ
    Z2_ATTR:(O_GENIE):(F_INVISIBLE) = 1
    IF Z2L_NOISYQ
        PRINTS "The genie departs, his agreement fulfilled."
        PRINTL
    ENDIF
    Z2_P_CONT = 0
    RETURN 2

; 2actions.zil:3367 ROUTINE CASE-WORTH
@Z2R_CASE_WORTH
#DIM DYNAMIC Z2L_F
#DIM DYNAMIC Z2L_W
#DIM DYNAMIC Z2T_1
    Z2L_W = 0
    Z2L_F = Z2_CHILD:(O_WIZARD_CASE)
    Z2T_1 = 0
    WHILE 1
        IF !(Z2L_F)
            Z2T_1 = Z2L_W
            BREAK
        ENDIF
        IF Z2_GETPT(Z2L_F, 8)
            Z2L_W = (Z2L_W + 1)
        ENDIF
        Z2L_F = Z2_SIBLING:(Z2L_F)
    WEND
    RETURN Z2T_1

; 2actions.zil:3375 ROUTINE PENTAGRAM-FCN
@Z2R_PENTAGRAM_FCN(Z2L_RARG = 1)
#DIM DYNAMIC Z2L_RARG
    IF (Z2L_RARG == 1)
        IF (Z2_PRSA == V_THROUGH || Z2_PRSA == V_BOARD)
            PRINTS "You try to enter the pentagram, but are forced back by an invisible power."
            PRINTL
            RETURN 1
        ELSEIF (((Z2_PRSA == V_PUT || Z2_PRSA == V_PUT_ON)) && ((Z2_PRSO == O_PALANTIR_4)))
            CALL Z2_REMOVE, O_PALANTIR_4
            Z2_ATTR:(O_GENIE):(F_INVISIBLE) = 0
            CALL Z2_MOVE, O_GENIE, O_PENTAGRAM_ROOM
            PRINTS "A cold wind blows outward from the sphere. The candles flicker, and a low moan, almost inaudible, is heard. It rises in volume and pitch until it becomes a high-pitched keening. A dim shape becomes visible in the air above the sphere. The shape resolves into a large and somewhat formidable looking demon. He looks around, tests the walls of the pentagram experimentally, then sees you! \"Hmm, a new master...\" he says under his breath. \"Greetings, oh master! Wouldst desire a service, as our contract stateth? For some pittance of wealth, some trifle, I will gratify thy desires to the utmost limit of my powers, and they are not inconsiderable.\" He makes a pass with his massive arms and the walls begin to shake a little. Another pass and the shaking stops. \"A nice effect... I find it makes for a better relationship to give such a demonstration early on.\" He grins vilely."
            PRINTL
            RETURN 1
        ENDIF
        RETURN 0
    ENDIF
    RETURN 0

; 2actions.zil:3400 ROUTINE WIZARD-FCN
@Z2R_WIZARD_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2L_OLIT
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
    IF (Z2_WINNER == O_WIZARD)
        IF (Z2_PRSA == V_GIVE)
            PRINTS "The Wizard replies \"Foolishment!\""
            PRINTL
            RETURN 1
        ELSE
            PRINTS "The Wizard considers your statement carefully. His expression indicates he regards it as fanciful."
            PRINTL
            RETURN 1
        ENDIF
    ELSEIF (((Z2_PRSA == V_GIVE)) && ((Z2_PRSI == O_WIZARD)))
        Z2L_OLIT = Z2_LITQ
        CALL Z2R_REMOVE_CAREFULLY, Z2_PRSO
        Z2T_1 = RESULT
        CALL Z2R_BOMBQ, Z2_PRSO
        Z2T_2 = RESULT
        IF Z2T_2
            IF (Z2_PARENT:(O_GENIE) == O_PENTAGRAM_ROOM)
                CALL Z2_MOVE, Z2_PRSO, Z2_HERE
                PRINTS "The wizard accepts this final folly resignedly."
                PRINTL
                RETURN 1
            ELSE
                CALL Z2_REMOVE, O_WIZARD
                PRINTS "\"Hmm...\" The Wizard mutters something, then waves his wand over the bomb. It transforms into a bouquet of flowers. Both Wizard and flowers disappear."
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF ((Z2L_OLIT) && (!(Z2_LITQ)))
            PRINTS "\"Thank you.\" As the Wizard places the "
            PRINTS Z2_NAME:(Z2_PRSO)
            PRINTS " under his robe, the room becomes dark."
            PRINTL
            RETURN 1
        ELSE
            PRINTS "\"Thank you.\""
            PRINTL
            RETURN 1
        ENDIF
    ELSE
        CALL Z2R_HELLOQ, O_WIZARD
        Z2T_3 = RESULT
        IF Z2T_3
            PRINTS "The Wizard seems surprised, much as you might be if a dog talked."
            PRINTL
            RETURN 1
        ELSEIF (Z2_PRSA == V_ATTACK || Z2_PRSA == V_MUNG)
            CALL Z2_REMOVE, O_WIZARD
            IF (Z2_PARENT:(O_WAND) == O_WIZARD)
                PRINTS "The Wizard retreats, waving his wand and chanting. He says \"Fear!\" "
            ELSE
                PRINTS "The Wizard tries to cast the \"Fear!\" spell, but without his wand! "
            ENDIF
            IF !(Z2_ATTR:(O_GENIE):(F_INVISIBLE))
                PRINTS "Nothing happens! With a terrified glance at the demon, the wizard runs past you and out of the room."
                PRINTL
                RETURN 1
            ELSE
                PRINTS "You are suddenly terrified. The Wizard seems huge and terrible, looming over you. You flee, terrified. He chuckles, snaps his fingers, and disappears."
                PRINTL
                PRINTL
                Z2_SPELL = 3
                Z2_ACTION_R:(O_ADVENTURER) '= "MAGIC-ACTOR"
                CALL Z2_QUEUE, INT_WIZARD, 10, 1
                CALL Z2R_RANDOM_WALK
                Z2T_4 = RESULT
                RETURN Z2T_4
            ENDIF
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:3455 ROUTINE I-WIZARD
@Z2R_I_WIZARD
#DIM DYNAMIC Z2L_CAST_PROB
#DIM DYNAMIC Z2L_PCNT
#DIM DYNAMIC Z2L_F
#DIM DYNAMIC Z2L_WLOC
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
#DIM DYNAMIC Z2T_6
    Z2L_PCNT = 0
    Z2L_WLOC = Z2_PARENT:(Z2_WINNER)
    CALL Z2_QUEUE, INT_WIZARD, 4, 1
    IF Z2_DEAD
        RETURN 0
    ELSEIF Z2_SPELL
        IF (Z2_SPELL == 9)
            IF (Z2_HERE == O_WELL_TOP)
                CALL Z2R_JIGS_UP, "You plunge to the bottom of the shaft as the spell wears off."
                Z2T_1 = RESULT
                RETURN 1
            ELSEIF ((Z2_ATTR:(Z2_HERE):(F_NONLANDBIT)) && (!((Z2_HERE == O_WELL_BOTTOM || Z2_HERE == O_VOLCANO_BOTTOM))))
                CALL Z2R_JIGS_UP, "As the spell wears off, you find yourself making a half-gainer towards the bottom of the volcano."
                Z2T_2 = RESULT
                RETURN 1
            ENDIF
        ELSEIF (Z2_SPELL == 1)
            Z2_GLOBAL:G_LOAD_ALLOWED = Z2_GLOBAL:G_LOAD_MAX
        ELSEIF (Z2_SPELL == 8)
            Z2_GLOBAL:G_SWORD_GLOW = 0
        ELSEIF (Z2_SPELL == 2)
            Z2_GLOBAL:G_FUMBLE_NUMBER = 7
            Z2_GLOBAL:G_FUMBLE_PROB = 8
        ENDIF
        IF Z2_GETW(Z2_GLOBAL:G_SPELL_STOPS + 2 * Z2_SPELL)
            PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_SPELL_STOPS + 2 * Z2_SPELL)) & 65535)
            PRINTL
        ENDIF
        Z2_ACTION_R:(O_ADVENTURER) '= ""
        Z2_SPELL = 0
        RETURN 1
    ENDIF
    IF (Z2_PARENT:(O_GENIE) == O_PENTAGRAM_ROOM)
        CALL Z2_ENABLE, INT_WIZARD, 0
        IF !((Z2_PARENT:(O_WIZARD) == O_PENTAGRAM_ROOM))
            CALL Z2_MOVE, O_WIZARD, O_PENTAGRAM_ROOM
            IF (Z2_PARENT:(Z2_WINNER) == O_PENTAGRAM_ROOM)
                PRINTS "Suddenly the Wizard materializes in the room. He is astonished by what he sees: his servant in deep conversation with a common adventurer! He draws forth his wand, waves it frantically, and incants \"Frobizz! Frobozzle! Frobnoid!\" The demon laughs heartily. \"You no longer control the Black Crystal, hedge-wizard! Your wand is powerless! Your doom is sealed!\" The demon turns to you, expectantly."
                PRINTL
            ENDIF
        ENDIF
        RETURN 1
    ENDIF
    IF ((!(Z2_LITQ)) && (Z2_ATTR:(O_LAMP):(F_RMUNGBIT)) && ((Z2_SCORE > 200)))
        Z2_GLOBAL:G_ALWAYS_LIT = 1
        Z2_LITQ = 1
        PRINTS "In the darkness you hear the voice of the Wizard. \"Dear me, you seem to have gotten into quite a pickle.\" He chuckles. \"Fluoresce!\" he incants. It is no longer dark."
        PRINTL
        RETURN 1
    ENDIF
    IF ((Z2_PARENT:(O_WIZARD)) && ((80 > Z2_RANDOM(100))))
        IF ((Z2_LITQ) && ((Z2_PARENT:(O_WIZARD) == Z2_HERE)))
            PRINTS "The Wizard vanishes."
            PRINTL
        ENDIF
        CALL Z2_REMOVE, O_WIZARD
        RETURN 1
    ENDIF
    IF (10 > Z2_RANDOM(100))
        IF !(Z2_LITQ)
            PRINTS "You feel a slight outrush of air as something moves nearby."
            PRINTL
        ELSEIF (Z2_HERE == O_POSTS_ROOM || Z2_HERE == O_POOL_ROOM)
            PRINTS "A huge and terrible wizard appears before you, as large as the largest tree! He looks down on you as you would look upon a gnat!"
            PRINTL
        ELSEIF Z2_ATTR:(Z2_HERE):(F_NONLANDBIT)
            PRINTS "The Wizard appears, floating nonchalantly in the air beside you. He grins sideways at you."
            PRINTL
        ELSE
            PRINTS "A strange little man in a long cloak appears suddenly in the room. He is wearing a high pointed hat embroidered with astrological signs. He has a long, stringy, and unkempt beard."
            PRINTL
        ENDIF
        IF (Z2_PARENT:(O_PALANTIR_4) == O_ADVENTURER)
            IF Z2_LITQ
                PRINTS "The Wizard notices that you carry the Black Crystal, and with an unseemly haste, he disappears."
                PRINTL
            ELSE
                PRINTS "You feel a sudden inrush of air as though something disappeared."
                PRINTL
            ENDIF
            CALL Z2_REMOVE, O_WIZARD
            RETURN 1
        ELSEIF (20 > Z2_RANDOM(100))
            IF Z2_LITQ
                PRINTS "He mutters something (muffled by his beard) and disappears as suddenly as he came."
                PRINTL
            ELSE
                PRINTS "You hear low, confused muttering."
                PRINTL
            ENDIF
            CALL Z2_REMOVE, O_WIZARD
            RETURN 1
        ENDIF
        IF (Z2_PARENT:(O_PALANTIR_1) == O_ADVENTURER)
            Z2L_PCNT = (Z2L_PCNT + 1)
        ENDIF
        IF (Z2_PARENT:(O_PALANTIR_2) == O_ADVENTURER)
            Z2L_PCNT = (Z2L_PCNT + 1)
        ENDIF
        IF (Z2_PARENT:(O_PALANTIR_3) == O_ADVENTURER)
            Z2L_PCNT = (Z2L_PCNT + 1)
        ENDIF
        Z2L_CAST_PROB = (80 - (Z2L_PCNT * 20))
        IF Z2_LITQ
            PRINTS "The Wizard draws forth his wand and waves it in your direction. It begins to glow with a faint blue glow."
            PRINTL
        ELSE
            PRINTS "Suddenly, illuminated by the faint blue glow of a magic wand pointed in your direction, you see the Wizard!"
            PRINTL
        ENDIF
        IF (Z2L_CAST_PROB > Z2_RANDOM(100))
            CALL Z2_MOVE, O_WIZARD, Z2_HERE
            Z2_SPELL = Z2_RANDOM(12)
            Z2_ACTION_R:(O_ADVENTURER) '= "MAGIC-ACTOR"
            CALL Z2_QUEUE, INT_WIZARD, (5 + Z2_RANDOM((30 - (5 * Z2L_PCNT)))), 1
            IF (75 > Z2_RANDOM(100))
                PRINTS "The Wizard, in a deep and resonant voice, speaks the word \""
                PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_SPELL_NAMES + 2 * Z2_SPELL)) & 65535)
                PRINTS "!\" He then vanishes, cackling gleefully."
                PRINTL
            ELSE
                PRINTS "The Wizard, almost inaudibly, whispers a word beginning with \"F,\" and then disappears, chuckling nastily."
                PRINTL
            ENDIF
            CALL Z2_REMOVE, O_WIZARD
            IF Z2_GETW(Z2_GLOBAL:G_SPELL_HINTS + 2 * Z2_SPELL)
                PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_SPELL_HINTS + 2 * Z2_SPELL)) & 65535)
                PRINTL
            ENDIF
            IF (Z2_SPELL == 6)
                IF Z2_ATTR:(Z2L_WLOC):(F_VEHBIT)
                    PRINTS "You suddenly fall headlong out of the "
                    PRINTS Z2_NAME:(Z2L_WLOC)
                    PRINTS " as though someone had flipped it over."
                    PRINTL
                    IF (Z2_HERE == O_WELL_TOP)
                        CALL Z2R_JIGS_UP, "You plummet to the bottom of the shaft."
                        Z2T_3 = RESULT
                    ELSEIF ((Z2_ATTR:(Z2_HERE):(F_NONLANDBIT)) && (!((Z2_HERE == O_VOLCANO_BOTTOM || Z2_HERE == O_WELL_BOTTOM))))
                        CALL Z2R_JIGS_UP, "You make a rather messy swan dive to the bottom of the volcano."
                        Z2T_4 = RESULT
                    ELSE
                        CALL Z2_MOVE, Z2_WINNER, Z2_HERE
                    ENDIF
                ENDIF
            ELSEIF (Z2_SPELL == 9)
                IF Z2_ATTR:(Z2L_WLOC):(F_VEHBIT)
                    PRINTS " You rise majestically out of the "
                    PRINTS Z2_NAME:(Z2L_WLOC)
                    PRINTS ", coming to a stop about five feet above it and to one side."
                    PRINTL
                    CALL Z2_MOVE, Z2_WINNER, Z2_HERE
                ELSE
                    PRINTS "Slowly, you and all your belongings rise into the air, stopping after about five feet."
                    PRINTL
                ENDIF
            ELSEIF (Z2_SPELL == 1)
                Z2_GLOBAL:G_LOAD_ALLOWED = 50
                Z2L_F = Z2_CHILD:(Z2_WINNER)
                IF Z2L_F
                    PRINTS "In fact, you feel so weak that you drop the "
                    PRINTS Z2_NAME:(Z2L_F)
                    PRINTS "."
                    PRINTL
                    CALL Z2_MOVE, Z2L_F, Z2L_WLOC
                ENDIF
            ELSEIF (Z2_SPELL == 3)
                IF Z2_ATTR:(Z2L_WLOC):(F_VEHBIT)
                    PRINTS "You cower in the corner of the "
                    PRINTS Z2_NAME:(Z2L_WLOC)
                    PRINTS ", hoping the wizard won't see you."
                    PRINTL
                ELSE
                    PRINTL
                    CALL Z2R_RANDOM_WALK
                    Z2T_5 = RESULT
                ENDIF
            ELSEIF (Z2_SPELL == 2)
                Z2_GLOBAL:G_FUMBLE_NUMBER = 3
                Z2_GLOBAL:G_FUMBLE_PROB = 25
                Z2L_F = Z2_CHILD:(O_ADVENTURER)
                IF Z2L_F
                    PRINTS "Ooops! You dropped the "
                    PRINTS Z2_NAME:(Z2L_F)
                    PRINTS "."
                    PRINTL
                    CALL Z2_MOVE, Z2L_F, Z2L_WLOC
                ENDIF
            ELSEIF (Z2_SPELL == 4)
                CALL Z2R_ROB, Z2_WINNER, O_WIZARD_CASE
                Z2T_6 = RESULT
                IF Z2T_6
                    PRINTS "Something you are carrying has disappeared!"
                    PRINTL
                ENDIF
            ELSEIF (Z2_SPELL == 8)
                PRINTS "The Wizard mumbles something under his breath, and just before you reach him, he vanishes."
                PRINTL
            ENDIF
            RETURN 1
        ELSEIF (50 > Z2_RANDOM(100))
            CALL Z2_REMOVE, O_WIZARD
            PRINTS "There is a loud crackling noise. Blue smoke rises from out of the Wizard's sleeve. He sighs and disappears."
            PRINTL
            RETURN 1
        ELSEIF (50 > Z2_RANDOM(100))
            CALL Z2_REMOVE, O_WIZARD
            PRINTS "The Wizard incants \""
            PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_SPELL_NAMES + 2 * Z2_RANDOM(Z2_GETW(Z2_GLOBAL:G_SPELL_NAMES)))) & 65535)
            PRINTS "!\" but nothing happens. He shakes the wand. Nothing happens. With a slightly embarrassed glance in your direction, he vanishes."
            PRINTL
            RETURN 1
        ELSE
            CALL Z2_MOVE, O_WIZARD, Z2_HERE
            PRINTS "The Wizard seems about to say something, but thinks better of it, and peers at you from under his bushy eyebrows."
            PRINTL
            RETURN 1
        ENDIF
    ENDIF
    RETURN 0

; 2actions.zil:3708 ROUTINE ROB
@Z2R_ROB(Z2L_WHO = 0, Z2L_WHERE = 0)
#DIM DYNAMIC Z2L_WHO
#DIM DYNAMIC Z2L_WHERE
#DIM DYNAMIC Z2L_N
#DIM DYNAMIC Z2L_X
#DIM DYNAMIC Z2L_ROBBEDQ
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    Z2L_ROBBEDQ = 0
    Z2L_X = Z2_CHILD:(Z2L_WHO)
    Z2T_1 = 0
    WHILE 1
        IF !(Z2L_X)
            Z2T_1 = Z2L_ROBBEDQ
            BREAK
        ENDIF
        Z2L_N = Z2_SIBLING:(Z2L_X)
        CALL Z2R_RIPOFF, Z2L_X, Z2L_WHERE
        Z2T_2 = RESULT
        IF Z2T_2
            Z2L_ROBBEDQ = 1
        ENDIF
        Z2L_X = Z2L_N
    WEND
    RETURN Z2T_1

; 2actions.zil:3716 ROUTINE RIPOFF
@Z2R_RIPOFF(Z2L_X = 0, Z2L_WHERE = 0)
#DIM DYNAMIC Z2L_X
#DIM DYNAMIC Z2L_WHERE
    IF ((!(Z2_ATTR:(Z2L_X):(F_INVISIBLE))) && (Z2_GETPT(Z2L_X, 8)) && (!((Z2L_X == O_PALANTIR_1))) && (!((Z2L_X == O_PALANTIR_2))) && (!((Z2L_X == O_PALANTIR_3))) && (!((Z2L_X == O_GOLD_KEY))) && (!((Z2L_X == O_CANDY))))
        CALL Z2_MOVE, Z2L_X, Z2L_WHERE
        Z2_ATTR:(Z2L_X):(F_TOUCHBIT) = 1
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3728 ROUTINE WIZARD-CASE-FCN
@Z2R_WIZARD_CASE_FCN
#DIM DYNAMIC Z2T_1
    IF (Z2_WINNER == O_GENIE)
        IF (Z2_PRSA == V_MUNG || Z2_PRSA == V_OPEN)
            CALL Z2_REMOVE, O_WIZARD_CASE
            CALL Z2_MOVE, O_BROKEN_CASE, O_TROPHY_ROOM
            PRINTS "The demon smashes the case into smithereens. Everything in it smashes as well."
            PRINTL
            RETURN 1
        ENDIF
        RETURN 0
    ELSEIF (((Z2_PRSA == V_ENCHANT)) && ((Z2_GLOBAL:G_SPELL_USED == 205)))
        CALL Z2R_ROB, O_WIZARD_CASE, Z2_HERE
        Z2T_1 = RESULT
        Z2_GLOBAL:G_SPELL_HANDLEDQ = 1
        PRINTS "The contents of the case are arrayed at your feet."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_OPEN || Z2_PRSA == V_MUNG || Z2_PRSA == V_CLOSE || Z2_PRSA == V_TAKE)
        PRINTS "The case is protected by a fearful spell. You cannot touch it in any way."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3751 ROUTINE WAND-FCN
@Z2R_WAND_FCN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (((Z2_PRSA == V_TAKE || Z2_PRSA == V_PUT || Z2_PRSA == V_GIVE)) && ((Z2_PARENT:(O_WAND) == O_WIZARD)))
        IF (Z2_WINNER == O_ADVENTURER)
            PRINTS "The Wizard snatches it away."
            PRINTL
            RETURN 1
        ELSEIF (Z2_WINNER == O_ROBOT)
            CALL Z2R_JIGS_UP, "The Wizard snatches the wand away, muttering the word \"Float\" at the robot. Unfortunately he has no floating-point processor and dies in a vain attempt to divide 4.85 by 3.62."
            Z2T_1 = RESULT
            RETURN Z2T_1
        ENDIF
        RETURN 0
    ELSEIF (((Z2_PRSA == V_WAVE)) && ((Z2_PRSI == O_GRUE)))
        PRINTS "There is no grue in sight, but a hissing sound issues forth from the darkness."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_WAVE || Z2_PRSA == V_RUB || Z2_PRSA == V_RAISE)
        IF (((Z2_PRSO == O_WAND)) && (!((Z2_PARENT:(O_WAND) == Z2_WINNER))))
            PRINTS "You don't have the wand!"
            PRINTL
            RETURN 1
        ELSEIF ((Z2_GLOBAL:G_WAND_ON) || (Z2_GLOBAL:G_SPELL_USED) || (Z2_GLOBAL:G_SPELL_VICTIM))
            IF (5 > Z2_RANDOM(100))
                CALL Z2R_JIGS_UP, "The wand was still recharging from its last use. It discharges magic all over everything. You turn into a toad, the room fills with a fetid smell, and all sorts of other grubby things happen. Then the wand explodes!"
                Z2T_2 = RESULT
            ELSE
                PRINTS "A lot you know about magic! A magic wand takes a while to recharge after use! You might cause it to short-circuit!"
                PRINTL
            ENDIF
            RETURN 1
        ELSEIF (Z2_PRSA == V_WAVE)
            IF (((Z2_PRSO == O_WAND)) && (Z2_PRSI))
                Z2_GLOBAL:G_WAND_ON = Z2_PRSI
                Z2_GLOBAL:G_WAND_ON_LOC = Z2_HERE
            ELSE
                PRINTS "At what?"
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (Z2_PRSA == V_RUB)
            IF (((Z2_PRSI == O_WAND)) && (Z2_PRSO))
                Z2_GLOBAL:G_WAND_ON = Z2_PRSO
            ELSE
                PRINTS "Touch what?"
                PRINTL
                RETURN 1
            ENDIF
        ELSEIF (Z2_PRSA == V_RAISE)
            PRINTS "The wand grows warm and seems to vibrate."
            PRINTL
            RETURN 1
        ENDIF
        IF Z2_GLOBAL:G_WAND_ON
            Z2_GLOBAL:G_SPELL_USED = 0
            Z2_GLOBAL:G_SPELL_VICTIM = 0
            IF (Z2_GLOBAL:G_WAND_ON == O_ME || Z2_GLOBAL:G_WAND_ON == O_WAND)
                Z2_GLOBAL:G_WAND_ON = 0
                PRINTS "Fortunately a safety interlock prevents the fatal feedback loop that this would cause."
                PRINTL
            ELSE
                PRINTS "The wand grows warm, the "
                PRINTS Z2_NAME:(Z2_GLOBAL:G_WAND_ON)
                PRINTS " seems to glow dimly with magical essences, and you feel suffused with power."
                PRINTL
            ENDIF
            CALL Z2_QUEUE, INT_WAND, 2, 1
        ENDIF
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3810 ROUTINE I-WAND
@Z2R_I_WAND
    IF ((Z2_GLOBAL:G_WAND_ON) && ((((Z2_GLOBAL:G_WAND_ON_LOC == Z2_HERE)) || ((Z2_PARENT:(Z2_GLOBAL:G_WAND_ON) == Z2_WINNER)))))
        PRINTS "The "
        PRINTS Z2_NAME:(Z2_GLOBAL:G_WAND_ON)
        PRINTS " stops glowing and the power within you weakens."
        PRINTL
        Z2_GLOBAL:G_WAND_ON = 0
        RETURN 1
    ELSE
        Z2_GLOBAL:G_WAND_ON = 0
        RETURN 0
    ENDIF

; 2actions.zil:3822 ROUTINE WIZARD-QUARTERS-FCN
@Z2R_WIZARD_QUARTERS_FCN(Z2L_RARG = 0)
#DIM DYNAMIC Z2L_RARG
#DIM DYNAMIC Z2L_PICK
#DIM DYNAMIC Z2L_L
    IF (Z2L_RARG == 3 || Z2L_RARG == 4)
        PRINTS "This is where the Wizard of Frobozz lives. The room is "
        Z2L_L = Z2_GETW(Z2_GLOBAL:G_WIZQDESCS + 2 * 0)
        Z2L_PICK = Z2_RANDOM(Z2L_L)
        IF (Z2L_PICK == Z2_GLOBAL:G_WIZQLAST)
            IF (Z2L_PICK == Z2L_L)
                Z2L_PICK = (Z2L_PICK - 1)
            ELSE
                Z2L_PICK = (Z2L_PICK + 1)
            ENDIF
        ENDIF
        Z2_GLOBAL:G_WIZQLAST = Z2L_PICK
        PRINTS Z2_PSTR:((Z2_GETW(Z2_GLOBAL:G_WIZQDESCS + 2 * Z2L_PICK)) & 65535)
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3850 ROUTINE BRIDGE-FCN
@Z2R_BRIDGE_FCN
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (Z2_PRSA == V_CROSS)
        CALL Z2R_DO_WALK, 18
        Z2T_1 = RESULT
        RETURN Z2T_1
    ELSEIF (Z2_PRSA == V_LEAP)
        CALL Z2R_JIGS_UP, "You execute a perfect swan-dive into the depths below."
        Z2T_2 = RESULT
        RETURN Z2T_2
    ENDIF
    RETURN 0

; 2actions.zil:3859 ROUTINE STREAM-FCN
@Z2R_STREAM_FCN
    IF (Z2_PRSA == V_SWIM || Z2_PRSA == V_THROUGH)
        PRINTS "You can't swim in the stream."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_CROSS)
        PRINTS "You'll have to find a ford or a bridge."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3865 ROUTINE CHASM-FCN
@Z2R_CHASM_FCN
    IF (((Z2_PRSA == V_LEAP)) || ((((Z2_PRSA == V_PUT)) && ((Z2_PRSO == O_ME)))))
        PRINTS "For a change, you look before leaping. You realize you would never survive."
        PRINTL
        RETURN 1
    ELSEIF (Z2_PRSA == V_CROSS)
        PRINTS "You'll have to find a bridge."
        PRINTL
        RETURN 1
    ELSEIF (((Z2_PRSA == V_PUT)) && ((Z2_PRSI == O_PSEUDO_OBJECT)))
        PRINTS "The "
        PRINTS Z2_NAME:(Z2_PRSO)
        PRINTS " drops out of sight into the chasm."
        PRINTL
        CALL Z2_REMOVE, Z2_PRSO
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3878 ROUTINE TUNNEL-OBJECT
@Z2R_TUNNEL_OBJECT
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
    IF (((Z2_PRSA == V_THROUGH)) && (Z2_GETPT(Z2_HERE, 21)))
        CALL Z2R_DO_WALK, 21
        Z2T_1 = RESULT
        RETURN 1
    ELSE
        CALL Z2R_PATH_OBJECT
        Z2T_2 = RESULT
        RETURN Z2T_2
    ENDIF

; 2actions.zil:3883 ROUTINE STALA-PSEUDO
@Z2R_STALA_PSEUDO
    IF (Z2_PRSA == V_TAKE || Z2_PRSA == V_MUNG)
        PRINTS "The only ones you can reach are too large to successfully break off."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3888 ROUTINE MOSS-FCN
@Z2R_MOSS_FCN
    IF (Z2_PRSA == V_TAKE || Z2_PRSA == V_RUB)
        PRINTS "Some of the moss rubs off on you, but it stops glowing very quickly once plucked from its environment."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3894 ROUTINE ROSE-BUSH-FCN
@Z2R_ROSE_BUSH_FCN
    IF (Z2_PRSA == V_TAKE)
        PRINTS "You prick your finger trying to take a rose, and jump back annoyed. The rose almost seemed to move its thorns into your path."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3900 ROUTINE I-SPELL
@Z2R_I_SPELL
#DIM DYNAMIC Z2T_1
    IF ((!(Z2_GLOBAL:G_SPELL_HANDLEDQ)) && (Z2_GLOBAL:G_SPELL_VICTIM))
        CALL Z2_PERFORM, V_DISENCHANT, Z2_GLOBAL:G_SPELL_VICTIM
        Z2T_1 = RESULT
    ENDIF
    Z2_GLOBAL:G_SPELL_HANDLEDQ = 0
    Z2_GLOBAL:G_WAND_ON = 0
    Z2_GLOBAL:G_SPELL_USED = 0
    Z2_GLOBAL:G_SPELL_VICTIM = 0
    RETURN Z2_GLOBAL:G_SPELL_VICTIM

; 2actions.zil:3917 ROUTINE V-DIAGNOSE
@Z2R_V_DIAGNOSE
    IF Z2_DEAD
        PRINTS "You are dead."
    ELSEIF (Z2_SPELL == 7)
        PRINTS "You are drunk."
    ELSEIF (Z2_SPELL == 1)
        PRINTS "You seem unusually weak right now."
    ELSEIF (Z2_SPELL == 9)
        PRINTS "You seem somewhat light."
    ELSEIF (Z2_SPELL == 5)
        PRINTS "You are frozen stiff."
    ELSE
        PRINTS "You are in perfect health."
    ENDIF
    PRINTL
    IF !((Z2_DEATHS == 0))
        PRINTS "You have been killed "
        IF (Z2_DEATHS == 1)
            PRINTS "once."
        ELSEIF (Z2_DEATHS == 2)
            PRINTS "twice."
        ELSE
            PRINTS "an awful lot."
        ENDIF
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0

; 2actions.zil:3936 ROUTINE V-SCORE
@Z2R_V_SCORE(Z2L_ASKQ = 1)
#DIM DYNAMIC Z2L_ASKQ
    PRINTS "Your score "
    IF Z2L_ASKQ
        PRINTS "would be "
    ELSE
        PRINTS "is "
    ENDIF
    PRINTV Z2_SCORE
    PRINTS " (total of 400 points), in "
    PRINTV Z2_MOVES
    IF (Z2_MOVES == 1)
        PRINTS " move."
    ELSE
        PRINTS " moves."
    ENDIF
    PRINTL
    PRINTS "This score gives you the rank of "
    IF (Z2_SCORE == 400)
        PRINTS "Master Adventurer"
        IF !(Z2_WON)
            PRINTS ", but somehow you don't feel done"
        ENDIF
    ELSEIF (Z2_SCORE > 360)
        PRINTS "Wizard"
    ELSEIF (Z2_SCORE > 320)
        PRINTS "Master"
    ELSEIF (Z2_SCORE > 240)
        PRINTS "Adventurer"
    ELSEIF (Z2_SCORE > 160)
        PRINTS "Junior Adventurer"
    ELSEIF (Z2_SCORE > 80)
        PRINTS "Novice Adventurer"
    ELSEIF (Z2_SCORE > 40)
        PRINTS "Amateur Adventurer"
    ELSE
        PRINTS "Beginner"
    ENDIF
    PRINTS "."
    PRINTL
    RETURN Z2_SCORE

; 2actions.zil:3959 ROUTINE JIGS-UP
@Z2R_JIGS_UP(Z2L_DESC = "", Z2L_PLAYERQ = 0)
#DIMS DYNAMIC Z2L_DESC
#DIM DYNAMIC Z2L_PLAYERQ
#DIM DYNAMIC Z2T_1
#DIM DYNAMIC Z2T_2
#DIM DYNAMIC Z2T_3
#DIM DYNAMIC Z2T_4
#DIM DYNAMIC Z2T_5
    IF Z2L_DESC != ""
        PRINTS Z2L_DESC
        PRINTL
    ENDIF
    IF !((O_ADVENTURER == Z2_WINNER))
        PRINTS " "
        PRINTL
        PRINTS "    ****  The "
        PRINTS Z2_NAME:(Z2_WINNER)
        PRINTS " has died  **** "
        PRINTL
        PRINTL
        CALL Z2_REMOVE, Z2_WINNER
        Z2_WINNER = O_ADVENTURER
        Z2_HERE = Z2_PARENT:(Z2_WINNER)
        RETURN 2
    ENDIF
    Z2T_1 = 0
    WHILE 1
        CALL Z2R_SCORE_UPD, -10
        Z2T_2 = RESULT
        PRINTS " "
        PRINTL
        PRINTS "    ****  You have died  **** "
        PRINTL
        PRINTL
        Z2_DEAD = 1
        Z2_SPELL = 0
        Z2_ACTION_R:(O_ADVENTURER) '= ""
        Z2_DEATHS = (Z2_DEATHS + 1)
        CALL Z2_MOVE, Z2_WINNER, Z2_HERE
        PRINTS "Now, let's take a look here... Well, you probably deserve another chance. I can't quite fix you up completely, but you can't have everything."
        PRINTL
        PRINTL
        Z2_ATTR:(O_DEAD_PALANTIR_1):(F_TOUCHBIT) = 0
        Z2_ATTR:(O_DEAD_PALANTIR_2):(F_TOUCHBIT) = 0
        Z2_ATTR:(O_DEAD_PALANTIR_3):(F_TOUCHBIT) = 0
        CALL Z2R_RANDOMIZE_OBJECTS
        Z2T_3 = RESULT
        CALL Z2R_GOTO, O_DEAD_PALANTIR_1
        Z2T_4 = RESULT
        Z2_P_CONT = 0
        CALL Z2R_KILL_INTERRUPTS
        Z2T_5 = RESULT
        RETURN 2
        BREAK
    WEND
    RETURN Z2T_1

; 2actions.zil:3995 ROUTINE RANDOMIZE-OBJECTS
@Z2R_RANDOMIZE_OBJECTS
#DIM DYNAMIC Z2L_R
#DIM DYNAMIC Z2L_F
#DIM DYNAMIC Z2L_N
#DIM DYNAMIC Z2L_L
#DIM DYNAMIC Z2T_1
    Z2L_R = 0
    IF (Z2_PARENT:(O_LAMP) == Z2_WINNER)
        CALL Z2_MOVE, O_LAMP, O_INSIDE_BARROW
    ENDIF
    Z2L_N = Z2_CHILD:(Z2_WINNER)
    Z2T_1 = 0
    WHILE 1
        Z2L_F = Z2L_N
        IF !(Z2L_F)
            Z2T_1 = 1
            BREAK
        ENDIF
        Z2L_N = Z2_SIBLING:(Z2L_F)
        IF (((Z2L_F == O_BILLS || Z2L_F == O_PORTRAIT)) && ((((Z2_HERE == O_VAULT || Z2_HERE == O_DEPOSITORY || Z2_HERE == O_OFFICE)) || ((Z2_HERE == O_SMALL_ROOM)))))
            CALL Z2_MOVE, Z2L_F, Z2_HERE
        ELSEIF (((Z2L_F == O_GOLD_KEY)) || ((Z2L_F == O_CANDY)) || ((Z2L_F == O_PALANTIR_1)) || ((Z2L_F == O_PALANTIR_2)) || ((Z2L_F == O_PALANTIR_3)))
            CALL Z2_MOVE, Z2L_F, O_CAROUSEL_ROOM
        ELSEIF Z2_ATTR:(Z2L_F):(F_STAGGERED)
            CALL Z2_MOVE, Z2L_F, O_WIZARD_CASE
        ELSE
            CALL Z2_MOVE, Z2L_F, O_GAZEBO_ROOM
        ENDIF
    WEND
    RETURN Z2T_1

; 2actions.zil:4018 ROUTINE KILL-INTERRUPTS
@Z2R_KILL_INTERRUPTS
#DIM DYNAMIC Z2T_1
    CALL Z2_ENABLE, INT_GNOME, 0
    CALL Z2_ENABLE, INT_LEDGE, 0
    CALL Z2_ENABLE, INT_NERVOUS, 0
    CALL Z2_ENABLE, INT_ZGNOME_OUT, 0
    CALL Z2_ENABLE, INT_ZGNOME, 0
    CALL Z2R_DRAGON_LEAVES
    Z2T_1 = RESULT
    CALL Z2_ENABLE, INT_MATCH, 0
    RETURN 1

; 2actions.zil:4028 ROUTINE FIND-WEAPON
@Z2R_FIND_WEAPON(Z2L_O = 0)
#DIM DYNAMIC Z2L_O
#DIM DYNAMIC Z2L_W
#DIM DYNAMIC Z2T_1
    Z2L_W = Z2_CHILD:(Z2L_O)
    IF !(Z2L_W)
        RETURN 0
    ENDIF
    Z2T_1 = 0
    WHILE 1
        IF (Z2L_W == O_SWORD)
            Z2T_1 = Z2L_W
            BREAK
        ELSE
            Z2L_W = Z2_SIBLING:(Z2L_W)
            IF !(Z2L_W)
                RETURN 0
            ENDIF
        ENDIF
    WEND
    RETURN Z2T_1

; 2actions.zil:4037 ROUTINE BUCKET-CONT
@Z2R_BUCKET_CONT
    IF (((Z2_PRSA == V_TAKE)) && (!((Z2_PARENT:(Z2_WINNER) == O_BUCKET))))
        PRINTS "You'll need to get in the bucket to reach it."
        PRINTL
        RETURN 1
    ENDIF
    RETURN 0
