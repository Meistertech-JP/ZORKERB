; Z-machine REMOVE_OBJ / INSERT_OBJ: an inserted object becomes the first child.
@Z2_REMOVE(Z2_O)
#DIM DYNAMIC Z2_O
#DIM DYNAMIC Z2_P
#DIM DYNAMIC Z2_C
Z2_P = Z2_PARENT:Z2_O
SIF Z2_P == 0
    RETURN
IF Z2_CHILD:Z2_P == Z2_O
    Z2_CHILD:Z2_P = Z2_SIBLING:Z2_O
ELSE
    Z2_C = Z2_CHILD:Z2_P
    WHILE Z2_C && Z2_SIBLING:Z2_C != Z2_O
        Z2_C = Z2_SIBLING:Z2_C
    WEND
    SIF Z2_C
        Z2_SIBLING:Z2_C = Z2_SIBLING:Z2_O
ENDIF
Z2_PARENT:Z2_O = 0
Z2_SIBLING:Z2_O = 0

@Z2_MOVE(Z2_O, Z2_DEST)
#DIM DYNAMIC Z2_O
#DIM DYNAMIC Z2_DEST
CALL Z2_REMOVE, Z2_O
Z2_PARENT:Z2_O = Z2_DEST
Z2_SIBLING:Z2_O = Z2_CHILD:Z2_DEST
Z2_CHILD:Z2_DEST = Z2_O
