; Save files and line breaks. The native Emuera's default save format (text)
; writes each string on a line of its own and reads it back line by line, so a
; string holding a line break splits and every later element of the array
; shifts (Windows acceptance D-R08: 5 LDESC and 7 TEXT values have line
; breaks). Around every SAVEDATA the line breaks of the saved description
; strings are swapped for Z2_NL_MARK, which no game text contains
; (tools/native_save_test.py checks it), and swapped back right after the
; save and at the start of EVENTLOAD. The game never sees the marker; files
; written before this change (no marker) load as before.
@Z2_SAVE_TEXT(Z2_ENC)
#DIM DYNAMIC Z2_ENC
#DIM DYNAMIC Z2_K
FOR Z2_K, 0, 256
    IF Z2_ENC
        Z2_LDESC:Z2_K '= Z2_STR_SWAP(Z2_LDESC:Z2_K, "\n", Z2_NL_MARK)
        Z2_FDESC:Z2_K '= Z2_STR_SWAP(Z2_FDESC:Z2_K, "\n", Z2_NL_MARK)
        Z2_TEXT:Z2_K '= Z2_STR_SWAP(Z2_TEXT:Z2_K, "\n", Z2_NL_MARK)
    ELSE
        Z2_LDESC:Z2_K '= Z2_STR_SWAP(Z2_LDESC:Z2_K, Z2_NL_MARK, "\n")
        Z2_FDESC:Z2_K '= Z2_STR_SWAP(Z2_FDESC:Z2_K, Z2_NL_MARK, "\n")
        Z2_TEXT:Z2_K '= Z2_STR_SWAP(Z2_TEXT:Z2_K, Z2_NL_MARK, "\n")
    ENDIF
NEXT
RETURN 0

; every occurrence of the one-character string FROM replaced by TO (no regex)
@Z2_STR_SWAP(Z2_S, Z2_FROM, Z2_TO)
#FUNCTIONS
#DIMS DYNAMIC Z2_S
#DIMS DYNAMIC Z2_FROM
#DIMS DYNAMIC Z2_TO
#DIMS DYNAMIC Z2_R
#DIM DYNAMIC Z2_K
Z2_K = STRFIND(Z2_S, Z2_FROM)
SIF Z2_K < 0
    RETURNF Z2_S
Z2_R '= ""
WHILE Z2_K >= 0
    Z2_R '= Z2_R + SUBSTRING(Z2_S, 0, Z2_K) + Z2_TO
    Z2_S '= SUBSTRING(Z2_S, Z2_K + 1)
    Z2_K = STRFIND(Z2_S, Z2_FROM)
WEND
RETURNF Z2_R + Z2_S

