; gverbs.zil game verbs, ported by hand.

; V-RANDOM: <RANDOM <- 0 ,P-NUMBER>> (03_Random). Prints nothing. As the
; Z-machine RANDOM: an operand of 0 or less seeds with its negation, a
; positive one draws (P-NUMBER can be negative: see NUMBER?).
@Z2R_V_RANDOM(Z2_RARG = 0)
#DIM DYNAMIC Z2_RARG
#DIM DYNAMIC Z2_ARG
IF Z2_PRSO != O_INTNUM
    PRINTL Illegal call to #RND.
    RETURN 1
ENDIF
Z2_ARG = Z2_W16(0 - Z2_P_NUMBER)
IF Z2_ARG > 0
    Z2_ARG = Z2_RANDOM(Z2_ARG)
ELSE
    Z2_ARG = Z2_SEED_RANDOM(0 - Z2_ARG)
ENDIF
RETURN 1

@Z2R_V_VERSION(Z2_RARG = 0)
#DIM DYNAMIC Z2_RARG
CALL Z2_VERSION
RETURN 1

; ITAKE is ported with V-TAKE; until then implicit takes are refused.
@Z2_ITAKE(Z2_VB = 1)
#DIM DYNAMIC Z2_VB
CALL Z2_APPLY, "ITAKE", Z2_VB
RETURN RESULT

; YES?: <PRINTI ">"> <READ ...>, true for YES or Y.
@Z2R_YESQ
CALL Z2_READ_INPUT
RETURN Z2_LXD:1 == W_YES || Z2_LXD:1 == W_Y

; V-SAVE: <COND (<SAVE> <TELL "Ok." CR>) (T <TELL "Failed." CR>)>. The
; image is written here, inside the turn, like the story's SAVE; the host slot
; (0-9, default 0) stands for the file name the interpreter asks for.
@Z2R_V_SAVE
Z2_SAVE_RESUME = 1
CALL Z2_SAVE_TEXT, 1
SAVEDATA Z2_SLOT_REQ, Z2_SAVE_TAG + " slot " + TOSTR(Z2_SLOT_REQ)
CALL Z2_SAVE_TEXT, 0
Z2_SAVE_RESUME = 0
CALL Z2_SLOT_OK, Z2_SLOT_REQ
IF RESULT
    PRINTL Ok.
ELSE
    PRINTL Failed.
ENDIF
RETURN 1

; V-RESTORE: a successful RESTORE does not return (the game resumes inside the
; saved V-SAVE, EVENTLOAD); otherwise "Failed.".
@Z2R_V_RESTORE
CALL Z2_RESTORE_SLOT, Z2_SLOT_REQ
PRINTL Failed.
RETURN 1

; A slot holds a ZORKERB II save of this schema (not ZORKERB I, not an older
; development save, not damaged): CHKDATA reads it and returns its tag.
@Z2_SLOT_OK(Z2_S)
#DIM DYNAMIC Z2_S
SIF Z2_S < 0 || Z2_S > 9
    RETURN 0
CHKDATA Z2_S
SIF RESULT != 0
    RETURN 0
; The description names the slot the file was written for: PyEmuera's
; LOADDATA refuses (and stops the game on) a file whose own slot field differs
; from the slot it is loaded from, e.g. 1.json copied to 3.json, but CHKDATA
; does not check that field. The description is the only part CHKDATA shows.
RETURN RESULTS == Z2_SAVE_TAG + " slot " + TOSTR(Z2_S)

; Loads the slot if it is valid (never returns then); otherwise returns and
; nothing has changed. CTX: 0 V-RESTORE, 1 FINISH, 2 title menu. In a game
; (CTX 0/1) the current state is first written to the rollback slot: if the
; loaded state fails Z2_SAVE_VALID (48_SaveCheck), EVENTLOAD loads the
; rollback image back and RESTORE fails as the story's does ("Failed."),
; with the game unchanged.
@Z2_RESTORE_SLOT(Z2_S, Z2_CTX = 0)
#DIM DYNAMIC Z2_S
#DIM DYNAMIC Z2_CTX
CALL Z2_SLOT_OK, Z2_S
SIF !RESULT
    RETURN 0
Z2_RB_CTX = Z2_CTX
IF Z2_CTX != 2
    CALL Z2_SAVE_TEXT, 1
    SAVEDATA Z2_RB_SLOT, "ZORKERB II rollback"
    CALL Z2_SAVE_TEXT, 0
    CHKDATA Z2_RB_SLOT
    SIF RESULT != 0
        RETURN 0
ENDIF
Z2_RB_PENDING = 1
LOADDATA Z2_S
Z2_RB_PENDING = 0
RETURN 0

